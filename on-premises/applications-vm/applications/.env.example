# .env — Environment variables cho docker-compose
# ⚠️  KHÔNG commit file này vào git (đã trong .gitignore)
# ⚠️  File này PHẢI dùng LF line endings (Unix), KHÔNG dùng CRLF (Windows)
#    → Fix: VS Code → bottom right → click "CRLF" → chọn "LF"
# ⚠️  See .env.example for the full list of variables

# -- Infrastructure Secrets --
# ⚠️ CHANGE ME in production! Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=app_secret
POSTGRES_USER=app
POSTGRES_DB=orders

# -- GitHub Container Registry --
# Lowercase repository owner
GHCR_OWNER=mark-zagob

# -- Image Tag --
#   Production: short SHA (vd: abc1234) — immutable, reproducible
#   Local dev:  dùng "latest" — mutable, tiện lợi
IMAGE_TAG=latest