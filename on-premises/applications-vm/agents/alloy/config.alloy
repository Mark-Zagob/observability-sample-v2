// ============================================================
// Grafana Alloy — Applications VM (192.168.100.57)
// ============================================================
// Thu thập logs từ VM chạy app và push về Loki trên
// Observability VM (192.168.100.55:3100)
//
// Pipeline:
//   Source → Multiline → Process (parse, extract, filter) → Push Loki
//
// v3.0: Removed stage.logfmt entirely (pragmatic approach)
//   - Most services log JSON (handled by stage.json)
//   - PostgreSQL/Redis/Kafka logs kept as plain text (readable in Grafana)
//   - Eliminates 100% of logfmt parse errors
//   - If specific service needs logfmt parsing, add stage.logfmt
//     with precise selector for that service only
// ============================================================

// ============================================================
// PHẦN 1: DOCKER CONTAINER LOGS
// ============================================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_labels" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_labels.output
  forward_to = [loki.process.docker_pipeline.receiver]
}

// ============================================================
// LOG PROCESSING PIPELINE — Docker containers
// ============================================================
// Pipeline xử lý log trước khi push Loki:
//   1. Drop health check noise
//   2. Aggregate multiline logs (stack traces)
//   3. Try JSON parsing (most app services)
//   4. Detect logfmt pattern → conditionally parse logfmt
//   5. Normalize log level
//   6. Add static labels
//   7. Drop debug noise
// ============================================================

loki.process "docker_pipeline" {
  // ---------------------------------------------------------
  // Stage 1: Drop health check logs
  // ---------------------------------------------------------
  // Health checks create massive noise (every 5-10s per service)
  // Drop BEFORE any parsing to save CPU
  // ---------------------------------------------------------
  stage.drop {
    expression          = "(?i)(GET|HEAD)\\s+/(health|ready|healthz|livez|readyz)"
    drop_counter_reason = "health_check"
  }

  // ---------------------------------------------------------
  // Stage 2: Multiline aggregation
  // ---------------------------------------------------------
  // Python/Java/Node stack traces span multiple lines.
  // Without this, each line becomes a separate Loki entry,
  // making debugging impossible.
  //
  // firstline regex matches the START of a new log entry:
  //   - ISO timestamp: 2026-09-16 03:21:56
  //   - JSON start: {"level
  //   - Logfmt start: level=
  //   - Bracket timestamp: [2026-09-16
  //   - Redis style: 1:M 16 Sep
  //   - Postgres style: 2026-09-16 03:21:56 UTC
  //
  // If a line does NOT match firstline, it's appended to
  // the previous entry (e.g., stack trace continuation).
  // ---------------------------------------------------------
  stage.multiline {
    firstline     = "^(\\d{4}-\\d{2}-\\d{2}|{\"level|level=|\\[\\d{4}-|\\d+:\\w+ \\d+ \\w+ \\d{4})"
    max_lines     = 128
    max_wait_time = "3s"
  }

  // ---------------------------------------------------------
  // Stage 3: Try JSON parsing
  // ---------------------------------------------------------
  // Most application services (Order, Payment, Workers, Gateway)
  // log in structured JSON via structlog:
  //   {"level":"info","msg":"request handled","trace_id":"abc","caller":"app.py:42"}
  //
  // stage.json extracts fields as "extracted values" for
  // downstream stages. If the line isn't valid JSON, this
  // stage silently skips (no error logged).
  // ---------------------------------------------------------
  stage.json {
    expressions = {
      level    = "level",
      msg      = "msg",
      caller   = "caller",
      trace_id = "trace_id",
      span_id  = "span_id",
    }
  }

  // ---------------------------------------------------------
  // Stage 4: REMOVED — logfmt parsing
  // ---------------------------------------------------------
  // Decision: Drop stage.logfmt entirely (v3.0)
  //
  // Reasoning:
  //   1. Most application services log JSON (structlog) → handled by stage.json
  //   2. Infrastructure services (PostgreSQL, Redis, Kafka) log in native formats
  //      → Keep as plain text, still readable in Grafana Loki
  //   3. Trying to detect & parse logfmt is error-prone (regex guard too broad)
  //   4. Eliminates 100% of "logfmt syntax error" messages
  //
  // If a specific service needs logfmt parsing in the future:
  //   - Add stage.logfmt with precise selector targeting that service
  //   - Example: selector = "{compose_service=\"api-gateway\"}"
  // ---------------------------------------------------------

  // ---------------------------------------------------------
  // Stage 6: Normalize log level → lowercase
  // ---------------------------------------------------------
  // Different services use different conventions:
  //   "INFO", "info", "WARNING", "warning", "WARN", "warn"
  // → Normalize to lowercase for consistent querying
  // ---------------------------------------------------------
  stage.template {
    source   = "level"
    template = "{{ if .Value }}{{ ToLower .Value }}{{ else }}info{{ end }}"
  }

  // Map "warning" → "warn" for consistency
  stage.replace {
    expression = "warning"
    source     = "level"
    replace    = "warn"
  }

  // ---------------------------------------------------------
  // Stage 7: Assign detected_level label
  // ---------------------------------------------------------
  // Create label "detected_level" from extracted level.
  // Enables queries like: {detected_level="error"}
  //
  // SRE Rule: Only use LOW-CARDINALITY fields as labels
  // (debug/info/warn/error/fatal). NEVER put high-cardinality
  // fields (user_id, request_id, trace_id) into labels.
  // ---------------------------------------------------------
  stage.labels {
    values = {
      detected_level = "level",
    }
  }

  // ---------------------------------------------------------
  // Stage 8: Static labels — mark source VM
  // ---------------------------------------------------------
  stage.static_labels {
    values = {
      source = "docker",
      vm     = "app",
    }
  }

  // ---------------------------------------------------------
  // Stage 9: Drop noisy debug logs
  // ---------------------------------------------------------
  // In lab/dev, debug logs have little value but consume
  // storage. Drop to reduce cost.
  // Comment out this stage if you need full debug visibility.
  // ---------------------------------------------------------
  stage.drop {
    source              = "level"
    expression          = "debug"
    drop_counter_reason = "debug_level"
  }

  forward_to = [loki.write.loki_endpoint.receiver]
}

// ============================================================
// PHẦN 2: HOST SYSTEM LOGS
// ============================================================

local.file_match "syslog" {
  path_targets = [{
    __path__  = "/var/log/host/syslog",
    job       = "syslog",
    log_type  = "system",
  }]
}

loki.source.file "syslog" {
  targets    = local.file_match.syslog.targets
  forward_to = [loki.process.host_pipeline.receiver]
}

local.file_match "auth_log" {
  path_targets = [{
    __path__  = "/var/log/host/auth.log",
    job       = "auth",
    log_type  = "security",
  }]
}

loki.source.file "auth_log" {
  targets    = local.file_match.auth_log.targets
  forward_to = [loki.process.host_pipeline.receiver]
}

// ============================================================
// LOG PROCESSING PIPELINE — Host logs
// ============================================================

loki.process "host_pipeline" {
  stage.regex {
    expression = "^\\w+\\s+\\d+\\s+[\\d:]+\\s+(?P<hostname>\\S+)\\s+(?P<syslog_service>[^\\[\\s:]+)"
  }

  stage.labels {
    values = {
      hostname       = "",
      syslog_service = "",
    }
  }

  stage.regex {
    expression = "(?i)(?P<severity>error|fail|panic|crit|warn|alert|emerg)"
  }

  stage.template {
    source   = "severity"
    template = "{{ if .Value }}{{ ToLower .Value }}{{ else }}info{{ end }}"
  }

  stage.labels {
    values = {
      detected_level = "severity",
    }
  }

  stage.static_labels {
    values = {
      source = "host",
      vm     = "app",
    }
  }

  forward_to = [loki.write.loki_endpoint.receiver]
}

// ============================================================
// PUSH VỀ LOKI (Observability VM)
// ============================================================

loki.write "loki_endpoint" {
  endpoint {
    url = "http://192.168.100.55:3100/loki/api/v1/push"
  }
}
