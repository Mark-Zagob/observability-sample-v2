      },
      "description": "🔄 Circuit Breaker state transitions over time.\n\nShows when the breaker changes state:\n• closed(0) → open(1): Failure threshold reached\n• open(1) → half-open(2): Recovery timeout elapsed\n• half-open(2) → closed(0): Test request succeeded\n• half-open(2) → open(1): Test request failed\n\n💡 Exp 4 (Cascading Failure): Watch for rapid closed→open transitions when Payment Gateway is down, then open→half-open→closed recovery cycle.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*→ open.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*→ half-open.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*→ closed.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
