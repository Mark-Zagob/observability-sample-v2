{
  "annotations": {
    "list": [
      {
        "datasource": { "type": "loki", "uid": "loki-datasource" },
        "enable": true,
        "expr": "{job=\"deploy-events\"} |= ``",
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Deployments",
        "titleFormat": "Deploy: {{service}}",
        "textFormat": "{{message}}",
        "tagKeys": "service",
        "type": "tags"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    { "title": "SLO Overview", "url": "/d/slo-overview", "type": "link", "icon": "dashboard", "tooltip": "SLO targets, burn rates, error budgets" },
    { "title": "Kafka Events", "url": "/d/kafka-event-driven", "type": "link", "icon": "arrow-random", "tooltip": "Event-driven pipeline" },
    { "title": "Unified Overview", "url": "/d/unified-overview", "type": "link", "icon": "apps", "tooltip": "Metrics + Logs + Traces" },
    { "title": "Alerting", "url": "/d/alerting-overview", "type": "link", "icon": "bolt", "tooltip": "Active alerts" }
  ],
  "panels": [

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "🌐 API Gateway — RED", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Rate — Request Rate",
      "description": "HTTP requests per second to API Gateway, grouped by status (success/error)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(api_gateway_requests_total[5m])) by (status)", "legendFormat": "{{ status }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Duration — Latency (P50 / P95 / P99)",
      "description": "API Gateway request duration percentiles",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(api_gateway_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(api_gateway_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(api_gateway_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Errors — Error Rate",
      "description": "Percentage of API Gateway requests that resulted in errors",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "(sum(rate(api_gateway_requests_total{status=\"error\"}[5m])) or vector(0)) / sum(rate(api_gateway_requests_total[5m]))", "legendFormat": "Error Rate" }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }, "id": 101, "title": "📦 Order Service — RED", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "id": 4,
      "title": "Rate — Request Rate",
      "description": "HTTP requests per second to Order Service (all endpoints)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(orders_created_total[5m])) by (status)", "legendFormat": "{{ status }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "id": 5,
      "title": "Duration — Processing Latency (P50 / P95)",
      "description": "End-to-end order processing time percentiles",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "id": 6,
      "title": "Errors — Error Rate",
      "description": "Percentage of orders that failed (payment_error, out_of_stock, unknown_error)",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "1 - ((sum(rate(orders_created_total{status=\"completed\"}[5m])) or vector(0)) / (sum(rate(orders_created_total[5m])) or vector(1)))", "legendFormat": "Error Rate" }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }, "id": 102, "title": "💳 Payment Service — RED", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "id": 7,
      "title": "Rate — Request Rate",
      "description": "Payment requests per second (total throughput)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(payments_total[5m])) by (status)", "legendFormat": "{{ status }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "id": 8,
      "title": "Duration — Gateway Latency by Provider (P95)",
      "description": "External payment gateway call duration P95 grouped by provider",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(payment_gateway_duration_seconds_bucket[5m])) by (le, provider))", "legendFormat": "{{ provider }} P95" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "id": 9,
      "title": "Errors — Error Rate",
      "description": "Percentage of payment requests that failed or were rejected",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "(sum(rate(payments_total{status=\"failed\"}[5m])) or vector(0)) / sum(rate(payments_total[5m]))", "legendFormat": "Error Rate" }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 }, "id": 104, "title": "📨 Notification Worker — RED", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "id": 12,
      "title": "Rate — Events Consumed",
      "description": "Kafka events consumed per second by event type",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(kafka_events_consumed_total{service_name=\"notification-worker\"}[5m])) by (event_type)", "legendFormat": "{{ event_type }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 36 },
      "id": 13,
      "title": "Duration — Processing Latency (P50 / P95)",
      "description": "Time to process and send notifications",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(notification_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(notification_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "short", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "noValue": "0 (no errors)"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "id": 18,
      "title": "Errors — Processing Errors",
      "description": "Difference between consumed events and sent notifications. 'No data' = zero errors (healthy).",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "sum(rate(kafka_events_consumed_total{service_name=\"notification-worker\"}[5m])) - sum(rate(notifications_sent_total[5m]))", "legendFormat": "Errors/s" }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 }, "id": 105, "title": "📦 Inventory Worker — RED", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 45 },
      "id": 15,
      "title": "Rate — Operations (by Action)",
      "description": "Stock update operations per second: reserve, release, restock",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(inventory_updates_total[5m])) by (action)", "legendFormat": "{{ action }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 45 },
      "id": 16,
      "title": "Duration — Processing Latency (P50 / P95)",
      "description": "Time to process stock reserve/release",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(inventory_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(inventory_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "ops", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 45 },
      "id": 17,
      "title": "Errors — Error Rate (by Event Type)",
      "description": "Inventory update errors per second",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(inventory_errors_total[5m])) by (event_type)", "legendFormat": "{{ event_type }}" }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 }, "id": 106, "title": "📊 Business KPIs", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 54 },
      "id": 20,
      "title": "Orders Created (by Status)",
      "description": "Business view: orders per second grouped by final status (completed, payment_error, out_of_stock)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(orders_created_total[5m])) by (status)", "legendFormat": "{{ status }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 54 },
      "id": 21,
      "title": "Payments (by Status & Provider)",
      "description": "Business view: payment outcomes per provider (Stripe, PayPal, Square)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(payments_total[5m])) by (status, provider)", "legendFormat": "{{ provider }} — {{ status }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops", "min": 0, "custom": { "fillOpacity": 15 } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 54 },
      "id": 22,
      "title": "Inventory Checks (by Result)",
      "description": "Stock availability outcomes: in_stock vs out_of_stock",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(inventory_checks_total[5m])) by (result)", "legendFormat": "{{ result }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 62 },
      "id": 23,
      "title": "Notifications Sent (by Type)",
      "description": "Business view: notification delivery by type (order_confirmation, payment_failed, etc.)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(notifications_sent_total[5m])) by (type)", "legendFormat": "{{ type }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" }, "unit": "ops", "min": 0, "custom": { "fillOpacity": 20, "lineWidth": 2 }, "noValue": "No restocks triggered (stock above threshold)" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 62 },
      "id": 24,
      "title": "Auto-Restock Events",
      "description": "Automatic stock replenishment when stock drops below threshold (default: 10 units)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(inventory_restock_total[5m])) by (product_id)", "legendFormat": "product {{ product_id }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "currencyUSD", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 62 },
      "id": 25,
      "title": "Payment Amount (Average by Provider)",
      "description": "Average payment amount in USD by provider",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(payment_amount_dollars_sum[5m])) by (provider) / sum(rate(payment_amount_dollars_count[5m])) by (provider)", "legendFormat": "{{ provider }} avg" }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 70 }, "id": 103, "title": "📈 End-to-End Overview", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 71 },
      "id": 10,
      "title": "Service Latency Comparison (P95)",
      "description": "P95 latency of each service to identify bottlenecks",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(api_gateway_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "API Gateway" },
        { "expr": "histogram_quantile(0.95, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Order Service" },
        { "expr": "histogram_quantile(0.95, sum(rate(payment_gateway_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Payment Gateway" },
        { "expr": "histogram_quantile(0.95, sum(rate(notification_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Notification Worker" },
        { "expr": "histogram_quantile(0.95, sum(rate(inventory_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Inventory Worker" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 71 },
      "id": 11,
      "title": "Throughput Comparison",
      "description": "Operations per second across all services for relative comparison",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(api_gateway_requests_total[5m]))", "legendFormat": "API Gateway" },
        { "expr": "sum(rate(orders_created_total[5m]))", "legendFormat": "Orders" },
        { "expr": "sum(rate(payments_total[5m]))", "legendFormat": "Payments" },
        { "expr": "sum(rate(notifications_sent_total[5m]))", "legendFormat": "Notifications" },
        { "expr": "sum(rate(inventory_updates_total[5m]))", "legendFormat": "Inventory" }
      ]
    }
  ],
