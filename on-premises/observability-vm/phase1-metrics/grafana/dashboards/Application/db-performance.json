{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    { "title": "App Performance", "url": "/d/app-performance-microservices", "type": "link", "icon": "dashboard" },
    { "title": "Cache", "url": "/d/cache-performance", "type": "link", "icon": "dashboard" },
    { "title": "SLO Overview", "url": "/d/slo-overview", "type": "link", "icon": "dashboard" }
  ],
  "panels": [
    {
      "title": "DB Query Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(db_query_duration_seconds_bucket{job=\"app-metrics\"}[5m])) by (le, operation))",
          "legendFormat": "p50 — {{ operation }}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket{job=\"app-metrics\"}[5m])) by (le, operation))",
          "legendFormat": "p95 — {{ operation }}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(db_query_duration_seconds_bucket{job=\"app-metrics\"}[5m])) by (le, operation))",
          "legendFormat": "p99 — {{ operation }}"
        }
      ]
    },
    {
      "title": "DB Connection Pool Activity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "expr": "db_connection_pool_active{job=\"app-metrics\"}",
          "legendFormat": "Active Connections"
        },
        {
          "expr": "db_connection_pool_max{job=\"app-metrics\"}",
          "legendFormat": "Max Pool Size"
        }
      ]
    },
    {
      "title": "DB Pool Wait Time (P95)",
      "description": "Thời gian chờ để lấy connection từ pool (P95). Khi pool đầy, threads phải queue → wait time tăng vọt. Đây là Leading Indicator cho DB Saturation.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(db_pool_wait_seconds_bucket{job=\"app-metrics\"}[5m])) by (le, operation))",
          "legendFormat": "P95 Wait Time",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(db_pool_wait_seconds_bucket{job=\"app-metrics\"}[5m])) by (le, operation))",
          "legendFormat": "P50 Wait Time",
          "refId": "B"
        }
      ]
    },
    {
      "title": "DB Queries per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(db_query_duration_seconds_count{job=\"app-metrics\"}[5m])) by (operation)",
          "legendFormat": "{{ operation }}"
        }
      ]
    },
    {
      "title": "Slow Queries (> 100ms)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki-datasource" },
      "targets": [
        {
          "expr": "{compose_service=\"order-service\"} |= `Slow database query`",
          "legendFormat": ""
        }
      ]
    },
    {
      "title": "Avg Query Duration",
      "description": "Thời gian trung bình của DB queries (baseline 1-10ms). Tính bằng sum(rate(duration_sum)) / sum(rate(duration_count)). Grouped by operation (SELECT/INSERT/UPDATE/DELETE)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(db_query_duration_seconds_sum{job=\"app-metrics\"}[5m])) / sum by (operation) (rate(db_query_duration_seconds_count{job=\"app-metrics\"}[5m]))",
          "legendFormat": "{{ operation }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "DB Connection Pool Utilization (%)",
      "description": "Tỷ lệ % connection pool đang được sử dụng. >80% = nguy cơ saturation.",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.6 },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "db_connection_pool_active{job=\"app-metrics\"} / db_connection_pool_max{job=\"app-metrics\"}",
          "legendFormat": "Pool Utilization",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Order Processing Duration by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(order_processing_duration_seconds_bucket{job=\"app-metrics\"}[5m])) by (le, status))",
          "legendFormat": "p95 — {{ status }}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["application", "database", "postgresql"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Database Performance",
  "uid": "db-performance"
}