    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "🔥 Multi-Window Burn Rate (MWMBR)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Critical (14.4x)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Warning (3x)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "title": "API Gateway Burn Rate (Multi-Window)",
      "description": "Fast burn: 5m+1h windows (>14.4x = page). Slow burn: 30m+6h windows (>3x = ticket).",
      "type": "timeseries",
      "targets": [
        {
          "expr": "((1 - sli:api_gateway_availability:rate5m) / (1 - 0.995)) or vector(0)",
          "legendFormat": "Fast (5m)"
        },
        {
          "expr": "((1 - sli:api_gateway_availability:rate1h) / (1 - 0.995)) or vector(0)",
          "legendFormat": "Fast (1h)"
        },
        {
          "expr": "((1 - sli:api_gateway_availability:rate6h) / (1 - 0.995)) or vector(0)",
          "legendFormat": "Slow (6h)"
        },
        {
          "expr": "14.4",
          "legendFormat": "Critical (14.4x)"
        },
        {
          "expr": "3",
          "legendFormat": "Warning (3x)"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
