          {"text": "notification-worker", "value": "notification-worker", "selected": false},
          {"text": "inventory-worker", "value": "inventory-worker", "selected": false},
          {"text": "traffic-gen", "value": "traffic-gen", "selected": false}
        ],
        "query": "api-gateway,order-service,payment-service,notification-worker,inventory-worker,traffic-gen",
        "label": "Service",
        "hide": 0
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Profiling — Continuous Profiling (Pyroscope)",
  "uid": "profiling-overview",
