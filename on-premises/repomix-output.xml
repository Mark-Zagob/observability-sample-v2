 98:         labels:
 99:           environment: "lab"
100:           type: "span-metrics"
101: 
102:   # ==========================================================
103:   # REMOTE TARGETS (App VM — 192.168.100.57)
104:   # ==========================================================
105: 
106:   # ----------------------------------------------------------
107:   # 7. Node Exporter — App VM
108:   # ----------------------------------------------------------
109:   - job_name: "node-exporter-app"
110:     static_configs:
111:       - targets: ["192.168.100.57:9100"]
112:         labels:
113:           environment: "lab"
114:           type: "infrastructure"
115:           vm: "app"
116: 
117:   # ----------------------------------------------------------
118:   # 8. cAdvisor — App VM containers
119:   # ----------------------------------------------------------
120:   - job_name: "cadvisor-app"
121:     static_configs:
122:       - targets: ["192.168.100.57:8080"]
123:         labels:
124:           environment: "lab"
125:           type: "container"
126:           vm: "app"
127: 
128:   # ----------------------------------------------------------
129:   # 9. Traffic Generator — App VM (for conditional alerting)
130:   # ----------------------------------------------------------
131:   - job_name: "traffic-gen"
132:     static_configs:
133:       - targets: ["192.168.100.57:5003"]
134:         labels:
135:           environment: "lab"
136:           type: "traffic-gen"
137:           vm: "app"
138: 
139:   # ----------------------------------------------------------
140:   # 10. Kafka Exporter — App VM
141:   # ----------------------------------------------------------
142:   - job_name: "kafka-exporter"
143:     static_configs:
144:       - targets: ["192.168.100.57:9308"]
145:         labels:
146:           environment: "lab"
147:           type: "kafka"
148:           vm: "app"
149: 
150:   # ----------------------------------------------------------
151:   # 11. Blackbox Exporter — Active Health Probing
152:   # ----------------------------------------------------------
153:   # Probe /health/live endpoints trên App VM.
154:   # Sử dụng relabel chuẩn: __address__ → __param_target,
155:   # rồi thay __address__ bằng blackbox-exporter.
156:   # ----------------------------------------------------------
157:   - job_name: "blackbox"
158:     metrics_path: /probe
159:     params:
160:       module: [http_2xx]
161:     static_configs:
162:       - targets:
163:           - http://192.168.100.57:5000/health/live   # api-gateway
164:           - http://192.168.100.57:5001/health/live   # order-service
165:           - http://192.168.100.57:5002/health/live   # payment-service
166:           - http://192.168.100.57:5004/health/live   # notification-worker
167:           - http://192.168.100.57:5005/health/live   # inventory-worker
168:         labels:
169:           environment: "lab"
170:     relabel_configs:
171:       # Giữ target URL gốc làm label "instance"
172:       - source_labels: [__address__]
173:         target_label: __param_target
174:       # Extract service name từ port
175:       - source_labels: [__param_target]
176:         regex: "http://[^:]+:(\\d+)/.*"
177:         replacement: "$1"
178:         target_label: port
179:       # Chuyển __address__ sang blackbox-exporter
180:       - target_label: __address__
181:         replacement: blackbox-exporter:9115
</file>

<file path="observability-vm/phase1-metrics/prometheus/recording_rules.yml">
 1: # ============================================================
 2: # Recording Rules - Pre-computed Metrics
 3: # ============================================================
 4: # Recording rules tính trước các PromQL phức tạp và lưu
 5: # thành metrics mới. Lợi ích:
 6: #   - Dashboard/Alert query nhanh hơn (chỉ đọc kết quả)
 7: #   - DRY: viết PromQL phức tạp 1 lần
 8: #   - Nhiều users xem dashboard = tính 1 lần
 9: #
10: # Naming convention:  level:metric_name:operation
11: # ============================================================
12: 
13: groups:
14:   # ----------------------------------------------------------
15:   # Application Recording Rules (từ span metrics)
16:   # ----------------------------------------------------------
17:   - name: app_recording_rules
18:     interval: 30s
19:     rules:
20: 
21:       # Request rate by service (req/s)
22:       - record: service:request_rate:5m
23:         expr: |
24:           sum by (service_name) (
25:             rate(traces_spanmetrics_calls_total{
26:               span_kind="SPAN_KIND_SERVER"
27:             }[5m])
28:           )
29: 
30:       # Error rate by service (%)
31:       - record: service:error_rate_percent:5m
32:         expr: |
33:           100 * sum by (service_name) (
34:             rate(traces_spanmetrics_calls_total{
35:               span_kind="SPAN_KIND_SERVER",
36:               status_code="STATUS_CODE_ERROR"
37:             }[5m])
38:           )
39:           /
40:           sum by (service_name) (
41:             rate(traces_spanmetrics_calls_total{
42:               span_kind="SPAN_KIND_SERVER"
43:             }[5m])
44:           )
45: 
46:       # P95 latency by service (seconds)
47:       - record: service:latency_p95:5m
48:         expr: |
49:           histogram_quantile(0.95,
50:             sum by (le, service_name) (
51:               rate(traces_spanmetrics_latency_bucket{
52:                 span_kind="SPAN_KIND_SERVER"
53:               }[5m])
54:             )
55:           )
56: 
57:       # P50 latency by service (seconds)
58:       - record: service:latency_p50:5m
59:         expr: |
60:           histogram_quantile(0.50,
61:             sum by (le, service_name) (
62:               rate(traces_spanmetrics_latency_bucket{
63:                 span_kind="SPAN_KIND_SERVER"
64:               }[5m])
65:             )
66:           )
67: 
68:   # ----------------------------------------------------------
69:   # Infrastructure Recording Rules
70:   # ----------------------------------------------------------
71:   - name: infra_recording_rules
72:     interval: 30s
73:     rules:
74: 
75:       # CPU usage by instance (%)
76:       - record: instance:cpu_usage_percent:5m
77:         expr: |
78:           100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)
79: 
80:       # Memory usage by instance (%)
81:       - record: instance:memory_usage_percent:5m
82:         expr: |
83:           (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100
</file>

<file path="observability-vm/phase1-metrics/prometheus/tracing_alert_rules.yml">
  1: # ============================================================
  2: # Alert Rules - Application / Tracing (Phase 4)
  3: # ============================================================
  4: # Alert rules cho application layer, dựa trên span metrics
  5: # từ Tempo metrics_generator → Prometheus.
  6: # ============================================================
  7: 
  8: groups:
  9:   # ----------------------------------------------------------
 10:   # Application Alerts (từ span metrics)
 11:   # ----------------------------------------------------------
 12:   - name: application_alerts
 13:     interval: 30s
 14:     rules:
 15: 
 16:       # Error rate > 10% trên bất kỳ service nào
 17:       - alert: HighErrorRate
 18:         expr: |
 19:           100 * sum by (service_name) (
 20:             rate(traces_spanmetrics_calls_total{
 21:               span_kind="SPAN_KIND_SERVER",
 22:               status_code="STATUS_CODE_ERROR"
 23:             }[5m])
 24:           )
 25:           /
 26:           sum by (service_name) (
 27:             rate(traces_spanmetrics_calls_total{
 28:               span_kind="SPAN_KIND_SERVER"
 29:             }[5m])
 30:           ) > 10
 31:         for: 3m
 32:         labels:
 33:           severity: warning
 34:         annotations:
 35:           summary: "High error rate on {{ $labels.service_name }}"
 36:           description: "{{ $labels.service_name }} has {{ $value | printf \"%.1f\" }}% error rate (threshold: 10%)"
 37: 
 38:       # P95 latency > 2 giây
 39:       - alert: HighLatencyP95
 40:         expr: |
 41:           histogram_quantile(0.95,
 42:             sum by (le, service_name) (
 43:               rate(traces_spanmetrics_latency_bucket{
 44:                 span_kind="SPAN_KIND_SERVER"
 45:               }[5m])
 46:             )
 47:           ) > 2
 48:         for: 3m
 49:         labels:
 50:           severity: warning
 51:         annotations:
 52:           summary: "High P95 latency on {{ $labels.service_name }}"
 53:           description: "{{ $labels.service_name }} P95 latency is {{ $value | printf \"%.2f\" }}s (threshold: 2s)"
 54: 
 55:       # ----------------------------------------------------------
 56:       # Service Down Detection (conditional on load test running)
 57:       # ----------------------------------------------------------
 58:       # ⚠️ Chỉ fire khi traffic-gen đang chạy (traffic_gen_running == 1)
 59:       # mà không thấy traces từ service.
 60:       #
 61:       # Khi idle (không load test): alert KHÔNG fire.
 62:       # Khi load test đang chạy mà service down: alert fire.
 63:       #
 64:       # Logic: absent_over_time trả vector rỗng khi metric có
 65:       # → dùng "or on() vector(0)" để lấy 0 khi metric tồn tại,
 66:       # 1 khi metric absent. Rồi nhân với traffic_gen_running.
 67:       # ----------------------------------------------------------
 68: 
 69:       - alert: ServiceNoTraces_ApiGateway
 70:         expr: |
 71:           (
 72:             absent_over_time(
 73:               traces_spanmetrics_calls_total{
 74:                 span_kind="SPAN_KIND_SERVER",
 75:                 service_name="api-gateway"
 76:               }[3m]
 77:             )
 78:           )
 79:           and on() (traffic_gen_running == 1)
 80:         for: 2m
 81:         labels:
 82:           severity: critical
 83:           service_name: api-gateway
 84:         annotations:
 85:           summary: "No traces from api-gateway (load test active)"
 86:           description: "Load test is running but api-gateway has not produced any traces in 3+ minutes. Service may be down."
 87: 
 88:       - alert: ServiceNoTraces_OrderService
 89:         expr: |
 90:           (
 91:             absent_over_time(
 92:               traces_spanmetrics_calls_total{
 93:                 span_kind="SPAN_KIND_SERVER",
 94:                 service_name="order-service"
 95:               }[3m]
 96:             )
 97:           )
 98:           and on() (traffic_gen_running == 1)
 99:         for: 2m
100:         labels:
101:           severity: critical
102:           service_name: order-service
103:         annotations:
104:           summary: "No traces from order-service (load test active)"
105:           description: "Load test is running but order-service has not produced any traces in 3+ minutes. Service may be down."
106: 
107:       - alert: ServiceNoTraces_PaymentService
108:         expr: |
109:           (
110:             absent_over_time(
111:               traces_spanmetrics_calls_total{
112:                 span_kind="SPAN_KIND_SERVER",
113:                 service_name="payment-service"
114:               }[3m]
115:             )
116:           )
117:           and on() (traffic_gen_running == 1)
118:         for: 2m
119:         labels:
120:           severity: critical
121:           service_name: payment-service
122:         annotations:
123:           summary: "No traces from payment-service (load test active)"
124:           description: "Load test is running but payment-service has not produced any traces in 3+ minutes. Service may be down."
</file>

<file path="observability-vm/phase1-metrics/webhook-receiver/app.py">
  1: """
  2: ============================================================
  3: Webhook Receiver — Test Alertmanager Notifications
  4: ============================================================
  5: Flask app đơn giản nhận webhook POST từ Alertmanager
  6: và hiển thị alerts trên web UI + console.
  7: 
  8: Endpoints:
  9:   GET  /          → Web UI xem alerts đã nhận
 10:   POST /webhook   → Nhận alerts từ Alertmanager
 11:   GET  /health    → Health check
 12: ============================================================
 13: """
 14: 
 15: import json
 16: from datetime import datetime
 17: from flask import Flask, request, jsonify
 18: 
 19: app = Flask(__name__)
 20: 
 21: # Lưu alerts trong memory (mất khi restart)
 22: received_alerts = []
 23: MAX_ALERTS = 200
 24: 
 25: @app.route("/webhook", methods=["POST"])
 26: def webhook():
 27:     """Nhận alert notification từ Alertmanager"""
 28:     data = request.get_json(force=True)
 29: 
 30:     entry = {
 31:         "received_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
 32:         "status": data.get("status", "unknown"),
 33:         "alerts_count": len(data.get("alerts", [])),
 34:         "alerts": data.get("alerts", []),
 35:         "group_labels": data.get("groupLabels", {}),
 36:     }
 37:     received_alerts.insert(0, entry)
 38: 
 39:     # Giới hạn số lượng lưu
 40:     while len(received_alerts) > MAX_ALERTS:
 41:         received_alerts.pop()
 42: 
 43:     # In ra console để dễ debug
 44:     print(f"\n{'='*60}")
 45:     print(f"🔔 [{entry['received_at']}] Status: {entry['status'].upper()}")
 46:     for alert in data.get("alerts", []):
 47:         status = alert.get("status", "unknown")
 48:         name = alert.get("labels", {}).get("alertname", "?")
 49:         severity = alert.get("labels", {}).get("severity", "?")
 50:         summary = alert.get("annotations", {}).get("summary", "")
 51:         icon = "🔥" if status == "firing" else "✅"
 52:         print(f"  {icon} {name} [{severity}] — {summary}")
 53:     print(f"{'='*60}\n")
 54: 
 55:     return jsonify({"status": "ok"}), 200
 56: 
 57: 
 58: @app.route("/")
 59: def index():
 60:     """Web UI — hiển thị alerts đã nhận"""
 61:     rows = ""
 62:     for entry in received_alerts:
 63:         status = entry["status"]
 64:         color = "#ff4444" if status == "firing" else "#44bb44"
 65:         for alert in entry["alerts"]:
 66:             a_status = alert.get("status", "?")
 67:             name = alert.get("labels", {}).get("alertname", "?")
 68:             severity = alert.get("labels", {}).get("severity", "?")
 69:             instance = alert.get("labels", {}).get("instance", "—")
 70:             summary = alert.get("annotations", {}).get("summary", "")
 71:             sev_color = "#ff4444" if severity == "critical" else "#ffaa00" if severity == "warning" else "#4488ff"
 72:             icon = "🔥" if a_status == "firing" else "✅"
 73:             rows += f"""
 74:             <tr>
 75:                 <td>{entry['received_at']}</td>
 76:                 <td>{icon} {a_status}</td>
 77:                 <td style="color:{sev_color};font-weight:bold">{severity.upper()}</td>
 78:                 <td><strong>{name}</strong></td>
 79:                 <td>{instance}</td>
 80:                 <td>{summary}</td>
 81:             </tr>"""
 82: 
 83:     if not rows:
 84:         rows = '<tr><td colspan="6" style="text-align:center;padding:40px;color:#888">Chưa nhận được alert nào. Đợi Alertmanager gửi notification...</td></tr>'
 85: 
 86:     html = f"""<!DOCTYPE html>
 87: <html>
 88: <head>
 89:     <title>Webhook Receiver — Alertmanager Test</title>
 90:     <meta http-equiv="refresh" content="10">
 91:     <style>
 92:         body {{ font-family: -apple-system, sans-serif; background: #1a1a2e; color: #e0e0e0; margin: 0; padding: 20px; }}
 93:         h1 {{ color: #00d4ff; }}
 94:         .info {{ color: #888; margin-bottom: 20px; }}
 95:         table {{ width: 100%; border-collapse: collapse; }}
 96:         th {{ background: #16213e; color: #00d4ff; padding: 12px; text-align: left; }}
 97:         td {{ padding: 10px 12px; border-bottom: 1px solid #2a2a4a; }}
 98:         tr:hover {{ background: #16213e; }}
 99:         .count {{ background: #00d4ff; color: #1a1a2e; padding: 4px 12px; border-radius: 12px; font-weight: bold; }}
100:     </style>
101: </head>
102: <body>
103:     <h1>🔔 Webhook Receiver</h1>
104:     <p class="info">
105:         Total received: <span class="count">{len(received_alerts)}</span> notifications
106:         &nbsp;|&nbsp; Auto-refresh mỗi 10s
107:         &nbsp;|&nbsp; POST endpoint: <code>/webhook</code>
108:     </p>
109:     <table>
110:         <tr>
111:             <th>Time</th>
112:             <th>Status</th>
113:             <th>Severity</th>
114:             <th>Alert</th>
115:             <th>Instance</th>
116:             <th>Summary</th>
117:         </tr>
118:         {rows}
119:     </table>
120: </body>
121: </html>"""
122:     return html
123: 
124: 
125: @app.route("/health")
126: def health():
127:     return jsonify({"status": "healthy", "alerts_received": len(received_alerts)})
128: 
129: 
130: if __name__ == "__main__":
131:     print("🔔 Webhook Receiver started on :9095")
132:     print("   POST /webhook  — nhận alerts từ Alertmanager")
133:     print("   GET  /         — web UI xem alerts")
134:     app.run(host="0.0.0.0", port=9095)
</file>

<file path="observability-vm/phase1-metrics/webhook-receiver/Dockerfile">
 1: FROM python:3.12-slim
