<file path="observability-vm/phase1-metrics/grafana/provisioning/dashboards/dashboards.yml">
 1: # ============================================================
 2: # Grafana Dashboard Provisioning Config
 3: # ============================================================
 4: # Grafana sẽ tự tạo folders dựa trên cấu trúc thư mục:
 5: #   dashboards/Infrastructure/*.json → folder "Infrastructure"
 6: #   dashboards/Logging/*.json        → folder "Logging"
 7: #   dashboards/Tracing/*.json        → folder "Tracing"
 8: # ============================================================
 9: 
10: apiVersion: 1
11: 
12: providers:
13:   - name: "default"
14:     orgId: 1
15:     type: file
16:     disableDeletion: false
17:     editable: true                     # Cho phép chỉnh sửa trên UI
18:     updateIntervalSeconds: 30          # Kiểm tra file thay đổi mỗi 30s
19:     options:
20:       path: /var/lib/grafana/dashboards
21:       foldersFromFilesStructure: true  # Tự tạo folder từ subfolder names
</file>

<file path="observability-vm/phase1-metrics/grafana/provisioning/datasources/loki.yml">
