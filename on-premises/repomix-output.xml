  1: """
  2: Database utilities — shared across services that use PostgreSQL/Redis.
  3: """
  4: import time
  5: import json
  6: import logging
  7: 
  8: # psycopg2 and redis are imported lazily inside their respective classes
  9: # so services that don't need them won't crash on import.
 10: 
 11: logger = logging.getLogger(__name__)
 12: 
 13: # ----------------------------------------------------------
 14: # Connection resilience
 15: # ----------------------------------------------------------
 16: MAX_RETRIES = 5
 17: RETRY_DELAY = 2  # seconds, doubles each retry
 18: 
 19: 
 20: def retry_connect(name, connect_fn, max_retries=MAX_RETRIES, delay=RETRY_DELAY):
 21:     """Retry a connection function with exponential backoff.
 22: 
 23:     Args:
 24:         name: Human-readable name for logging
 25:         connect_fn: Callable that returns the connection/client
 26:         max_retries: Maximum number of retry attempts
 27:         delay: Initial delay in seconds (doubles each retry)
 28: 
 29:     Returns:
 30:         The connection object from connect_fn
 31: 
 32:     Raises:
 33:         Last exception if all retries exhausted
 34:     """
 35:     last_error = None
 36:     for attempt in range(1, max_retries + 1):
 37:         try:
 38:             result = connect_fn()
 39:             logger.info(f"{name} connected", extra={"attempt": attempt})
 40:             return result
 41:         except Exception as e:
 42:             last_error = e
 43:             wait = delay * (2 ** (attempt - 1))
 44:             logger.warning(f"{name} connection failed, retrying",
 45:                            extra={"attempt": attempt, "max_retries": max_retries,
 46:                                   "wait_seconds": wait, "error": str(e)})
 47:             time.sleep(wait)
 48:     logger.error(f"{name} connection failed after {max_retries} retries",
 49:                  extra={"error": str(last_error)})
 50:     raise last_error
 51: 
 52: 
 53: def parse_db_url(url):
 54:     """Parse postgresql://user:pass@host:port/dbname into dict."""
 55:     url = url.replace("postgresql://", "")
 56:     userpass, hostdb = url.split("@")
 57:     user, password = userpass.split(":")
 58:     hostport, dbname = hostdb.split("/")
 59:     host, port = hostport.split(":")
 60:     return {
 61:         "user": user, "password": password,
 62:         "host": host, "port": int(port), "dbname": dbname,
 63:     }
 64: 
 65: 
 66: # ----------------------------------------------------------
 67: # PostgreSQL helpers
 68: # ----------------------------------------------------------
 69: class DatabasePool:
 70:     """Lazy-initialized PostgreSQL connection pool with metrics support."""
 71: 
 72:     def __init__(self, db_url, minconn=2, maxconn=10, pool_active_counter=None,
 73:                  query_duration_histogram=None):
 74:         self._params = parse_db_url(db_url)
 75:         self._minconn = minconn
 76:         self._maxconn = maxconn
 77:         self._pool = None
 78:         self._pool_active_counter = pool_active_counter
 79:         self._query_duration_histogram = query_duration_histogram
 80: 
 81:     def _get_pool(self):
 82:         if self._pool is None:
 83:             import psycopg2.pool
 84:             def _connect():
 85:                 return psycopg2.pool.ThreadedConnectionPool(
 86:                     minconn=self._minconn, maxconn=self._maxconn, **self._params
 87:                 )
 88:             self._pool = retry_connect("PostgreSQL", _connect)
 89:         return self._pool
 90: 
 91:     def execute(self, query, params=None, fetch=True):
 92:         """Execute a query, return rows (fetch=True) or rowcount (fetch=False)."""
 93:         pool = self._get_pool()
 94:         conn = pool.getconn()
 95:         if self._pool_active_counter:
 96:             self._pool_active_counter.add(1)
 97:         start = time.time()
 98:         operation = query.strip().split()[0].upper() if query.strip() else "UNKNOWN"
 99:         try:
100:             import psycopg2.extras
101:             with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
102:                 cur.execute(query, params)
103:                 if fetch:
104:                     result = cur.fetchall()
105:                 else:
106:                     conn.commit()
107:                     result = cur.rowcount
108:             return result
109:         except Exception as e:
110:             conn.rollback()
111:             logger.error("Database query failed",
112:                          extra={"query": query[:100], "error": str(e)})
113:             raise
114:         finally:
115:             duration = time.time() - start
116:             pool.putconn(conn)
117:             if self._pool_active_counter:
118:                 self._pool_active_counter.add(-1)
119:             if self._query_duration_histogram:
120:                 self._query_duration_histogram.record(duration, {"operation": operation})
121:             if duration > 0.1:
122:                 logger.warning("Slow database query",
123:                                extra={"operation": operation,
124:                                       "duration_ms": round(duration * 1000, 1),
125:                                       "query": query[:200]})
126: 
127:     def get_conn(self):
128:         """Get a raw connection for manual transaction control."""
129:         return self._get_pool().getconn()
130: 
131:     def put_conn(self, conn):
132:         """Return a connection to the pool."""
133:         self._get_pool().putconn(conn)
134: 
135:     def check_health(self):
136:         """Check database connectivity. Returns True or raises."""
137:         self.execute("SELECT 1", fetch=True)
138:         return True
139: 
140: 
141: # ----------------------------------------------------------
142: # Redis helpers
143: # ----------------------------------------------------------
144: class RedisCache:
145:     """Lazy-initialized Redis client with cache-aside pattern support."""
146: 
147:     def __init__(self, redis_url, ttl=60, cache_ops_counter=None, cache_duration=None):
148:         self._redis_url = redis_url
149:         self._ttl = ttl
150:         self._client = None
151:         self._cache_ops_counter = cache_ops_counter
152:         self._cache_duration = cache_duration
153: 
154:     def _get_client(self):
155:         if self._client is None:
156:             import redis as redis_lib
157:             def _connect():
158:                 client = redis_lib.from_url(self._redis_url, decode_responses=True)
159:                 client.ping()
160:                 return client
161:             self._client = retry_connect("Redis", _connect)
162:         return self._client
163: 
164:     def get(self, key):
165:         """Get from cache. Returns parsed JSON or None."""
166:         start = time.time()
167:         try:
168:             value = self._get_client().get(key)
169:             duration = time.time() - start
170:             if self._cache_duration:
171:                 self._cache_duration.record(duration, {"operation": "get"})
172: 
173:             if value is not None:
174:                 if self._cache_ops_counter:
175:                     self._cache_ops_counter.add(1, {"operation": "get", "result": "hit"})
176:                 return json.loads(value)
177:             else:
178:                 if self._cache_ops_counter:
179:                     self._cache_ops_counter.add(1, {"operation": "get", "result": "miss"})
180:                 return None
181:         except Exception as e:
182:             if self._cache_ops_counter:
183:                 self._cache_ops_counter.add(1, {"operation": "get", "result": "error"})
184:             logger.error("Cache get failed", extra={"key": key, "error": str(e)})
185:             return None
186: 
187:     def set(self, key, value, ttl=None):
188:         """Set cache with TTL."""
189:         start = time.time()
190:         try:
191:             self._get_client().setex(key, ttl or self._ttl, json.dumps(value))
192:             duration = time.time() - start
193:             if self._cache_duration:
194:                 self._cache_duration.record(duration, {"operation": "set"})
195:             if self._cache_ops_counter:
196:                 self._cache_ops_counter.add(1, {"operation": "set", "result": "ok"})
197:         except Exception as e:
198:             if self._cache_ops_counter:
199:                 self._cache_ops_counter.add(1, {"operation": "set", "result": "error"})
200:             logger.error("Cache set failed", extra={"key": key, "error": str(e)})
201: 
202:     def delete(self, key):
203:         """Delete a cache key."""
204:         try:
205:             self._get_client().delete(key)
206:             if self._cache_ops_counter:
207:                 self._cache_ops_counter.add(1, {"operation": "delete", "result": "ok"})
208:         except Exception:
209:             pass
210: 
211:     def check_health(self):
212:         """Check Redis connectivity. Returns True or raises."""
213:         self._get_client().ping()
214:         return True
