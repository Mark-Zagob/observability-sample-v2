<file path="applications-vm/applications/traffic-gen/app.py">
  1: """
  2: ============================================================
  3: Traffic Generator — API-Controlled Load Testing Service
  4: ============================================================
  5: Flask API (port 5003) — Default: IDLE (no traffic)
  6: User controls start/stop/scenario/rate/duration via REST API.
  7: 
  8: Endpoints:
  9:   GET  /status  — current state + live stats
 10:   POST /start   — begin sending traffic
 11:   POST /stop    — stop traffic
 12:   GET  /health  — simple health check
 13: ============================================================
 14: """
 15: 
 16: import time
 17: import random
 18: import json
 19: import threading
 20: import requests
 21: from flask import Flask, jsonify, request as flask_request
 22: 
 23: app = Flask(__name__)
 24: 
 25: API_GATEWAY = "http://api-gateway:5000"
 26: NOTIFICATION_WORKER = "http://notification-worker:5004"
 27: INVENTORY_WORKER = "http://inventory-worker:5005"
 28: 
 29: # ============================================================
 30: # State
 31: # ============================================================
 32: state = {
 33:     "running": False,
 34:     "scenario": None,
 35:     "rate": 1,          # requests per second
 36:     "duration": 60,     # seconds
 37:     "started_at": None,
 38:     "stats": {
 39:         "total": 0,
 40:         "success": 0,
 41:         "errors": 0,
 42:         "elapsed": 0,
 43:     },
 44: }
 45: lock = threading.Lock()
 46: stop_event = threading.Event()
 47: 
 48: 
 49: # ============================================================
 50: # Traffic Flow Functions
 51: # ============================================================
 52: def flow_browse_products():
 53:     """User browses product catalog"""
 54:     resp = requests.get(f"{API_GATEWAY}/products", timeout=10)
 55:     return resp.status_code < 500
 56: 
 57: 
 58: def flow_create_order():
 59:     """User creates an order"""
 60:     product_id = random.randint(1, 5)
 61:     quantity = random.randint(1, 3)
 62:     payload = {"product_id": product_id, "quantity": quantity}
 63:     resp = requests.post(
 64:         f"{API_GATEWAY}/order",
 65:         json=payload,
 66:         headers={"Content-Type": "application/json"},
 67:         timeout=30,
 68:     )
 69:     return resp.status_code < 500
 70: 
 71: 
 72: def flow_view_orders():
 73:     """User views order history"""
 74:     resp = requests.get(f"{API_GATEWAY}/orders?limit=10", timeout=10)
 75:     return resp.status_code < 500
 76: 
 77: 
 78: def flow_browse_then_buy():
 79:     """User browses products, then buys one"""
 80:     resp = requests.get(f"{API_GATEWAY}/products", timeout=10)
 81:     if resp.status_code < 500:
 82:         products = resp.json().get("products", [])
 83:         if products:
 84:             time.sleep(random.uniform(0.2, 0.8))
 85:             product = random.choice(products)
 86:             payload = {"product_id": product["id"], "quantity": random.randint(1, 3)}
 87:             resp2 = requests.post(
 88:                 f"{API_GATEWAY}/order",
 89:                 json=payload,
 90:                 headers={"Content-Type": "application/json"},
 91:                 timeout=30,
 92:             )
 93:             return resp2.status_code < 500
 94:     return resp.status_code < 500
 95: 
 96: 
 97: def flow_check_notifications():
 98:     """Check recent notifications from notification-worker"""
 99:     resp = requests.get(f"{NOTIFICATION_WORKER}/notifications?limit=10", timeout=10)
100:     return resp.status_code < 500
101: 
102: 
103: def flow_check_inventory():
104:     """Check inventory status from inventory-worker"""
105:     resp = requests.get(f"{INVENTORY_WORKER}/inventory", timeout=10)
106:     return resp.status_code < 500
107: 
108: 
109: def flow_order_then_check_events():
110:     """Create order, then verify event processing by workers"""
111:     # Step 1: Create order
112:     product_id = random.randint(1, 5)
113:     payload = {"product_id": product_id, "quantity": 1}
114:     resp = requests.post(
115:         f"{API_GATEWAY}/order",
116:         json=payload,
117:         headers={"Content-Type": "application/json"},
118:         timeout=30,
119:     )
120:     if resp.status_code >= 500:
121:         return False
122:     # Step 2: Brief wait for async processing
123:     time.sleep(random.uniform(0.5, 1.5))
124:     # Step 3: Check notification-worker processed it
125:     resp2 = requests.get(f"{NOTIFICATION_WORKER}/status", timeout=5)
126:     # Step 4: Check inventory-worker processed it
127:     resp3 = requests.get(f"{INVENTORY_WORKER}/status", timeout=5)
128:     return resp2.status_code < 500 and resp3.status_code < 500
129: 
130: 
131: def flow_health_check():
132:     """Simple health check"""
133:     resp = requests.get(f"{API_GATEWAY}/health", timeout=5)
134:     return resp.status_code < 500
135: 
136: 
137: # ============================================================
138: # Scenario Definitions
139: # ============================================================
140: SCENARIOS = {
141:     "normal": {
142:         "label": "Normal Traffic",
143:         "description": "Balanced user activity — browsing, ordering, viewing history",
144:         "default_rate": 2,
145:         "flows": [
146:             (flow_browse_then_buy, 30),
147:             (flow_create_order, 25),
148:             (flow_browse_products, 25),
149:             (flow_view_orders, 15),
150:             (flow_health_check, 5),
151:         ],
152:     },
153:     "flash_sale": {
154:         "label": "Flash Sale",
155:         "description": "High-volume ordering — simulates promotion/sale event",
156:         "default_rate": 10,
157:         "flows": [
158:             (flow_create_order, 50),
159:             (flow_browse_then_buy, 30),
160:             (flow_browse_products, 15),
161:             (flow_view_orders, 5),
162:         ],
163:     },
164:     "browse_heavy": {
165:         "label": "Browse Heavy",
166:         "description": "Mostly browsing with occasional orders — window shoppers",
167:         "default_rate": 5,
168:         "flows": [
169:             (flow_browse_products, 50),
170:             (flow_view_orders, 20),
171:             (flow_browse_then_buy, 20),
172:             (flow_create_order, 10),
173:         ],
174:     },
175:     "health_check": {
176:         "label": "Health Check Only",
177:         "description": "Continuous health checks — monitors service availability",
178:         "default_rate": 3,
179:         "flows": [
180:             (flow_health_check, 100),
181:         ],
182:     },
183:     "event_driven": {
184:         "label": "Event-Driven Pipeline",
185:         "description": "Orders + verify Kafka event processing (notifications + inventory)",
186:         "default_rate": 3,
187:         "flows": [
188:             (flow_order_then_check_events, 35),
189:             (flow_create_order, 20),
190:             (flow_check_notifications, 20),
191:             (flow_check_inventory, 15),
192:             (flow_browse_products, 10),
193:         ],
194:     },
195: }
196: 
197: 
198: def build_flow_pool(scenario_name):
199:     """Build weighted list of flow functions for random selection."""
200:     scenario = SCENARIOS.get(scenario_name, SCENARIOS["normal"])
201:     pool = []
202:     for func, weight in scenario["flows"]:
203:         pool.extend([func] * weight)
204:     return pool
205: 
206: 
207: # ============================================================
208: # Background Worker
209: # ============================================================
210: def traffic_worker(scenario, rate, duration):
211:     """Run traffic in background thread."""
212:     pool = build_flow_pool(scenario)
213:     delay = 1.0 / max(rate, 0.1)
214:     start_time = time.time()
215: 
216:     print(f"🚀 Traffic started: scenario={scenario}, rate={rate}/s, duration={duration}s")
217: 
218:     while not stop_event.is_set():
219:         elapsed = time.time() - start_time
220:         if elapsed >= duration:
221:             print(f"⏱️ Duration reached ({duration}s). Stopping.")
222:             break
223: 
224:         try:
225:             flow = random.choice(pool)
226:             success = flow()
227:             with lock:
228:                 state["stats"]["total"] += 1
229:                 if success:
230:                     state["stats"]["success"] += 1
231:                 else:
232:                     state["stats"]["errors"] += 1
233:                 state["stats"]["elapsed"] = round(elapsed, 1)
234:         except Exception as e:
235:             with lock:
236:                 state["stats"]["total"] += 1
237:                 state["stats"]["errors"] += 1
238:                 state["stats"]["elapsed"] = round(elapsed, 1)
239:             print(f"  ❌ ERROR: {type(e).__name__}: {e}")
240: 
241:         # Add jitter: ±30% of base delay
242:         jitter = delay * random.uniform(0.7, 1.3)
243:         stop_event.wait(jitter)
244: 
245:     with lock:
246:         state["running"] = False
247:         state["stats"]["elapsed"] = round(time.time() - start_time, 1)
248: 
249:     print(f"🛑 Traffic stopped. Stats: {state['stats']}")
250: 
251: 
252: # ============================================================
253: # API Endpoints
254: # ============================================================
255: @app.route("/health")
256: def health():
257:     return jsonify({"status": "ok", "service": "traffic-gen"})
258: 
259: 
260: @app.route("/metrics")
261: def metrics():
262:     """Prometheus metrics endpoint."""
263:     with lock:
264:         running = 1 if state["running"] else 0
265:         total = state["stats"]["total"]
266:         success = state["stats"]["success"]
267:         errors = state["stats"]["errors"]
268: 
269:     lines = [
270:         "# HELP traffic_gen_running Whether the traffic generator is currently running (1=running, 0=idle)",
271:         "# TYPE traffic_gen_running gauge",
272:         f"traffic_gen_running {running}",
273:         "# HELP traffic_gen_requests_total Total requests sent by traffic generator",
274:         "# TYPE traffic_gen_requests_total counter",
275:         f'traffic_gen_requests_total{{result="success"}} {success}',
276:         f'traffic_gen_requests_total{{result="error"}} {errors}',
277:         "",
278:     ]
279:     from flask import Response
280:     return Response("\n".join(lines), mimetype="text/plain; version=0.0.4")
281: 
282: 
283: @app.route("/status")
284: def status():
285:     with lock:
286:         return jsonify({
287:             "running": state["running"],
288:             "scenario": state["scenario"],
289:             "rate": state["rate"],
290:             "duration": state["duration"],
291:             "started_at": state["started_at"],
292:             "stats": dict(state["stats"]),
293:             "scenarios": {
294:                 name: {
295:                     "label": s["label"],
296:                     "description": s["description"],
297:                     "default_rate": s["default_rate"],
298:                 }
299:                 for name, s in SCENARIOS.items()
300:             },
301:         })
302: 
303: 
304: @app.route("/start", methods=["POST"])
305: def start():
306:     with lock:
307:         if state["running"]:
308:             return jsonify({"error": "Traffic is already running. Stop it first."}), 409
309: 
310:     data = flask_request.get_json(silent=True) or {}
311:     scenario = data.get("scenario", "normal")
312:     rate = min(max(int(data.get("rate", SCENARIOS.get(scenario, {}).get("default_rate", 2))), 1), 20)
313:     duration = min(max(int(data.get("duration", 60)), 10), 300)
314: 
315:     if scenario not in SCENARIOS:
316:         return jsonify({"error": f"Unknown scenario: {scenario}", "available": list(SCENARIOS.keys())}), 400
317: 
318:     # Reset state
319:     stop_event.clear()
320:     with lock:
321:         state["running"] = True
322:         state["scenario"] = scenario
323:         state["rate"] = rate
324:         state["duration"] = duration
325:         state["started_at"] = time.time()
326:         state["stats"] = {"total": 0, "success": 0, "errors": 0, "elapsed": 0}
327: 
328:     # Start worker thread
329:     t = threading.Thread(target=traffic_worker, args=(scenario, rate, duration), daemon=True)
330:     t.start()
331: 
332:     return jsonify({
333:         "message": f"Traffic started: {SCENARIOS[scenario]['label']}",
334:         "scenario": scenario,
335:         "rate": rate,
336:         "duration": duration,
337:     })
338: 
339: 
340: @app.route("/stop", methods=["POST"])
341: def stop():
342:     with lock:
343:         if not state["running"]:
344:             return jsonify({"message": "Traffic is not running."}), 200
345: 
346:     stop_event.set()
347: 
348:     # Wait briefly for thread to acknowledge stop
349:     time.sleep(0.5)
350: 
351:     with lock:
352:         state["running"] = False
353: 
354:     return jsonify({
355:         "message": "Traffic stopped.",
356:         "stats": dict(state["stats"]),
357:     })
358: 
359: 
360: # ============================================================
361: # Main
362: # ============================================================
363: if __name__ == "__main__":
364:     print("🚦 Traffic Generator API ready on port 5003")
365:     print("   Default state: IDLE — use POST /start to begin")
366:     app.run(host="0.0.0.0", port=5003)
</file>

