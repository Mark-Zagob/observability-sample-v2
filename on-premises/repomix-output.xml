33: 
34: # Health check
35: HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=10s \
36:   CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5001/health/live')" || exit 1
37: 
38: USER appuser
39: 
40: EXPOSE 5001
41: CMD ["gunicorn", "--workers", "2", "--threads", "8", "--worker-class", "gthread", \
42:      "--bind", "0.0.0.0:5001", \
43:      "--access-logfile", "-", "--timeout", "30", \
44:      "--worker-tmp-dir", "/dev/shm", "app:app"]
