<file path="applications-vm/applications/web-ui/nginx.conf">
 1: server {
 2:     listen 8080;
 3:     server_name _;
 4: 
 5:     # Use Docker embedded DNS — re-resolve on every request.
 6:     # Without this, nginx caches IPs at startup and breaks when
 7:     # upstream containers are rebuilt with new IPs.
 8:     resolver 127.0.0.11 valid=10s ipv6=off;
 9: 
10:     root /usr/share/nginx/html;
11:     index index.html;
12: 
13:     # Serve static files
14:     location / {
15:         try_files $uri $uri/ /index.html;
16:     }
17: 
18:     # Reverse proxy to API Gateway — avoids CORS issues
19:     # rewrite strips /api/ prefix before forwarding (same as proxy_pass with trailing /)
20:     location /api/ {
21:         set $upstream_api http://api-gateway:5000;
22:         rewrite ^/api/(.*) /$1 break;
23:         proxy_pass $upstream_api;
24:         proxy_set_header Host $host;
25:         proxy_set_header X-Real-IP $remote_addr;
26:         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
27:         proxy_read_timeout 60s;
28:     }
29: 
30:     # Reverse proxy to Traffic Generator API
31:     location /traffic/ {
32:         set $upstream_traffic http://traffic-gen:5003;
33:         rewrite ^/traffic/(.*) /$1 break;
34:         proxy_pass $upstream_traffic;
35:         proxy_set_header Host $host;
36:         proxy_set_header X-Real-IP $remote_addr;
37:         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
38:         proxy_read_timeout 60s;
39:     }
40: 
41:     # Reverse proxy to Notification Worker
42:     location /notifications/ {
43:         set $upstream_notif http://notification-worker:5004;
44:         rewrite ^/notifications/(.*) /$1 break;
45:         proxy_pass $upstream_notif;
46:         proxy_set_header Host $host;
47:         proxy_set_header X-Real-IP $remote_addr;
48:         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
49:         proxy_read_timeout 60s;
50:     }
51: 
52:     # Reverse proxy to Inventory Worker
53:     location /inventory/ {
54:         set $upstream_inv http://inventory-worker:5005;
55:         rewrite ^/inventory/(.*) /$1 break;
56:         proxy_pass $upstream_inv;
57:         proxy_set_header Host $host;
58:         proxy_set_header X-Real-IP $remote_addr;
59:         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
60:         proxy_read_timeout 60s;
61:     }
62: }
</file>

