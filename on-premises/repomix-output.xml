<file path="observability-vm/phase1-metrics/alertmanager/render.sh">
 1: #!/bin/bash
 2: # Render alertmanager.yml từ template + .env
 3: set -e
 4: SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
 5: ENV_FILE="$SCRIPT_DIR/../.env"
 6: # Load .env
 7: if [ -f "$ENV_FILE" ]; then
 8:     export $(grep -v '^#' "$ENV_FILE" | xargs)
 9: else
10:     echo "❌ File .env không tồn tại! Copy từ .env.example:"
11:     echo "   cp .env.example .env"
12:     exit 1
13: fi
14: # Render template → file thật
15: envsubst < "$SCRIPT_DIR/alertmanager.yml.tpl" > "$SCRIPT_DIR/alertmanager.yml"
16: echo "✅ Rendered alertmanager.yml (secrets injected from .env)"
</file>

<file path="observability-vm/phase1-metrics/blackbox/blackbox.yml">
 1: # ============================================================
 2: # Blackbox Exporter Configuration
 3: # ============================================================
 4: # Probe HTTP endpoints để kiểm tra service health.
 5: # Prometheus sử dụng module "http_2xx" để GET /health/live
 6: # và expect HTTP 2xx response.
 7: # ============================================================
 8: 
 9: modules:
10:   http_2xx:
11:     prober: http
12:     timeout: 5s
13:     http:
14:       method: GET
15:       valid_http_versions: ["HTTP/1.1", "HTTP/2.0"]
16:       valid_status_codes: [200]
17:       follow_redirects: false
18:       preferred_ip_protocol: "ip4"
</file>

