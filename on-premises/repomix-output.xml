<file path="applications-vm/applications/api-gateway/app.py">
  1: """
  2: ============================================================
  3: API Gateway — Phase 5 + Shared Refactor
  4: ============================================================
  5: API Gateway nhận HTTP requests, proxy tới backend services.
  6: 
  7: Endpoints:
  8:   - POST /order       → create order (via order-service)
  9:   - GET  /products    → list products (via order-service)
 10:   - GET  /orders      → list orders (via order-service)
 11:   - GET  /health      → readiness check (alias for /health/ready)
 12:   - GET  /health/live → liveness check
 13:   - GET  /health/ready → readiness check
 14: ============================================================
 15: """
 16: 
 17: import os
 18: import time
 19: import random
 20: import requests
 21: from flask import Flask, jsonify, request as flask_request
 22: 
 23: # ----------------------------------------------------------
 24: # Shared modules
 25: # ----------------------------------------------------------
 26: from shared.logging_config import setup_logging
 27: from shared.otel_setup import init_otel
 28: from shared.health import create_health_blueprint
 29: from shared.errors import problem_response
 30: 
 31: # ----------------------------------------------------------
 32: # Auto-instrumentation imports
 33: # ----------------------------------------------------------
 34: from opentelemetry.instrumentation.flask import FlaskInstrumentor
 35: from opentelemetry.instrumentation.requests import RequestsInstrumentor
 36: 
 37: # ----------------------------------------------------------
 38: # Initialize logging + OTel
 39: # ----------------------------------------------------------
 40: logger = setup_logging("api-gateway")
 41: tracer, meter = init_otel("api-gateway", "3.0.0")
 42: 
 43: # ============================================================
 44: # Custom Metrics
 45: # ============================================================
 46: request_counter = meter.create_counter(
 47:     name="api_gateway_requests_total",
 48:     description="Total HTTP requests received by API Gateway",
 49:     unit="1",
 50: )
 51: 
 52: request_duration = meter.create_histogram(
 53:     name="api_gateway_request_duration_seconds",
 54:     description="HTTP request duration in seconds",
 55:     unit="s",
 56: )
 57: 
 58: # ============================================================
 59: # Flask App
 60: # ============================================================
 61: app = Flask(__name__)
 62: FlaskInstrumentor().instrument_app(app)
 63: RequestsInstrumentor().instrument()
 64: 
 65: ORDER_SERVICE = os.getenv("ORDER_SERVICE_URL", "http://order-service:5001")
 66: 
 67: # --- Health checks ---
 68: health_bp = create_health_blueprint("api-gateway", checks={
 69:     "order-service": lambda: requests.get(
 70:         f"{ORDER_SERVICE}/health/live", timeout=2
 71:     ).raise_for_status(),
 72: })
 73: app.register_blueprint(health_bp)
 74: 
 75: 
 76: @app.route("/")
 77: def home():
 78:     return jsonify({"service": "api-gateway", "status": "ok",
 79:                     "endpoints": ["/order", "/products", "/orders", "/health"]})
 80: 
 81: 
 82: @app.route("/order", methods=["GET", "POST"])
 83: def create_order():
 84:     """Tạo đơn hàng → gọi Order Service"""
 85:     start_time = time.time()
 86:     status = "success"
 87: 
 88:     with tracer.start_as_current_span("process_order_request") as span:
 89:         # Parse request body for POST
 90:         if flask_request.method == "POST" and flask_request.is_json:
 91:             order_data = flask_request.get_json()
 92:             product_id = order_data.get("product_id", random.randint(1, 5))
 93:             quantity = order_data.get("quantity", random.randint(1, 3))
 94:         else:
 95:             product_id = random.randint(1, 5)
 96:             quantity = random.randint(1, 3)
 97: 
 98:         span.set_attribute("order.product_id", product_id)
 99:         span.set_attribute("order.quantity", quantity)
100:         span.set_attribute("http.user_agent",
101:                            flask_request.headers.get("User-Agent", "unknown"))
102: 
103:         # Validate input
104:         with tracer.start_as_current_span("validate_input") as val_span:
105:             time.sleep(random.uniform(0.005, 0.02))
106:             val_span.set_attribute("validation.product_id", product_id)
107:             val_span.set_attribute("validation.quantity", quantity)
108:             val_span.set_attribute("validation.passed", True)
109: 
110:         logger.info("Processing order request",
111:                      extra={"product_id": product_id, "quantity": quantity})
112: 
113:         # Call Order Service
114:         try:
115:             resp = requests.post(
116:                 f"{ORDER_SERVICE}/process",
117:                 json={"product_id": product_id, "quantity": quantity},
118:                 timeout=5,
119:             )
120:             data = resp.json()
121:             order_id = data.get("order_id", "unknown")
122:             span.set_attribute("order.id", order_id)
123:             span.set_attribute("order.status", data.get("status", "unknown"))
124: 
125:             logger.info("Order created",
126:                          extra={"order_id": order_id, "product_id": product_id,
127:                                 "status": data.get("status")})
128: 
129:             result = jsonify({"status": "success", "order": data})
130:             if resp.status_code != 200:
131:                 # Forward RFC 7807 from downstream if present
132:                 content_type = resp.headers.get("Content-Type", "")
133:                 if "problem+json" in content_type:
134:                     return resp.content, resp.status_code, {"Content-Type": content_type}
135:                 result = jsonify({
136:                     "status": "error",
137:                     "message": data.get("message", data.get("error", "Order failed")),
138:                     "order": data,
139:                 }), resp.status_code
140:                 status = "error"
141: 
142:         except requests.exceptions.Timeout:
143:             status = "error"
144:             span.set_attribute("error", True)
145:             span.set_attribute("error.message", "Order service timeout")
146:             logger.error("Order service timeout",
147:                           extra={"product_id": product_id, "timeout": 5})
148:             result = problem_response(
149:                 504, "Gateway Timeout",
150:                 "Order service did not respond within 5s",
151:                 instance="/order",
152:             )
153: 
154:         except Exception as e:
155:             status = "error"
156:             span.set_attribute("error", True)
157:             span.set_attribute("error.message", str(e))
158:             logger.error("Order creation failed",
159:                           extra={"error": str(e), "product_id": product_id})
160:             result = problem_response(
161:                 502, "Bad Gateway",
162:                 f"Order service unavailable: {e}",
163:                 instance="/order",
164:             )
165: 
166:     # Record metrics
167:     duration = time.time() - start_time
168:     request_counter.add(1, {"endpoint": "/order", "status": status})
169:     request_duration.record(duration, {"endpoint": "/order", "status": status})
170: 
171:     return result
172: 
173: 
174: @app.route("/products")
175: def list_products():
176:     """Proxy to order-service /products"""
177:     start_time = time.time()
178:     status = "success"
179: 
180:     with tracer.start_as_current_span("proxy_list_products") as span:
181:         try:
182:             resp = requests.get(f"{ORDER_SERVICE}/products", timeout=5)
183:             result = resp.json()
184:             span.set_attribute("products.count",
185:                                len(result.get("products", [])))
186:             span.set_attribute("products.source", result.get("source", "unknown"))
187: 
188:             logger.info("Products fetched",
189:                          extra={"count": len(result.get("products", [])),
190:                                 "source": result.get("source")})
191: 
192:         except Exception as e:
193:             status = "error"
194:             span.set_attribute("error", True)
195:             result = {"error": str(e)}
196:             logger.error("Failed to fetch products", extra={"error": str(e)})
197: 
198:     duration = time.time() - start_time
199:     request_counter.add(1, {"endpoint": "/products", "status": status})
200:     request_duration.record(duration, {"endpoint": "/products", "status": status})
201: 
202:     return jsonify(result)
203: 
204: 
205: @app.route("/orders")
206: def list_orders():
207:     """Proxy to order-service /orders"""
208:     start_time = time.time()
209:     status = "success"
210: 
211:     with tracer.start_as_current_span("proxy_list_orders") as span:
212:         try:
213:             limit = flask_request.args.get("limit", 20)
214:             resp = requests.get(f"{ORDER_SERVICE}/orders?limit={limit}", timeout=5)
215:             result = resp.json()
216:             span.set_attribute("orders.count", result.get("count", 0))
217: 
218:         except Exception as e:
219:             status = "error"
220:             span.set_attribute("error", True)
221:             result = {"error": str(e)}
222:             logger.error("Failed to fetch orders", extra={"error": str(e)})
223: 
224:     duration = time.time() - start_time
225:     request_counter.add(1, {"endpoint": "/orders", "status": status})
226:     request_duration.record(duration, {"endpoint": "/orders", "status": status})
227: 
228:     return jsonify(result)
229: 
230: 
231: if __name__ == "__main__":
232:     logger.info("API Gateway starting (dev mode)", extra={"port": 5000})
233:     logger.warning("Use gunicorn for production: gunicorn -w 4 -b 0.0.0.0:5000 app:app")
234:     app.run(host="0.0.0.0", port=5000)
</file>

