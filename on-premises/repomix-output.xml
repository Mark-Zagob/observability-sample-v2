 1: # ============================================================
 2: # Applications VM — Monitoring Agents
 3: # ============================================================
 4: # Chạy trên VM: 192.168.100.57
 5: # Các agent thu thập metrics/logs từ VM này
 6: # và gửi về Observability VM (192.168.100.55)
 7: #
 8: # Bao gồm:
 9: #   - Node Exporter: metrics hệ thống (CPU, RAM, disk, network)
10: #   - cAdvisor: metrics từng container (CPU, RAM, network)
11: #   - Alloy: thu thập Docker logs + host logs → push về Loki
12: # ============================================================
13: 
14: services:
15:   # ==========================================================
16:   # NODE EXPORTER — System Metrics
17:   # ==========================================================
18:   # Expose metrics hệ thống tại :9100
19:   # Prometheus trên Observability VM sẽ pull metrics từ đây
20:   # ==========================================================
21: 
22:   node-exporter:
23:     image: prom/node-exporter:v1.9.0
24:     container_name: node-exporter
25:     command:
26:       - "--path.rootfs=/host"
27:       - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
28:     volumes:
29:       - "/:/host:ro,rslave"
30:     ports:
31:       - "9100:9100"         # Expose ra ngoài để Prometheus scrape
32:     networks:
33:       - observability
34:     restart: unless-stopped
35:     pid: host
36: 
37:   # ==========================================================
38:   # cADVISOR — Container Metrics
39:   # ==========================================================
40:   # Expose metrics từng container tại :8080
