 1: # ============================================
 2: # Stage 1: Build — install dependencies
 3: # ============================================
 4: FROM python:3.12-slim-bookworm AS builder
 5: 
 6: WORKDIR /build
 7: COPY api-gateway/requirements.txt .
 8: RUN pip install --no-cache-dir --no-compile \
 9:     --prefix=/install -r requirements.txt
10: 
11: # ============================================
12: # Stage 2: Runtime — production image
13: # ============================================
14: FROM python:3.12-slim-bookworm
15: 
16: LABEL maintainer="observability-lab"
17: LABEL service="api-gateway"
18: 
19: # Security: non-root user
20: RUN groupadd -r appuser && useradd -r -g appuser -s /usr/sbin/nologin appuser
21: 
22: # Don't generate .pyc files (saves space + works with read-only fs)
23: ENV PYTHONDONTWRITEBYTECODE=1
24: ENV PYTHONUNBUFFERED=1
25: 
26: WORKDIR /app
27: 
28: # Copy ONLY installed packages from builder (no pip/setuptools/wheel)
29: COPY --from=builder /install /usr/local
30: 
31: # Copy application code
32: COPY shared/ ./shared/
33: COPY api-gateway/app.py .
34: 
35: # Health check
36: HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=10s \
37:   CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/health/live')" || exit 1
38: 
39: USER appuser
40: 
41: EXPOSE 5000
42: CMD ["gunicorn", "--workers", "2", "--threads", "8", "--worker-class", "gthread", \
43:      "--bind", "0.0.0.0:5000", \
44:      "--access-logfile", "-", "--timeout", "30", \
45:      "--worker-tmp-dir", "/dev/shm", "app:app"]
