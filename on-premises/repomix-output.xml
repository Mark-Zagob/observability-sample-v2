<file path="observability-vm/phase1-metrics/prometheus/alert_rules.yml">
  1: # ============================================================
  2: # Alert Rules - Phase 1
  3: # ============================================================
  4: # Alert rules sẽ được Prometheus evaluate theo evaluation_interval.
  5: # Khi condition đúng trong khoảng `for`, alert sẽ FIRING.
  6: # ============================================================
  7: 
  8: groups:
  9:   # ----------------------------------------------------------
 10:   # Infrastructure Alerts
 11:   # ----------------------------------------------------------
 12:   - name: infrastructure_alerts
 13:     interval: 30s
 14:     rules:
 15: 
 16:       # Target bị down
 17:       - alert: TargetDown
 18:         expr: up == 0
 19:         for: 1m
 20:         labels:
 21:           severity: critical
 22:         annotations:
 23:           summary: "Target {{ $labels.instance }} is down"
 24:           description: "{{ $labels.job }} / {{ $labels.instance }} has been down for more than 1 minute."
 25: 
 26:       # Service health check failed (Blackbox Exporter probe)
 27:       - alert: ServiceHealthCheckFailed
 28:         expr: probe_success{job="blackbox"} == 0
 29:         for: 1m
 30:         labels:
 31:           severity: critical
 32:         annotations:
 33:           summary: "Health check failed: {{ $labels.instance }}"
 34:           description: "Blackbox probe to {{ $labels.instance }} has been failing for more than 1 minute. Service may be down or unreachable."
 35: 
 36:       # CPU usage > 80%
 37:       - alert: HighCpuUsage
 38:         expr: |
 39:           100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
 40:         for: 5m
 41:         labels:
 42:           severity: warning
 43:         annotations:
 44:           summary: "High CPU usage on {{ $labels.instance }}"
 45:           description: "CPU usage is at {{ $value }}%"
 46: 
 47:       # Memory usage > 85%
 48:       - alert: HighMemoryUsage
 49:         expr: |
 50:           (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 85
 51:         for: 5m
 52:         labels:
 53:           severity: warning
 54:         annotations:
 55:           summary: "High memory usage on {{ $labels.instance }}"
 56:           description: "Memory usage is at {{ $value }}%"
 57: 
 58:       # Disk usage > 80%
 59:       - alert: HighDiskUsage
 60:         expr: |
 61:           (1 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"})) * 100 > 80
 62:         for: 5m
 63:         labels:
 64:           severity: warning
 65:         annotations:
 66:           summary: "High disk usage on {{ $labels.instance }}"
 67:           description: "Disk {{ $labels.mountpoint }} is at {{ $value }}%"
 68: 
 69:       # ----------------------------------------------------------
 70:       # Predictive Alerts — dự đoán trước khi xảy ra
 71:       # ----------------------------------------------------------
 72:       # predict_linear(metric[lookback], seconds) dự đoán giá trị
 73:       # metric sau X giây dựa trên xu hướng trong lookback window.
 74:       #
 75:       # Ví dụ: predict_linear(disk_avail[1d], 4*3600) < 0
 76:       # = "Nếu disk giảm cùng tốc độ 1 ngày qua, sẽ hết trong 4h"
 77:       # ----------------------------------------------------------
 78: 
 79:       # Disk sẽ đầy trong 4 giờ tới
 80:       - alert: DiskWillFillIn4Hours
 81:         expr: |
 82:           predict_linear(
 83:             node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"}[1d], 4 * 3600
 84:           ) < 0
 85:         for: 30m
 86:         labels:
 87:           severity: warning
 88:         annotations:
 89:           summary: "Disk {{ $labels.mountpoint }} predicted to fill in 4h"
 90:           description: "Based on the trend of the last 24h, disk {{ $labels.mountpoint }} on {{ $labels.instance }} will run out of space within 4 hours."
 91: 
 92:       # Memory sẽ hết trong 2 giờ tới
 93:       - alert: MemoryWillExhaustIn2Hours
 94:         expr: |
 95:           predict_linear(
 96:             node_memory_MemAvailable_bytes[1h], 2 * 3600
 97:           ) < 0
 98:         for: 15m
 99:         labels:
100:           severity: warning
101:         annotations:
102:           summary: "Memory predicted to exhaust in 2h on {{ $labels.instance }}"
103:           description: "Based on the trend of the last 1h, available memory will be exhausted within 2 hours."
104: 
105:   # ----------------------------------------------------------
106:   # Watchdog (Dead Man's Switch)
107:   # ----------------------------------------------------------
108:   # Alert luôn firing 24/7. Nếu nó RESOLVED → alerting pipeline
109:   # bị hỏng (Prometheus/Alertmanager/network issue).
110:   #
111:   # Production tip: Kết hợp với PagerDuty Dead Man's Snitch
112:   # hoặc Healthchecks.io để monitor pipeline từ bên ngoài.
113:   # ----------------------------------------------------------
114:   - name: watchdog
115:     rules:
116:       - alert: Watchdog
117:         expr: vector(1)
118:         labels:
119:           severity: none
120:         annotations:
121:           summary: "Watchdog — alerting pipeline is healthy"
122:           description: "This alert always fires. If you stop receiving it, the alerting pipeline is broken."
123: 
124:   # ==========================================================
125:   # SLI Recording Rules (Phase 6)
126:   # ==========================================================
127:   # Multi-Window SLI Recording Rules
128:   # Naming convention: sli:<signal>:<aggregation>
129:   #
130:   # Windows:
131:   #   - rate5m   → fast-burn short window
132:   #   - rate30m  → slow-burn short window
133:   #   - rate1h   → fast-burn long window
134:   #   - rate6h   → slow-burn long window
135:   # ==========================================================
136:   - name: sli_recording_rules
137:     interval: 30s
138:     rules:
139: 
140:       # --- Availability SLI (all windows) ---
141:       - record: sli:api_gateway_availability:rate5m
142:         expr: |
143:           (
144:             sum(rate(api_gateway_requests_total{status="success"}[5m]))
145:             /
146:             sum(rate(api_gateway_requests_total[5m]))
147:           ) or vector(1)
148: 
149:       - record: sli:api_gateway_availability:rate30m
150:         expr: |
151:           (
152:             sum(rate(api_gateway_requests_total{status="success"}[30m]))
153:             /
154:             sum(rate(api_gateway_requests_total[30m]))
155:           ) or vector(1)
156: 
157:       - record: sli:api_gateway_availability:rate1h
158:         expr: |
159:           (
160:             sum(rate(api_gateway_requests_total{status="success"}[1h]))
161:             /
162:             sum(rate(api_gateway_requests_total[1h]))
163:           ) or vector(1)
164: 
165:       - record: sli:api_gateway_availability:rate6h
166:         expr: |
167:           (
168:             sum(rate(api_gateway_requests_total{status="success"}[6h]))
169:             /
170:             sum(rate(api_gateway_requests_total[6h]))
171:           ) or vector(1)
172: 
173:       # --- Latency SLI (P95 value for gauge display) ---
174:       - record: sli:api_gateway_latency_p95:rate5m
175:         expr: |
176:           histogram_quantile(0.95,
177:             sum(rate(api_gateway_request_duration_seconds_bucket[5m])) by (le)
178:           )
179: 
180:       # --- Latency SLO Compliance (% requests < 500ms) ---
181:       # Unlike availability (success/total), latency compliance =
182:       # requests_under_threshold / total_requests.
183:       # The 0.5 bucket = requests completing in ≤ 500ms.
184:       - record: sli:api_gateway_latency_compliance:rate5m
185:         expr: |
186:           (
187:             sum(rate(api_gateway_request_duration_seconds_bucket{le="0.5"}[5m]))
188:             /
189:             sum(rate(api_gateway_request_duration_seconds_count[5m]))
190:           ) or vector(1)
191: 
192:       - record: sli:api_gateway_latency_compliance:rate30m
193:         expr: |
194:           (
195:             sum(rate(api_gateway_request_duration_seconds_bucket{le="0.5"}[30m]))
196:             /
197:             sum(rate(api_gateway_request_duration_seconds_count[30m]))
198:           ) or vector(1)
199: 
200:       - record: sli:api_gateway_latency_compliance:rate1h
201:         expr: |
202:           (
203:             sum(rate(api_gateway_request_duration_seconds_bucket{le="0.5"}[1h]))
204:             /
205:             sum(rate(api_gateway_request_duration_seconds_count[1h]))
206:           ) or vector(1)
207: 
208:       - record: sli:api_gateway_latency_compliance:rate6h
209:         expr: |
210:           (
211:             sum(rate(api_gateway_request_duration_seconds_bucket{le="0.5"}[6h]))
212:             /
213:             sum(rate(api_gateway_request_duration_seconds_count[6h]))
214:           ) or vector(1)
215: 
216:       # --- Payment Success SLI (all windows) ---
217:       - record: sli:payment_success_rate:rate5m
218:         expr: |
219:           (
220:             sum(rate(payments_total{status="completed"}[5m]))
221:             /
222:             sum(rate(payments_total[5m]))
223:           ) or vector(1)
224: 
225:       - record: sli:payment_success_rate:rate30m
226:         expr: |
227:           (
228:             sum(rate(payments_total{status="completed"}[30m]))
229:             /
230:             sum(rate(payments_total[30m]))
231:           ) or vector(1)
232: 
233:       - record: sli:payment_success_rate:rate1h
234:         expr: |
235:           (
236:             sum(rate(payments_total{status="completed"}[1h]))
237:             /
238:             sum(rate(payments_total[1h]))
239:           ) or vector(1)
240: 
241:       - record: sli:payment_success_rate:rate6h
242:         expr: |
243:           (
244:             sum(rate(payments_total{status="completed"}[6h]))
245:             /
246:             sum(rate(payments_total[6h]))
247:           ) or vector(1)
248: 
249:   # ==========================================================
250:   # SLO Burn Rate Alerts — Multi-Window Multi-Burn-Rate (MWMBR)
251:   # ==========================================================
252:   # Google SRE pattern:
253:   #   Fast burn:  14.4x rate → 2% budget consumed in 1h
254:   #               Windows: 5m (short) AND 1h (long)
255:   #   Slow burn:  3x rate   → 10% budget consumed in 6h
256:   #               Windows: 30m (short) AND 6h (long)
257:   #
258:   # SLO targets:
259:   #   - API Gateway Availability: 99.5%  (error budget = 0.5%)
260:   #   - Payment Success Rate:     99.0%  (error budget = 1.0%)
261:   #   - API Gateway P95 Latency:  < 500ms
262:   # ==========================================================
263:   - name: slo_burn_rate_alerts
264:     interval: 30s
265:     rules:
266: 
267:       # ---- API Gateway: Fast Burn (page) ----
268:       # 14.4x burn rate in both 5m and 1h windows
269:       # Traffic guard: uses span metrics (not custom OTel counter) to avoid phantom alerts
270:       # from stale api_gateway_requests_total rate when traffic stops
271:       - alert: APIGatewayFastBurn
272:         expr: |
273:           (
274:             (1 - sli:api_gateway_availability:rate5m) / (1 - 0.995) > 14.4
275:             and
276:             (1 - sli:api_gateway_availability:rate1h) / (1 - 0.995) > 14.4
277:           and
278:             sum(rate(traces_spanmetrics_calls_total{service_name="api-gateway"}[5m])) > 0.1
279:           )
280:         for: 2m
281:         labels:
282:           severity: critical
283:           slo: api_gateway_availability
284:           burn_window: fast
285:         annotations:
286:           summary: "🔥 API Gateway fast burn — 2% error budget consumed in 1h"
287:           description: "Error budget is being consumed 14.4x faster than sustainable. Both 5m and 1h windows confirm the issue."
288: 
289:       # ---- API Gateway: Slow Burn (ticket) ----
290:       # 3x burn rate in both 30m and 6h windows
291:       # Traffic guard: uses span metrics to avoid phantom alerts from stale OTel counters
292:       - alert: APIGatewaySlowBurn
293:         expr: |
294:           (
295:             (1 - sli:api_gateway_availability:rate30m) / (1 - 0.995) > 3
296:             and
297:             (1 - sli:api_gateway_availability:rate6h) / (1 - 0.995) > 3
298:           and
299:             sum(rate(traces_spanmetrics_calls_total{service_name="api-gateway"}[5m])) > 0.1
300:           )
301:         for: 15m
302:         labels:
303:           severity: warning
304:           slo: api_gateway_availability
305:           burn_window: slow
306:         annotations:
307:           summary: "⚠️ API Gateway slow burn — 10% error budget consumed in 6h"
308:           description: "Error budget is being consumed 3x faster than sustainable. Both 30m and 6h windows confirm a sustained degradation."
309: 
310:       # ---- Payment: Fast Burn (page) ----
311:       # Traffic guard: requires > 0.1 req/s to avoid phantom alerts when traffic stops
312:       - alert: PaymentFastBurn
313:         expr: |
314:           (
315:             (1 - sli:payment_success_rate:rate5m) / (1 - 0.99) > 14.4
316:             and
317:             (1 - sli:payment_success_rate:rate1h) / (1 - 0.99) > 14.4
318:           and
319:             sum(rate(traces_spanmetrics_calls_total{service_name="payment-service"}[5m])) > 0.1
320:           )
321:         for: 2m
322:         labels:
323:           severity: critical
324:           slo: payment_success
325:           burn_window: fast
326:         annotations:
327:           summary: "🔥 Payment fast burn — 2% error budget consumed in 1h"
328:           description: "Payment error budget is being consumed 14.4x faster than sustainable."
329: 
330:       # ---- Payment: Slow Burn (ticket) ----
331:       # Traffic guard: requires > 0.1 req/s to avoid phantom alerts when traffic stops
332:       - alert: PaymentSlowBurn
333:         expr: |
334:           (
335:             (1 - sli:payment_success_rate:rate30m) / (1 - 0.99) > 3
336:             and
337:             (1 - sli:payment_success_rate:rate6h) / (1 - 0.99) > 3
338:           and
339:             sum(rate(traces_spanmetrics_calls_total{service_name="payment-service"}[5m])) > 0.1
340:           )
341:         for: 15m
342:         labels:
343:           severity: warning
344:           slo: payment_success
345:           burn_window: slow
346:         annotations:
347:           summary: "⚠️ Payment slow burn — 10% error budget consumed in 6h"
348:           description: "Payment error budget is being consumed 3x faster than sustainable."
349: 
350:       # ---- Latency: Fast Burn (page) ----
351:       # SLO: 95% requests < 500ms (error budget = 5%)
352:       # Traffic guard: uses span metrics to avoid phantom alerts from stale OTel counters
353:       - alert: APIGatewayLatencyFastBurn
354:         expr: |
355:           (
356:             (1 - sli:api_gateway_latency_compliance:rate5m) / (1 - 0.95) > 14.4
357:             and
358:             (1 - sli:api_gateway_latency_compliance:rate1h) / (1 - 0.95) > 14.4
359:           and
360:             sum(rate(traces_spanmetrics_calls_total{service_name="api-gateway"}[5m])) > 0.1
361:           )
362:         for: 2m
363:         labels:
364:           severity: critical
365:           slo: api_gateway_latency
366:           burn_window: fast
367:         annotations:
368:           summary: "🔥 API Gateway latency fast burn — 2% latency budget consumed in 1h"
369:           description: "Latency error budget is being consumed 14.4x faster than sustainable. Most requests are exceeding 500ms."
370: 
371:       # ---- Latency: Slow Burn (ticket) ----
372:       # Traffic guard: uses span metrics to avoid phantom alerts from stale OTel counters
373:       - alert: APIGatewayLatencySlowBurn
374:         expr: |
375:           (
376:             (1 - sli:api_gateway_latency_compliance:rate30m) / (1 - 0.95) > 3
377:             and
378:             (1 - sli:api_gateway_latency_compliance:rate6h) / (1 - 0.95) > 3
379:           and
380:             sum(rate(traces_spanmetrics_calls_total{service_name="api-gateway"}[5m])) > 0.1
381:           )
382:         for: 15m
383:         labels:
384:           severity: warning
385:           slo: api_gateway_latency
386:           burn_window: slow
387:         annotations:
388:           summary: "⚠️ API Gateway latency slow burn — latency degradation over 6h"
389:           description: "Latency error budget is being consumed 3x faster than sustainable. Sustained performance degradation detected."
</file>

<file path="observability-vm/phase1-metrics/prometheus/kafka_alert_rules.yml">
  1: # ============================================================
  2: # Kafka Alert Rules
  3: # ============================================================
  4: # Alert rules cho Kafka cluster, consumer groups, và workers.
  5: # Metrics từ kafka-exporter + application custom metrics.
  6: # ============================================================
  7: 
  8: groups:
  9:   # ----------------------------------------------------------
 10:   # Kafka Cluster Health
 11:   # ----------------------------------------------------------
 12:   - name: kafka_cluster_alerts
 13:     interval: 30s
 14:     rules:
 15: 
 16:       # Kafka exporter unreachable
 17:       - alert: KafkaExporterDown
 18:         expr: up{job="kafka-exporter"} == 0
 19:         for: 2m
 20:         labels:
 21:           severity: critical
 22:         annotations:
 23:           summary: "Kafka Exporter is down"
 24:           description: "Cannot scrape kafka-exporter metrics. Kafka monitoring is blind."
 25: 
 26:       # Topic has under-replicated partitions
 27:       - alert: KafkaTopicUnderReplicated
 28:         expr: kafka_topic_partition_under_replicated_partition > 0
 29:         for: 5m
 30:         labels:
 31:           severity: warning
 32:         annotations:
 33:           summary: "Under-replicated partitions on topic {{ $labels.topic }}"
 34:           description: "Partition {{ $labels.partition }} of topic {{ $labels.topic }} is under-replicated. Data durability at risk."
 35: 
 36:   # ----------------------------------------------------------
 37:   # Consumer Group Monitoring
 38:   # ----------------------------------------------------------
 39:   - name: kafka_consumer_alerts
 40:     interval: 30s
 41:     rules:
 42: 
 43:       # Consumer lag > 100 for 5 minutes
 44:       - alert: KafkaConsumerLagHigh
 45:         expr: |
 46:           sum by(consumergroup, topic) (
 47:             kafka_consumergroup_lag
 48:           ) > 100
 49:         for: 5m
 50:         labels:
 51:           severity: warning
 52:         annotations:
 53:           summary: "High consumer lag for {{ $labels.consumergroup }}"
 54:           description: "Consumer group {{ $labels.consumergroup }} has lag of {{ $value }} on topic {{ $labels.topic }}. Events are piling up."
 55: 
 56:       # Consumer lag > 1000 — critical backlog
 57:       - alert: KafkaConsumerLagCritical
 58:         expr: |
 59:           sum by(consumergroup, topic) (
 60:             kafka_consumergroup_lag
 61:           ) > 1000
 62:         for: 3m
 63:         labels:
 64:           severity: critical
 65:         annotations:
 66:           summary: "Critical consumer lag for {{ $labels.consumergroup }}"
 67:           description: "Consumer group {{ $labels.consumergroup }} has lag of {{ $value }}. Consumers may be down or overwhelmed."
 68: 
 69:       # Consumer group has no active members (no consumers connected)
 70:       - alert: KafkaConsumerGroupDown
 71:         expr: |
 72:           kafka_consumergroup_members == 0
 73:         for: 5m
 74:         labels:
 75:           severity: critical
 76:         annotations:
 77:           summary: "Consumer group {{ $labels.consumergroup }} has no members"
 78:           description: "No consumers are connected to group {{ $labels.consumergroup }}. Events are not being processed."
 79: 
 80:   # ----------------------------------------------------------
 81:   # Worker Service Alerts
 82:   # ----------------------------------------------------------
 83:   - name: kafka_worker_alerts
 84:     interval: 30s
 85:     rules:
 86: 
 87:       # Notification worker error rate high
 88:       - alert: NotificationWorkerHighErrorRate
 89:         expr: |
 90:           rate(inventory_errors_total[5m]) > 0.1
 91:           or
 92:           rate(kafka_events_consumed_total{service_name="notification-worker"}[5m]) == 0
 93:           and
 94:           kafka_consumergroup_lag{consumergroup="notification-workers"} > 0
 95:         for: 5m
 96:         labels:
 97:           severity: warning
 98:           service: notification-worker
 99:         annotations:
100:           summary: "Notification worker is failing or stalled"
101:           description: "The notification worker is either producing errors or has stopped consuming despite pending messages."
102: 
103:       # Inventory worker error rate high
104:       - alert: InventoryWorkerHighErrorRate
105:         expr: |
106:           rate(inventory_errors_total[5m]) > 0.1
107:         for: 5m
108:         labels:
109:           severity: warning
110:           service: inventory-worker
111:         annotations:
112:           summary: "Inventory worker has high error rate"
113:           description: "The inventory worker is producing errors at {{ $value }}/s."
</file>

<file path="observability-vm/phase1-metrics/prometheus/prometheus.yml">
  1: # ============================================================
  2: # Prometheus Configuration — Observability VM
  3: # ============================================================
  4: # Scrape targets từ 2 VM:
  5: #   - Local (observability VM): prometheus, alertmanager, otel-collector
  6: #   - Remote (app VM 192.168.100.57): node-exporter, cadvisor
  7: # ============================================================
  8: 
  9: global:
 10:   scrape_interval: 15s
 11:   evaluation_interval: 15s
 12:   scrape_timeout: 10s
 13: 
 14: # ============================================================
 15: # Alerting - Gửi alerts tới Alertmanager
 16: # ============================================================
 17: alerting:
 18:   alertmanagers:
 19:     - static_configs:
 20:         - targets: ["alertmanager:9093"]
 21: 
 22: # ============================================================
 23: # Alert Rules
 24: # ============================================================
 25: rule_files:
 26:   - "alert_rules.yml"
 27:   - "tracing_alert_rules.yml"
 28:   - "recording_rules.yml"
 29:   - "kafka_alert_rules.yml"
 30: 
 31: # ============================================================
 32: # Scrape Configs
 33: # ============================================================
 34: scrape_configs:
 35: 
 36:   # ==========================================================
 37:   # LOCAL TARGETS (Observability VM — 192.168.100.55)
 38:   # ==========================================================
 39: 
 40:   # ----------------------------------------------------------
 41:   # 1. Prometheus tự monitor
 42:   # ----------------------------------------------------------
 43:   - job_name: "prometheus"
 44:     static_configs:
 45:       - targets: ["localhost:9090"]
 46:         labels:
 47:           environment: "lab"
 48:           vm: "observability"
 49: 
 50:   # ----------------------------------------------------------
 51:   # 2. Node Exporter — Observability VM
 52:   # ----------------------------------------------------------
 53:   - job_name: "node-exporter"
 54:     static_configs:
 55:       - targets: ["node-exporter:9100"]
 56:         labels:
 57:           environment: "lab"
 58:           type: "infrastructure"
 59:           vm: "observability"
 60: 
 61:   # ----------------------------------------------------------
 62:   # 3. cAdvisor — Observability VM containers
 63:   # ----------------------------------------------------------
 64:   - job_name: "cadvisor"
 65:     static_configs:
 66:       - targets: ["cadvisor:8080"]
 67:         labels:
 68:           environment: "lab"
 69:           type: "container"
 70:           vm: "observability"
 71: 
 72:   # ----------------------------------------------------------
 73:   # 4. Alertmanager
 74:   # ----------------------------------------------------------
 75:   - job_name: "alertmanager"
 76:     static_configs:
 77:       - targets: ["alertmanager:9093"]
 78:         labels:
 79:           environment: "lab"
 80:           vm: "observability"
 81: 
 82:   # ----------------------------------------------------------
 83:   # 5. Application Metrics (via OTel Collector)
 84:   # ----------------------------------------------------------
 85:   - job_name: "app-metrics"
