<file path="observability-vm/scripts/annotate.sh">
 1: #!/bin/bash
 2: # ============================================================
 3: # Annotate — Tạo deploy marker trên Grafana mà không restart
 4: # ============================================================
 5: # Usage:
 6: #   ./annotate.sh "Release v2.0"
 7: #   ./annotate.sh "Hotfix payment timeout" payment
 8: #   ./annotate.sh "DB migration started" database warning
 9: # ============================================================
10: 
11: GRAFANA_URL="${GRAFANA_URL:-http://localhost:3000}"
12: GRAFANA_USER="${GRAFANA_USER:-admin}"
13: GRAFANA_PASS="${GRAFANA_PASS:-admin123}"
14: 
15: MESSAGE="${1:-Manual annotation}"
16: TAG="${2:-deploy}"
17: EXTRA_TAG="${3:-}"
18: 
19: TAGS="\"${TAG}\""
20: [[ -n "$EXTRA_TAG" ]] && TAGS="\"${TAG}\", \"${EXTRA_TAG}\""
21: 
22: TIMESTAMP_MS=$(($(date +%s) * 1000))
23: 
24: RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" \
25:   -X POST "${GRAFANA_URL}/api/annotations" \
26:   -H "Content-Type: application/json" \
27:   -u "${GRAFANA_USER}:${GRAFANA_PASS}" \
28:   -d "{
29:     \"time\": ${TIMESTAMP_MS},
30:     \"tags\": [${TAGS}],
31:     \"text\": \"📌 ${MESSAGE}\"
32:   }")
33: 
34: if [[ "$RESPONSE" == "200" ]]; then
35:   echo "✅ Annotation created: ${MESSAGE}"
36: else
37:   echo "❌ Failed (HTTP ${RESPONSE}). Is Grafana running?"
38: fi
</file>

<file path="observability-vm/scripts/deploy.sh">
  1: #!/bin/bash
  2: # ============================================================
  3: # Deploy Script — Restart services + tạo Grafana annotation
  4: # ============================================================
  5: # Usage:
  6: #   ./deploy.sh phase1          → Restart phase1 + annotation
  7: #   ./deploy.sh phase3          → Restart phase3 + annotation
  8: #   ./deploy.sh all             → Restart tất cả phases
  9: #   ./deploy.sh phase1 "Fix alerting config"  → Custom message
 10: # ============================================================
 11: 
 12: set -euo pipefail
 13: 
 14: GRAFANA_URL="${GRAFANA_URL:-http://localhost:3000}"
 15: GRAFANA_USER="${GRAFANA_USER:-admin}"
 16: GRAFANA_PASS="${GRAFANA_PASS:-admin123}"
 17: BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
 18: 
 19: # Colors
 20: GREEN='\033[0;32m'
 21: YELLOW='\033[1;33m'
 22: BLUE='\033[0;34m'
 23: NC='\033[0m'
 24: 
 25: # ============================================================
 26: # Gửi annotation tới Grafana
 27: # ============================================================
 28: create_annotation() {
 29:   local phase="$1"
 30:   local message="${2:-Deploy $phase}"
 31:   local timestamp_ms=$(($(date +%s) * 1000))
 32: 
 33:   echo -e "${BLUE}📌 Creating Grafana annotation...${NC}"
 34: 
 35:   local response
 36:   response=$(curl -s -w "\n%{http_code}" \
 37:     -X POST "${GRAFANA_URL}/api/annotations" \
 38:     -H "Content-Type: application/json" \
 39:     -u "${GRAFANA_USER}:${GRAFANA_PASS}" \
 40:     -d "{
 41:       \"time\": ${timestamp_ms},
 42:       \"tags\": [\"deploy\", \"${phase}\"],
 43:       \"text\": \"🚀 ${message}\"
 44:     }" 2>/dev/null) || true
 45: 
 46:   local http_code
 47:   http_code=$(echo "$response" | tail -1)
 48: 
 49:   if [[ "$http_code" == "200" ]]; then
 50:     echo -e "${GREEN}✅ Annotation created: ${message}${NC}"
 51:   else
 52:     echo -e "${YELLOW}⚠️  Could not create annotation (Grafana may not be ready)${NC}"
 53:   fi
 54: }
 55: 
 56: # ============================================================
 57: # Restart phase
 58: # ============================================================
 59: restart_phase() {
 60:   local phase="$1"
 61:   local dir=""
 62: 
 63:   case "$phase" in
 64:     phase1|metrics)
 65:       dir="$BASE_DIR/../phase1-metrics"
 66:       phase="phase1-metrics"
 67:       ;;
 68:     phase2|logging)
 69:       dir="$BASE_DIR/../phase2-logging"
 70:       phase="phase2-logging"
 71:       ;;
 72:     phase3|tracing)
 73:       dir="$BASE_DIR/../phase3-tracing"
 74:       phase="phase3-tracing"
 75:       ;;
 76:     storage|minio)
 77:       dir="$BASE_DIR/../storage"
 78:       phase="storage"
 79:       ;;
 80:     all)
 81:       restart_phase storage
 82:       restart_phase phase1
 83:       restart_phase phase2
 84:       restart_phase phase3
 85:       return
 86:       ;;
 87:     *)
 88:       echo "Unknown phase: $phase"
 89:       echo "Usage: $0 {phase1|phase2|phase3|storage|all} [message]"
 90:       exit 1
 91:       ;;
 92:   esac
 93: 
 94:   echo -e "${GREEN}🔄 Restarting ${phase}...${NC}"
 95:   docker compose -f "$dir/docker-compose.yml" down
 96:   docker compose -f "$dir/docker-compose.yml" up -d
 97:   echo -e "${GREEN}✅ ${phase} is up${NC}"
 98: }
 99: 
100: # ============================================================
101: # Main
102: # ============================================================
103: if [[ $# -lt 1 ]]; then
104:   echo "Usage: $0 {phase1|phase2|phase3|storage|all} [message]"
105:   exit 1
106: fi
107: 
108: PHASE="$1"
109: MESSAGE="${2:-Deploy ${PHASE}}"
110: 
111: restart_phase "$PHASE"
112: 
113: # Đợi Grafana ready (chỉ khi restart phase1 hoặc all)
114: if [[ "$PHASE" == "phase1" || "$PHASE" == "metrics" || "$PHASE" == "all" ]]; then
115:   echo -e "${YELLOW}⏳ Waiting for Grafana to be ready...${NC}"
116:   for i in $(seq 1 30); do
117:     if curl -s "${GRAFANA_URL}/api/health" | grep -q "ok" 2>/dev/null; then
118:       break
119:     fi
120:     sleep 2
121:   done
122: fi
123: 
124: create_annotation "$PHASE" "$MESSAGE"
125: 
126: echo ""
127: echo -e "${GREEN}🎉 Done! Check Grafana dashboards for the deploy marker.${NC}"
</file>

