453: function updateTrafficUI(running, data) {
454:     const badge = document.getElementById('lt-status-badge');
455:     const statusText = document.getElementById('lt-status-text');
456:     const startBtn = document.getElementById('btn-lt-start');
457:     const stopBtn  = document.getElementById('btn-lt-stop');
458:     const scenarioSelect = document.getElementById('lt-scenario');
459:     const rateSlider = document.getElementById('lt-rate');
460:     const durationSlider = document.getElementById('lt-duration');
461:     const progressWrap = document.getElementById('lt-progress-wrap');
462: 
463:     if (running) {
464:         badge.className = 'lt-status-badge running';
465:         statusText.textContent = 'Running';
466:         startBtn.disabled = true;
467:         startBtn.innerHTML = '<span>⏳</span> Running...';
468:         stopBtn.disabled = false;
469:         scenarioSelect.disabled = true;
470:         rateSlider.disabled = true;
471:         durationSlider.disabled = true;
472:         progressWrap.style.display = 'flex';
473: 
474:         if (data) {
475:             // Update stats
476:             document.getElementById('lt-stat-total').textContent = data.stats.total;
477:             document.getElementById('lt-stat-success').textContent = data.stats.success;
478:             document.getElementById('lt-stat-errors').textContent = data.stats.errors;
479:             document.getElementById('lt-stat-elapsed').textContent = data.stats.elapsed + 's';
480: 
481:             // Update progress
482:             const pct = Math.min(100, ((data.stats.elapsed / data.duration) * 100));
483:             document.getElementById('lt-progress-fill').style.width = pct + '%';
484:             document.getElementById('lt-progress-text').textContent = Math.round(pct) + '%';
485: 
486:             // Show current config
487:             scenarioSelect.value = data.scenario;
488:             rateSlider.value = data.rate;
489:             document.getElementById('lt-rate-value').textContent = data.rate;
490:             durationSlider.value = data.duration;
491:             document.getElementById('lt-duration-value').textContent = data.duration + 's';
492:         }
493: 
494:         // Start polling if not already
495:         if (!trafficPollingInterval) {
496:             trafficPollingInterval = setInterval(loadTrafficStatus, 2000);
497:         }
498:     } else {
499:         badge.className = 'lt-status-badge idle';
500:         statusText.textContent = 'Idle';
501:         startBtn.disabled = false;
502:         startBtn.innerHTML = '<span>▶</span> Start Traffic';
503:         stopBtn.disabled = true;
504:         scenarioSelect.disabled = false;
505:         rateSlider.disabled = false;
506:         durationSlider.disabled = false;
507: 
508:         // Stop polling
509:         if (trafficPollingInterval) {
510:             clearInterval(trafficPollingInterval);
511:             trafficPollingInterval = null;
512:         }
513: 
514:         // Keep last stats visible, hide progress if no data
515:         if (data && data.stats.total === 0) {
516:             progressWrap.style.display = 'none';
517:         }
518:     }
519: }
