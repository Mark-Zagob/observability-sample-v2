1053: ### Test (inspect internals)
1054: ```bash
1055: # Xem WAL directory TRƯỚC khi start lại
1056: docker exec prometheus ls -la /prometheus/wal/ 2>/dev/null || echo "Container stopped"
1057: 
1058: # Start lại → Prometheus replay WAL
1059: docker start prometheus
1060: 
1061: # Xem logs — tìm WAL replay time
1062: docker logs prometheus --tail 30 2>&1 | grep -i "wal\|replay\|ready"
1063: 
