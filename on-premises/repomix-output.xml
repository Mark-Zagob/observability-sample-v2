<file path="observability-vm/phase1-metrics/grafana/provisioning/dashboards/dashboards.yml">
# ============================================================
# Grafana Dashboard Provisioning Config
# ============================================================
# Grafana sẽ tự tạo folders dựa trên cấu trúc thư mục:
#   dashboards/Infrastructure/*.json → folder "Infrastructure"
#   dashboards/Logging/*.json        → folder "Logging"
#   dashboards/Tracing/*.json        → folder "Tracing"
# ============================================================

apiVersion: 1

providers:
  - name: "default"
    orgId: 1
    type: file
    disableDeletion: false
    editable: true                     # Cho phép chỉnh sửa trên UI
    updateIntervalSeconds: 30          # Kiểm tra file thay đổi mỗi 30s
    options:
      path: /var/lib/grafana/dashboards
      foldersFromFilesStructure: true  # Tự tạo folder từ subfolder names
</file>

<file path="observability-vm/phase1-metrics/grafana/provisioning/datasources/loki.yml">
# ============================================================
# Grafana Datasource - Loki (Phase 2 + Phase 6 correlation)
# ============================================================
# derivedFields: extract trace_id từ JSON log → link sang Tempo
# ============================================================

apiVersion: 1

datasources:
  - name: Loki
    type: loki
    uid: loki-datasource
    access: proxy
    url: http://loki:3100
    isDefault: false
    editable: true
    jsonData:
      maxLines: 1000
      derivedFields:
        # Extract trace_id từ structured JSON log → tạo link sang Tempo
        - datasourceUid: tempo-datasource
          matcherRegex: '"trace_id":\s*"([a-f0-9]+)"'
          matcherType: regex
          name: TraceID
          url: "$${__value.raw}"
</file>

<file path="observability-vm/phase1-metrics/grafana/provisioning/datasources/prometheus.yml">
# ============================================================
# Grafana Datasource Provisioning
# ============================================================
# File này tự động cấu hình Prometheus làm datasource
# khi Grafana khởi động lần đầu.
# ============================================================

apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: PBFA97CFB590B2093         # UID cố định, dashboard JSON reference tới
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: true
    jsonData:
      timeInterval: "15s"          # Phải khớp với scrape_interval
      httpMethod: POST
      exemplarTraceIdDestinations:
        - name: trace_id
          datasourceUid: tempo-datasource
          urlDisplayLabel: "View Trace"
</file>

<file path="observability-vm/phase1-metrics/grafana/provisioning/datasources/tempo.yml">
# ============================================================
# Grafana Datasource - Tempo (added by Phase 3)
# ============================================================

apiVersion: 1

datasources:
  - name: Tempo
    type: tempo
    uid: tempo-datasource
    access: proxy
    url: http://tempo:3200
    isDefault: false
    editable: true
    jsonData:
      tracesToLogsV2:                 # Link traces → logs (Loki)
        datasourceUid: loki-datasource
        filterByTraceID: false
        filterBySpanID: false
        customQuery: true
        query: '{compose_project=~".+"} |= "${__trace.traceId}"'
      tracesToMetrics:                # Link traces → metrics (Prometheus)
        datasourceUid: PBFA97CFB590B2093
      nodeGraph:
        enabled: true                 # Service map visualization
      traceQuery:
        timeShiftEnabled: true
        spanStartTimeShift: "1h"
        spanEndTimeShift: "1h"
      serviceMap:
        datasourceUid: PBFA97CFB590B2093
</file>

<file path="observability-vm/phase1-metrics/prometheus/alert_rules.yml">
# ============================================================
# Alert Rules - Phase 1
# ============================================================
# Alert rules sẽ được Prometheus evaluate theo evaluation_interval.
# Khi condition đúng trong khoảng `for`, alert sẽ FIRING.
# ============================================================

groups:
  # ----------------------------------------------------------
  # Infrastructure Alerts
  # ----------------------------------------------------------
  - name: infrastructure_alerts
    interval: 30s
    rules:

      # Target bị down
      - alert: TargetDown
        expr: up == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Target {{ $labels.instance }} is down"
          description: "{{ $labels.job }} / {{ $labels.instance }} has been down for more than 1 minute."

      # Service health check failed (Blackbox Exporter probe)
      - alert: ServiceHealthCheckFailed
        expr: probe_success{job="blackbox"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Health check failed: {{ $labels.instance }}"
          description: "Blackbox probe to {{ $labels.instance }} has been failing for more than 1 minute. Service may be down or unreachable."

      # CPU usage > 80%
      - alert: HighCpuUsage
        expr: |
          100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High CPU usage on {{ $labels.instance }}"
          description: "CPU usage is at {{ $value }}%"

      # Memory usage > 85%
      - alert: HighMemoryUsage
        expr: |
          (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High memory usage on {{ $labels.instance }}"
          description: "Memory usage is at {{ $value }}%"

      # Disk usage > 80%
      - alert: HighDiskUsage
        expr: |
          (1 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"})) * 100 > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High disk usage on {{ $labels.instance }}"
          description: "Disk {{ $labels.mountpoint }} is at {{ $value }}%"

      # ----------------------------------------------------------
      # Predictive Alerts — dự đoán trước khi xảy ra
      # ----------------------------------------------------------
      # predict_linear(metric[lookback], seconds) dự đoán giá trị
      # metric sau X giây dựa trên xu hướng trong lookback window.
      #
      # Ví dụ: predict_linear(disk_avail[1d], 4*3600) < 0
      # = "Nếu disk giảm cùng tốc độ 1 ngày qua, sẽ hết trong 4h"
      # ----------------------------------------------------------

      # Disk sẽ đầy trong 4 giờ tới
      - alert: DiskWillFillIn4Hours
        expr: |
          predict_linear(
            node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"}[1d], 4 * 3600
          ) < 0
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Disk {{ $labels.mountpoint }} predicted to fill in 4h"
          description: "Based on the trend of the last 24h, disk {{ $labels.mountpoint }} on {{ $labels.instance }} will run out of space within 4 hours."

      # Memory sẽ hết trong 2 giờ tới
      - alert: MemoryWillExhaustIn2Hours
        expr: |
          predict_linear(
            node_memory_MemAvailable_bytes[1h], 2 * 3600
          ) < 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Memory predicted to exhaust in 2h on {{ $labels.instance }}"
          description: "Based on the trend of the last 1h, available memory will be exhausted within 2 hours."

  # ----------------------------------------------------------
  # Watchdog (Dead Man's Switch)
  # ----------------------------------------------------------
  # Alert luôn firing 24/7. Nếu nó RESOLVED → alerting pipeline
  # bị hỏng (Prometheus/Alertmanager/network issue).
  #
  # Production tip: Kết hợp với PagerDuty Dead Man's Snitch
  # hoặc Healthchecks.io để monitor pipeline từ bên ngoài.
  # ----------------------------------------------------------
  - name: watchdog
    rules:
      - alert: Watchdog
        expr: vector(1)
        labels:
          severity: none
        annotations:
          summary: "Watchdog — alerting pipeline is healthy"
          description: "This alert always fires. If you stop receiving it, the alerting pipeline is broken."

  # ==========================================================
  # SLI Recording Rules (Phase 6)
  # ==========================================================
  # Multi-Window SLI Recording Rules
  # Naming convention: sli:<signal>:<aggregation>
  #
  # Windows:
  #   - rate5m   → fast-burn short window
  #   - rate30m  → slow-burn short window
  #   - rate1h   → fast-burn long window
  #   - rate6h   → slow-burn long window
  # ==========================================================
  - name: sli_recording_rules
    interval: 30s
    rules:

      # --- Availability SLI (all windows) ---
      - record: sli:api_gateway_availability:rate5m
        expr: |
          (
            sum(rate(api_gateway_requests_total{status="success"}[5m]))
            /
            sum(rate(api_gateway_requests_total[5m]))
          ) or vector(1)

      - record: sli:api_gateway_availability:rate30m
        expr: |
          (
            sum(rate(api_gateway_requests_total{status="success"}[30m]))
            /
            sum(rate(api_gateway_requests_total[30m]))
          ) or vector(1)

      - record: sli:api_gateway_availability:rate1h
        expr: |
          (
            sum(rate(api_gateway_requests_total{status="success"}[1h]))
            /
            sum(rate(api_gateway_requests_total[1h]))
          ) or vector(1)

      - record: sli:api_gateway_availability:rate6h
        expr: |
          (
            sum(rate(api_gateway_requests_total{status="success"}[6h]))
            /
            sum(rate(api_gateway_requests_total[6h]))
          ) or vector(1)

      # --- Latency SLI (P95 value for gauge display) ---
      - record: sli:api_gateway_latency_p95:rate5m
        expr: |
          histogram_quantile(0.95,
            sum(rate(api_gateway_request_duration_seconds_bucket[5m])) by (le)
          )

      # --- Latency SLO Compliance (% requests < 500ms) ---
      # Unlike availability (success/total), latency compliance =
      # requests_under_threshold / total_requests.
      # The 0.5 bucket = requests completing in ≤ 500ms.
      - record: sli:api_gateway_latency_compliance:rate5m
        expr: |
          (
            sum(rate(api_gateway_request_duration_seconds_bucket{le="0.5"}[5m]))
            /
            sum(rate(api_gateway_request_duration_seconds_count[5m]))
          ) or vector(1)

      - record: sli:api_gateway_latency_compliance:rate30m
        expr: |
          (
            sum(rate(api_gateway_request_duration_seconds_bucket{le="0.5"}[30m]))
            /
            sum(rate(api_gateway_request_duration_seconds_count[30m]))
          ) or vector(1)

      - record: sli:api_gateway_latency_compliance:rate1h
        expr: |
          (
            sum(rate(api_gateway_request_duration_seconds_bucket{le="0.5"}[1h]))
            /
            sum(rate(api_gateway_request_duration_seconds_count[1h]))
          ) or vector(1)

      - record: sli:api_gateway_latency_compliance:rate6h
        expr: |
          (
            sum(rate(api_gateway_request_duration_seconds_bucket{le="0.5"}[6h]))
            /
            sum(rate(api_gateway_request_duration_seconds_count[6h]))
          ) or vector(1)

      # --- Payment Success SLI (all windows) ---
      - record: sli:payment_success_rate:rate5m
        expr: |
          (
            sum(rate(payments_total{status="completed"}[5m]))
            /
            sum(rate(payments_total[5m]))
          ) or vector(1)

      - record: sli:payment_success_rate:rate30m
        expr: |
          (
            sum(rate(payments_total{status="completed"}[30m]))
            /
            sum(rate(payments_total[30m]))
          ) or vector(1)

      - record: sli:payment_success_rate:rate1h
        expr: |
          (
            sum(rate(payments_total{status="completed"}[1h]))
            /
            sum(rate(payments_total[1h]))
          ) or vector(1)

      - record: sli:payment_success_rate:rate6h
        expr: |
          (
            sum(rate(payments_total{status="completed"}[6h]))
            /
            sum(rate(payments_total[6h]))
          ) or vector(1)

  # ==========================================================
  # SLO Burn Rate Alerts — Multi-Window Multi-Burn-Rate (MWMBR)
  # ==========================================================
  # Google SRE pattern:
  #   Fast burn:  14.4x rate → 2% budget consumed in 1h
  #               Windows: 5m (short) AND 1h (long)
  #   Slow burn:  3x rate   → 10% budget consumed in 6h
  #               Windows: 30m (short) AND 6h (long)
  #
  # SLO targets:
  #   - API Gateway Availability: 99.5%  (error budget = 0.5%)
  #   - Payment Success Rate:     99.0%  (error budget = 1.0%)
  #   - API Gateway P95 Latency:  < 500ms
  # ==========================================================
  - name: slo_burn_rate_alerts
    interval: 30s
    rules:

      # ---- API Gateway: Fast Burn (page) ----
      # 14.4x burn rate in both 5m and 1h windows
      # Traffic guard: uses span metrics (not custom OTel counter) to avoid phantom alerts
      # from stale api_gateway_requests_total rate when traffic stops
      - alert: APIGatewayFastBurn
        expr: |
          (
            (1 - sli:api_gateway_availability:rate5m) / (1 - 0.995) > 14.4
            and
            (1 - sli:api_gateway_availability:rate1h) / (1 - 0.995) > 14.4
          and
            sum(rate(traces_spanmetrics_calls_total{service_name="api-gateway"}[5m])) > 0.1
          )
        for: 2m
        labels:
          severity: critical
          slo: api_gateway_availability
          burn_window: fast
        annotations:
          summary: "🔥 API Gateway fast burn — 2% error budget consumed in 1h"
          description: "Error budget is being consumed 14.4x faster than sustainable. Both 5m and 1h windows confirm the issue."

      # ---- API Gateway: Slow Burn (ticket) ----
      # 3x burn rate in both 30m and 6h windows
      # Traffic guard: uses span metrics to avoid phantom alerts from stale OTel counters
      - alert: APIGatewaySlowBurn
        expr: |
          (
            (1 - sli:api_gateway_availability:rate30m) / (1 - 0.995) > 3
            and
            (1 - sli:api_gateway_availability:rate6h) / (1 - 0.995) > 3
          and
            sum(rate(traces_spanmetrics_calls_total{service_name="api-gateway"}[5m])) > 0.1
          )
        for: 15m
        labels:
          severity: warning
          slo: api_gateway_availability
          burn_window: slow
        annotations:
          summary: "⚠️ API Gateway slow burn — 10% error budget consumed in 6h"
          description: "Error budget is being consumed 3x faster than sustainable. Both 30m and 6h windows confirm a sustained degradation."

      # ---- Payment: Fast Burn (page) ----
      # Traffic guard: requires > 0.1 req/s to avoid phantom alerts when traffic stops
      - alert: PaymentFastBurn
        expr: |
          (
            (1 - sli:payment_success_rate:rate5m) / (1 - 0.99) > 14.4
            and
            (1 - sli:payment_success_rate:rate1h) / (1 - 0.99) > 14.4
          and
            sum(rate(traces_spanmetrics_calls_total{service_name="payment-service"}[5m])) > 0.1
          )
        for: 2m
        labels:
          severity: critical
          slo: payment_success
          burn_window: fast
        annotations:
          summary: "🔥 Payment fast burn — 2% error budget consumed in 1h"
          description: "Payment error budget is being consumed 14.4x faster than sustainable."

      # ---- Payment: Slow Burn (ticket) ----
      # Traffic guard: requires > 0.1 req/s to avoid phantom alerts when traffic stops
      - alert: PaymentSlowBurn
        expr: |
          (
            (1 - sli:payment_success_rate:rate30m) / (1 - 0.99) > 3
            and
            (1 - sli:payment_success_rate:rate6h) / (1 - 0.99) > 3
          and
            sum(rate(traces_spanmetrics_calls_total{service_name="payment-service"}[5m])) > 0.1
          )
        for: 15m
        labels:
          severity: warning
          slo: payment_success
          burn_window: slow
        annotations:
          summary: "⚠️ Payment slow burn — 10% error budget consumed in 6h"
          description: "Payment error budget is being consumed 3x faster than sustainable."

      # ---- Latency: Fast Burn (page) ----
      # SLO: 95% requests < 500ms (error budget = 5%)
      # Traffic guard: uses span metrics to avoid phantom alerts from stale OTel counters
      - alert: APIGatewayLatencyFastBurn
        expr: |
          (
            (1 - sli:api_gateway_latency_compliance:rate5m) / (1 - 0.95) > 14.4
            and
            (1 - sli:api_gateway_latency_compliance:rate1h) / (1 - 0.95) > 14.4
          and
            sum(rate(traces_spanmetrics_calls_total{service_name="api-gateway"}[5m])) > 0.1
          )
        for: 2m
        labels:
          severity: critical
          slo: api_gateway_latency
          burn_window: fast
        annotations:
          summary: "🔥 API Gateway latency fast burn — 2% latency budget consumed in 1h"
          description: "Latency error budget is being consumed 14.4x faster than sustainable. Most requests are exceeding 500ms."

      # ---- Latency: Slow Burn (ticket) ----
      # Traffic guard: uses span metrics to avoid phantom alerts from stale OTel counters
      - alert: APIGatewayLatencySlowBurn
        expr: |
          (
            (1 - sli:api_gateway_latency_compliance:rate30m) / (1 - 0.95) > 3
            and
            (1 - sli:api_gateway_latency_compliance:rate6h) / (1 - 0.95) > 3
          and
            sum(rate(traces_spanmetrics_calls_total{service_name="api-gateway"}[5m])) > 0.1
          )
        for: 15m
        labels:
          severity: warning
          slo: api_gateway_latency
          burn_window: slow
        annotations:
          summary: "⚠️ API Gateway latency slow burn — latency degradation over 6h"
          description: "Latency error budget is being consumed 3x faster than sustainable. Sustained performance degradation detected."
</file>

<file path="observability-vm/phase1-metrics/prometheus/kafka_alert_rules.yml">
# ============================================================
# Kafka Alert Rules
# ============================================================
# Alert rules cho Kafka cluster, consumer groups, và workers.
# Metrics từ kafka-exporter + application custom metrics.
# ============================================================

groups:
  # ----------------------------------------------------------
  # Kafka Cluster Health
  # ----------------------------------------------------------
  - name: kafka_cluster_alerts
    interval: 30s
    rules:

      # Kafka exporter unreachable
      - alert: KafkaExporterDown
        expr: up{job="kafka-exporter"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Kafka Exporter is down"
          description: "Cannot scrape kafka-exporter metrics. Kafka monitoring is blind."

      # Topic has under-replicated partitions
      - alert: KafkaTopicUnderReplicated
        expr: kafka_topic_partition_under_replicated_partition > 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Under-replicated partitions on topic {{ $labels.topic }}"
          description: "Partition {{ $labels.partition }} of topic {{ $labels.topic }} is under-replicated. Data durability at risk."

  # ----------------------------------------------------------
  # Consumer Group Monitoring
  # ----------------------------------------------------------
  - name: kafka_consumer_alerts
    interval: 30s
    rules:

      # Consumer lag > 100 for 5 minutes
      - alert: KafkaConsumerLagHigh
        expr: |
          sum by(consumergroup, topic) (
            kafka_consumergroup_lag
          ) > 100
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High consumer lag for {{ $labels.consumergroup }}"
          description: "Consumer group {{ $labels.consumergroup }} has lag of {{ $value }} on topic {{ $labels.topic }}. Events are piling up."

      # Consumer lag > 1000 — critical backlog
      - alert: KafkaConsumerLagCritical
        expr: |
          sum by(consumergroup, topic) (
            kafka_consumergroup_lag
          ) > 1000
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Critical consumer lag for {{ $labels.consumergroup }}"
          description: "Consumer group {{ $labels.consumergroup }} has lag of {{ $value }}. Consumers may be down or overwhelmed."

      # Consumer group has no active members (no consumers connected)
      - alert: KafkaConsumerGroupDown
        expr: |
          kafka_consumergroup_members == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Consumer group {{ $labels.consumergroup }} has no members"
          description: "No consumers are connected to group {{ $labels.consumergroup }}. Events are not being processed."

  # ----------------------------------------------------------
  # Worker Service Alerts
  # ----------------------------------------------------------
  - name: kafka_worker_alerts
    interval: 30s
    rules:

      # Notification worker error rate high
      - alert: NotificationWorkerHighErrorRate
        expr: |
          rate(inventory_errors_total[5m]) > 0.1
          or
          rate(kafka_events_consumed_total{service_name="notification-worker"}[5m]) == 0
          and
          kafka_consumergroup_lag{consumergroup="notification-workers"} > 0
        for: 5m
        labels:
          severity: warning
          service: notification-worker
        annotations:
          summary: "Notification worker is failing or stalled"
          description: "The notification worker is either producing errors or has stopped consuming despite pending messages."

      # Inventory worker error rate high
      - alert: InventoryWorkerHighErrorRate
        expr: |
          rate(inventory_errors_total[5m]) > 0.1
        for: 5m
        labels:
          severity: warning
          service: inventory-worker
        annotations:
          summary: "Inventory worker has high error rate"
          description: "The inventory worker is producing errors at {{ $value }}/s."
</file>

<file path="observability-vm/phase1-metrics/prometheus/prometheus.yml">
# ============================================================
# Prometheus Configuration — Observability VM
# ============================================================
# Scrape targets từ 2 VM:
#   - Local (observability VM): prometheus, alertmanager, otel-collector
#   - Remote (app VM 192.168.100.57): node-exporter, cadvisor
# ============================================================

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  scrape_timeout: 10s

# ============================================================
# Alerting - Gửi alerts tới Alertmanager
# ============================================================
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

# ============================================================
# Alert Rules
# ============================================================
rule_files:
  - "alert_rules.yml"
  - "tracing_alert_rules.yml"
  - "recording_rules.yml"
  - "kafka_alert_rules.yml"

# ============================================================
# Scrape Configs
# ============================================================
scrape_configs:

  # ==========================================================
  # LOCAL TARGETS (Observability VM — 192.168.100.55)
  # ==========================================================

  # ----------------------------------------------------------
  # 1. Prometheus tự monitor
  # ----------------------------------------------------------
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          environment: "lab"
          vm: "observability"

  # ----------------------------------------------------------
  # 2. Node Exporter — Observability VM
  # ----------------------------------------------------------
  - job_name: "node-exporter"
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          environment: "lab"
          type: "infrastructure"
          vm: "observability"

  # ----------------------------------------------------------
  # 3. cAdvisor — Observability VM containers
  # ----------------------------------------------------------
  - job_name: "cadvisor"
    static_configs:
      - targets: ["cadvisor:8080"]
        labels:
          environment: "lab"
          type: "container"
          vm: "observability"

  # ----------------------------------------------------------
  # 4. Alertmanager
  # ----------------------------------------------------------
  - job_name: "alertmanager"
    static_configs:
      - targets: ["alertmanager:9093"]
        labels:
          environment: "lab"
          vm: "observability"

  # ----------------------------------------------------------
  # 5. Application Metrics (via OTel Collector)
  # ----------------------------------------------------------
  - job_name: "app-metrics"
    static_configs:
      - targets: ["otel-collector:8889"]
        labels:
          environment: "lab"
          type: "application"

  # ----------------------------------------------------------
  # 6. Span Metrics (auto RED via OTel spanmetrics connector)
  # ----------------------------------------------------------
  - job_name: "span-metrics"
    static_configs:
      - targets: ["otel-collector:8890"]
        labels:
          environment: "lab"
          type: "span-metrics"

  # ==========================================================
  # REMOTE TARGETS (App VM — 192.168.100.57)
  # ==========================================================

  # ----------------------------------------------------------
  # 7. Node Exporter — App VM
  # ----------------------------------------------------------
  - job_name: "node-exporter-app"
    static_configs:
      - targets: ["192.168.100.57:9100"]
        labels:
          environment: "lab"
          type: "infrastructure"
          vm: "app"

  # ----------------------------------------------------------
  # 8. cAdvisor — App VM containers
  # ----------------------------------------------------------
  - job_name: "cadvisor-app"
    static_configs:
      - targets: ["192.168.100.57:8080"]
        labels:
          environment: "lab"
          type: "container"
          vm: "app"

  # ----------------------------------------------------------
  # 9. Traffic Generator — App VM (for conditional alerting)
  # ----------------------------------------------------------
  - job_name: "traffic-gen"
    static_configs:
      - targets: ["192.168.100.57:5003"]
        labels:
          environment: "lab"
          type: "traffic-gen"
          vm: "app"

  # ----------------------------------------------------------
  # 10. Kafka Exporter — App VM
  # ----------------------------------------------------------
  - job_name: "kafka-exporter"
    static_configs:
      - targets: ["192.168.100.57:9308"]
        labels:
          environment: "lab"
          type: "kafka"
          vm: "app"

  # ----------------------------------------------------------
  # 11. Blackbox Exporter — Active Health Probing
  # ----------------------------------------------------------
  # Probe /health/live endpoints trên App VM.
  # Sử dụng relabel chuẩn: __address__ → __param_target,
  # rồi thay __address__ bằng blackbox-exporter.
  # ----------------------------------------------------------
  - job_name: "blackbox"
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - http://192.168.100.57:5000/health/live   # api-gateway
          - http://192.168.100.57:5001/health/live   # order-service
          - http://192.168.100.57:5002/health/live   # payment-service
          - http://192.168.100.57:5004/health/live   # notification-worker
          - http://192.168.100.57:5005/health/live   # inventory-worker
        labels:
          environment: "lab"
    relabel_configs:
      # Giữ target URL gốc làm label "instance"
      - source_labels: [__address__]
        target_label: __param_target
      # Extract service name từ port
      - source_labels: [__param_target]
        regex: "http://[^:]+:(\\d+)/.*"
        replacement: "$1"
        target_label: port
      # Chuyển __address__ sang blackbox-exporter
      - target_label: __address__
        replacement: blackbox-exporter:9115
</file>

<file path="observability-vm/phase1-metrics/prometheus/recording_rules.yml">
# ============================================================
# Recording Rules - Pre-computed Metrics
# ============================================================
# Recording rules tính trước các PromQL phức tạp và lưu
# thành metrics mới. Lợi ích:
#   - Dashboard/Alert query nhanh hơn (chỉ đọc kết quả)
#   - DRY: viết PromQL phức tạp 1 lần
#   - Nhiều users xem dashboard = tính 1 lần
#
# Naming convention:  level:metric_name:operation
# ============================================================

groups:
  # ----------------------------------------------------------
  # Application Recording Rules (từ span metrics)
  # ----------------------------------------------------------
  - name: app_recording_rules
    interval: 30s
    rules:

      # Request rate by service (req/s)
      - record: service:request_rate:5m
        expr: |
          sum by (service_name) (
            rate(traces_spanmetrics_calls_total{
              span_kind="SPAN_KIND_SERVER"
            }[5m])
          )

      # Error rate by service (%)
      - record: service:error_rate_percent:5m
        expr: |
          100 * sum by (service_name) (
            rate(traces_spanmetrics_calls_total{
              span_kind="SPAN_KIND_SERVER",
              status_code="STATUS_CODE_ERROR"
            }[5m])
          )
          /
          sum by (service_name) (
            rate(traces_spanmetrics_calls_total{
              span_kind="SPAN_KIND_SERVER"
            }[5m])
          )

      # P95 latency by service (seconds)
      - record: service:latency_p95:5m
        expr: |
          histogram_quantile(0.95,
            sum by (le, service_name) (
              rate(traces_spanmetrics_latency_bucket{
                span_kind="SPAN_KIND_SERVER"
              }[5m])
            )
          )

      # P50 latency by service (seconds)
      - record: service:latency_p50:5m
        expr: |
          histogram_quantile(0.50,
            sum by (le, service_name) (
              rate(traces_spanmetrics_latency_bucket{
                span_kind="SPAN_KIND_SERVER"
              }[5m])
            )
          )

  # ----------------------------------------------------------
  # Infrastructure Recording Rules
  # ----------------------------------------------------------
  - name: infra_recording_rules
    interval: 30s
    rules:

      # CPU usage by instance (%)
      - record: instance:cpu_usage_percent:5m
        expr: |
          100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)

      # Memory usage by instance (%)
      - record: instance:memory_usage_percent:5m
        expr: |
          (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100
</file>

<file path="observability-vm/phase1-metrics/prometheus/tracing_alert_rules.yml">
# ============================================================
# Alert Rules - Application / Tracing (Phase 4)
# ============================================================
# Alert rules cho application layer, dựa trên span metrics
# từ Tempo metrics_generator → Prometheus.
# ============================================================

groups:
  # ----------------------------------------------------------
  # Application Alerts (từ span metrics)
  # ----------------------------------------------------------
  - name: application_alerts
    interval: 30s
    rules:

      # Error rate > 10% trên bất kỳ service nào
      - alert: HighErrorRate
        expr: |
          100 * sum by (service_name) (
            rate(traces_spanmetrics_calls_total{
              span_kind="SPAN_KIND_SERVER",
              status_code="STATUS_CODE_ERROR"
            }[5m])
          )
          /
          sum by (service_name) (
            rate(traces_spanmetrics_calls_total{
              span_kind="SPAN_KIND_SERVER"
            }[5m])
          ) > 10
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: "High error rate on {{ $labels.service_name }}"
          description: "{{ $labels.service_name }} has {{ $value | printf \"%.1f\" }}% error rate (threshold: 10%)"

      # P95 latency > 2 giây
      - alert: HighLatencyP95
        expr: |
          histogram_quantile(0.95,
            sum by (le, service_name) (
              rate(traces_spanmetrics_latency_bucket{
                span_kind="SPAN_KIND_SERVER"
              }[5m])
            )
          ) > 2
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: "High P95 latency on {{ $labels.service_name }}"
          description: "{{ $labels.service_name }} P95 latency is {{ $value | printf \"%.2f\" }}s (threshold: 2s)"

      # ----------------------------------------------------------
      # Service Down Detection (conditional on load test running)
      # ----------------------------------------------------------
      # ⚠️ Chỉ fire khi traffic-gen đang chạy (traffic_gen_running == 1)
      # mà không thấy traces từ service.
      #
      # Khi idle (không load test): alert KHÔNG fire.
      # Khi load test đang chạy mà service down: alert fire.
      #
      # Logic: absent_over_time trả vector rỗng khi metric có
      # → dùng "or on() vector(0)" để lấy 0 khi metric tồn tại,
      # 1 khi metric absent. Rồi nhân với traffic_gen_running.
      # ----------------------------------------------------------

      - alert: ServiceNoTraces_ApiGateway
        expr: |
          (
            absent_over_time(
              traces_spanmetrics_calls_total{
                span_kind="SPAN_KIND_SERVER",
                service_name="api-gateway"
              }[3m]
            )
          )
          and on() (traffic_gen_running == 1)
        for: 2m
        labels:
          severity: critical
          service_name: api-gateway
        annotations:
          summary: "No traces from api-gateway (load test active)"
          description: "Load test is running but api-gateway has not produced any traces in 3+ minutes. Service may be down."

      - alert: ServiceNoTraces_OrderService
        expr: |
          (
            absent_over_time(
              traces_spanmetrics_calls_total{
                span_kind="SPAN_KIND_SERVER",
                service_name="order-service"
              }[3m]
            )
          )
          and on() (traffic_gen_running == 1)
        for: 2m
        labels:
          severity: critical
          service_name: order-service
        annotations:
          summary: "No traces from order-service (load test active)"
          description: "Load test is running but order-service has not produced any traces in 3+ minutes. Service may be down."

      - alert: ServiceNoTraces_PaymentService
        expr: |
          (
            absent_over_time(
              traces_spanmetrics_calls_total{
                span_kind="SPAN_KIND_SERVER",
                service_name="payment-service"
              }[3m]
            )
          )
          and on() (traffic_gen_running == 1)
        for: 2m
        labels:
          severity: critical
          service_name: payment-service
        annotations:
          summary: "No traces from payment-service (load test active)"
          description: "Load test is running but payment-service has not produced any traces in 3+ minutes. Service may be down."
</file>

<file path="observability-vm/phase1-metrics/webhook-receiver/app.py">
"""
============================================================
Webhook Receiver — Test Alertmanager Notifications
============================================================
Flask app đơn giản nhận webhook POST từ Alertmanager
và hiển thị alerts trên web UI + console.

Endpoints:
  GET  /          → Web UI xem alerts đã nhận
  POST /webhook   → Nhận alerts từ Alertmanager
  GET  /health    → Health check
============================================================
"""

import json
from datetime import datetime
from flask import Flask, request, jsonify

app = Flask(__name__)

# Lưu alerts trong memory (mất khi restart)
received_alerts = []
MAX_ALERTS = 200

@app.route("/webhook", methods=["POST"])
def webhook():
    """Nhận alert notification từ Alertmanager"""
    data = request.get_json(force=True)

    entry = {
        "received_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "status": data.get("status", "unknown"),
        "alerts_count": len(data.get("alerts", [])),
        "alerts": data.get("alerts", []),
        "group_labels": data.get("groupLabels", {}),
    }
    received_alerts.insert(0, entry)

    # Giới hạn số lượng lưu
    while len(received_alerts) > MAX_ALERTS:
        received_alerts.pop()

    # In ra console để dễ debug
    print(f"\n{'='*60}")
    print(f"🔔 [{entry['received_at']}] Status: {entry['status'].upper()}")
    for alert in data.get("alerts", []):
        status = alert.get("status", "unknown")
        name = alert.get("labels", {}).get("alertname", "?")
        severity = alert.get("labels", {}).get("severity", "?")
        summary = alert.get("annotations", {}).get("summary", "")
        icon = "🔥" if status == "firing" else "✅"
        print(f"  {icon} {name} [{severity}] — {summary}")
    print(f"{'='*60}\n")

    return jsonify({"status": "ok"}), 200


@app.route("/")
def index():
    """Web UI — hiển thị alerts đã nhận"""
    rows = ""
    for entry in received_alerts:
        status = entry["status"]
        color = "#ff4444" if status == "firing" else "#44bb44"
        for alert in entry["alerts"]:
            a_status = alert.get("status", "?")
            name = alert.get("labels", {}).get("alertname", "?")
            severity = alert.get("labels", {}).get("severity", "?")
            instance = alert.get("labels", {}).get("instance", "—")
            summary = alert.get("annotations", {}).get("summary", "")
            sev_color = "#ff4444" if severity == "critical" else "#ffaa00" if severity == "warning" else "#4488ff"
            icon = "🔥" if a_status == "firing" else "✅"
            rows += f"""
            <tr>
                <td>{entry['received_at']}</td>
                <td>{icon} {a_status}</td>
                <td style="color:{sev_color};font-weight:bold">{severity.upper()}</td>
                <td><strong>{name}</strong></td>
                <td>{instance}</td>
                <td>{summary}</td>
            </tr>"""

    if not rows:
        rows = '<tr><td colspan="6" style="text-align:center;padding:40px;color:#888">Chưa nhận được alert nào. Đợi Alertmanager gửi notification...</td></tr>'

    html = f"""<!DOCTYPE html>
<html>
<head>
    <title>Webhook Receiver — Alertmanager Test</title>
    <meta http-equiv="refresh" content="10">
    <style>
        body {{ font-family: -apple-system, sans-serif; background: #1a1a2e; color: #e0e0e0; margin: 0; padding: 20px; }}
        h1 {{ color: #00d4ff; }}
        .info {{ color: #888; margin-bottom: 20px; }}
        table {{ width: 100%; border-collapse: collapse; }}
        th {{ background: #16213e; color: #00d4ff; padding: 12px; text-align: left; }}
        td {{ padding: 10px 12px; border-bottom: 1px solid #2a2a4a; }}
        tr:hover {{ background: #16213e; }}
        .count {{ background: #00d4ff; color: #1a1a2e; padding: 4px 12px; border-radius: 12px; font-weight: bold; }}
    </style>
</head>
<body>
    <h1>🔔 Webhook Receiver</h1>
    <p class="info">
        Total received: <span class="count">{len(received_alerts)}</span> notifications
        &nbsp;|&nbsp; Auto-refresh mỗi 10s
        &nbsp;|&nbsp; POST endpoint: <code>/webhook</code>
    </p>
    <table>
        <tr>
            <th>Time</th>
            <th>Status</th>
            <th>Severity</th>
            <th>Alert</th>
            <th>Instance</th>
            <th>Summary</th>
        </tr>
        {rows}
    </table>
</body>
</html>"""
    return html


@app.route("/health")
def health():
    return jsonify({"status": "healthy", "alerts_received": len(received_alerts)})


if __name__ == "__main__":
    print("🔔 Webhook Receiver started on :9095")
    print("   POST /webhook  — nhận alerts từ Alertmanager")
    print("   GET  /         — web UI xem alerts")
    app.run(host="0.0.0.0", port=9095)
</file>

