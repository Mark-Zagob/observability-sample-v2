<file path="observability-vm/phase1-metrics/docker-compose.yml">
  1: # ============================================================
  2: # Phase 1: Metrics Foundation
  3: # Prometheus + Grafana + Node Exporter + cAdvisor
  4: # ============================================================
  5: # Mục tiêu: Giám sát VM/host và Docker containers
  6: # Chưa cần sample app — chỉ tập trung infrastructure metrics
  7: # ============================================================
  8: 
  9: services:
 10:   # ==========================================================
 11:   # PROMETHEUS - Metrics Collection & Storage
 12:   # ==========================================================
 13:   # Prometheus là "trái tim" của hệ thống metrics.
 14:   # Nó PULL (kéo) metrics từ các targets theo định kỳ.
 15:   # ==========================================================
 16:   prometheus:
 17:     image: prom/prometheus:v3.10.0
 18:     container_name: prometheus
 19:     volumes:
 20:       - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
 21:       - ./prometheus/alert_rules.yml:/etc/prometheus/alert_rules.yml:ro
 22:       - ./prometheus/tracing_alert_rules.yml:/etc/prometheus/tracing_alert_rules.yml:ro
 23:       - ./prometheus/recording_rules.yml:/etc/prometheus/recording_rules.yml:ro
 24:       - ./prometheus/kafka_alert_rules.yml:/etc/prometheus/kafka_alert_rules.yml:ro
 25:       - prometheus_data:/prometheus
 26:     command:
 27:       - '--config.file=/etc/prometheus/prometheus.yml'
 28:       - '--storage.tsdb.path=/prometheus'
 29:       - '--storage.tsdb.retention.time=15d'       # Giữ data 15 ngày
 30:       - '--web.enable-lifecycle'                    # Cho phép reload config qua API
 31:       - '--web.enable-remote-write-receiver'        # Bật nhận remote write (hữu ích cho OTEL sau này)
 32:       - '--enable-feature=exemplar-storage'          # Lưu exemplars (trace_id gắn với metrics)
 33:     ports:
 34:       - "9090:9090"
 35:     networks:
 36:       - observability
 37:     restart: unless-stopped
 38: 
 39:   # ==========================================================
 40:   # GRAFANA - Visualization & Dashboards
 41:   # ==========================================================
 42:   # Grafana là công cụ tạo dashboard, trực quan hoá metrics.
 43:   # Nó kết nối tới Prometheus như một datasource.
 44:   # ==========================================================
 45:   grafana:
 46:     image: grafana/grafana:12.3.3
 47:     container_name: grafana
 48:     environment:
 49:       - GF_SECURITY_ADMIN_USER=admin
 50:       - GF_SECURITY_ADMIN_PASSWORD=admin123
 51:       - GF_USERS_ALLOW_SIGN_UP=false
 52:     volumes:
 53:       - grafana_data:/var/lib/grafana
 54:       - ./grafana/provisioning:/etc/grafana/provisioning:ro
 55:       - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
 56:     ports:
 57:       - "3000:3000"
 58:     networks:
 59:       - observability
 60:     depends_on:
 61:       - prometheus
 62:     restart: unless-stopped
 63: 
 64:   # ==========================================================
 65:   # NODE EXPORTER - Host/System Metrics
 66:   # ==========================================================
 67:   # Thu thập metrics của máy host: CPU, RAM, Disk, Network.
 68:   # Đây là exporter phổ biến nhất của Prometheus.
 69:   # ==========================================================
 70:   node-exporter:
 71:     image: prom/node-exporter:v1.10.2
 72:     container_name: node-exporter
 73:     volumes:
 74:       - /proc:/host/proc:ro
 75:       - /sys:/host/sys:ro
 76:       - /:/rootfs:ro
 77:     command:
 78:       - '--path.procfs=/host/proc'
 79:       - '--path.rootfs=/rootfs'
 80:       - '--path.sysfs=/host/sys'
 81:       - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
 82:     ports:
 83:       - "9100:9100"
 84:     networks:
 85:       - observability
 86:     restart: unless-stopped
 87: 
 88:   # ==========================================================
 89:   # cADVISOR - Container Metrics
 90:   # ==========================================================
 91:   # Thu thập metrics của Docker containers:
 92:   # CPU, Memory, Network I/O, Disk I/O per container.
 93:   # ==========================================================
 94:   cadvisor:
 95:     image: gcr.io/cadvisor/cadvisor:v0.51.0
 96:     container_name: cadvisor
 97:     privileged: true
 98:     devices:
 99:       - /dev/kmsg:/dev/kmsg
100:     volumes:
101:       - /:/rootfs:ro
102:       - /var/run:/var/run:ro
103:       - /sys:/sys:ro
104:       - /var/lib/docker:/var/lib/docker:ro
105:       - /dev/disk/:/dev/disk:ro
106:     ports:
107:       - "8080:8080"
108:     networks:
109:       - observability
110:     restart: unless-stopped
111: 
112:   # ==========================================================
113:   # ALERTMANAGER - Alert Routing & Notification (Phase 4)
114:   # ==========================================================
115:   # Nhận alerts từ Prometheus → route theo severity
116:   # → gửi notification tới receivers (webhook, Slack, ...)
117:   # ==========================================================
118:   alertmanager:
119:     image: prom/alertmanager:v0.28.1
120:     environment:
121:       - TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
122:     container_name: alertmanager
123:     command:
124:       - '--config.file=/etc/alertmanager/alertmanager.yml'
125:       - '--storage.path=/alertmanager'
126:       - '--web.external-url=http://localhost:9093'
127:     volumes:
128:       - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
129:       - alertmanager_data:/alertmanager
130:     ports:
131:       - "9093:9093"
132:     networks:
133:       - observability
134:     restart: unless-stopped
135: 
136:   # ==========================================================
137:   # WEBHOOK RECEIVER - Test alert notifications
138:   # ==========================================================
139:   # Container đơn giản nhận webhook POST từ Alertmanager
140:   # và hiển thị trên web UI. Dùng để test trước khi cấu hình
141:   # Slack/Email thực tế.
142:   #
143:   # Web UI: http://<VM_IP>:9095
144:   # Webhook endpoint: http://webhook-receiver:9095/webhook
145:   # ==========================================================
146:   webhook-receiver:
147:     build: ./webhook-receiver
148:     container_name: webhook-receiver
149:     ports:
150:       - "9095:9095"
151:     networks:
152:       - observability
153:     restart: unless-stopped
154: 
155:   # ==========================================================
156:   # BLACKBOX EXPORTER - Active Health Check Probing
157:   # ==========================================================
158:   # Probe HTTP endpoints trên App VM để detect service down
159:   # mà không phụ thuộc vào traffic. Production-grade approach:
160:   # Prometheus → Blackbox → GET /health/live → service
161:   # ==========================================================
162:   blackbox-exporter:
163:     image: prom/blackbox-exporter:v0.25.0
164:     container_name: blackbox-exporter
165:     volumes:
166:       - ./blackbox/blackbox.yml:/etc/blackbox_exporter/config.yml:ro
167:     ports:
168:       - "9115:9115"
169:     networks:
170:       - observability
171:     restart: unless-stopped
172: 
173: volumes:
174:   prometheus_data:
175:   grafana_data:
176:   alertmanager_data:
177: 
178: # ==========================================================
179: # External Network
180: # ==========================================================
181: # Dùng external network để các phase sau (Loki, Tempo, ...)
182: # có thể join cùng network mà không cần sửa file này.
183: #
184: # Tạo network trước khi chạy:
185: #   docker network create observability
186: # ==========================================================
187: networks:
188:   observability:
189:     external: true
</file>

<file path="observability-vm/phase1-metrics/README.md">
 1: # Phase 1: Metrics Foundation
 2: 
 3: ## Prerequisites
 4: 
 5: - Docker Engine ≥ 24.x
 6: - Docker Compose ≥ 2.x
 7: 
 8: ## Quick Start
 9: 
10: ```bash
11: # 1. Tạo external network (chỉ cần 1 lần)
12: docker network create observability
13: 
14: # 2. Khởi chạy
15: docker compose up -d
16: 
17: # 3. Kiểm tra
18: docker compose ps
19: ```
20: 
21: ## Endpoints
22: 
23: | Service        | URL                      | Ghi chú               |
24: | -------------- | ------------------------ | ---------------------- |
25: | Prometheus     | http://<VM_IP>:9090      | Query, Targets, Alerts |
26: | Grafana        | http://<VM_IP>:3000      | admin / admin123       |
27: | Node Exporter  | http://<VM_IP>:9100      | Raw metrics            |
28: | cAdvisor       | http://<VM_IP>:8080      | Container metrics UI   |
29: 
30: ## Dashboards (tự động load)
31: 
32: Vào Grafana → **Dashboards → folder "Infrastructure"**:
33: 
34: | Dashboard                    | Nội dung                                  |
35: | ---------------------------- | ----------------------------------------- |
36: | Node Exporter - Host         | CPU, Memory, Disk, Network của VM         |
37: | Docker Containers Monitoring | CPU, Memory, Network per container        |
38: | Prometheus Self-Monitoring   | Targets health, scrape, TSDB storage      |
39: 
40: ## Quản lý
41: 
42: ```bash
43: # Reload Prometheus config (không cần restart)
44: curl -X POST http://localhost:9090/-/reload
45: 
46: # Xem logs
47: docker compose logs -f prometheus
48: docker compose logs -f grafana
49: 
50: # Dừng
51: docker compose down
52: 
53: # Dừng + xoá data
54: docker compose down -v
55: ```
56: 
57: ## Cấu trúc
58: 
59: ```
60: phase1-metrics/
61: ├── docker-compose.yml
62: ├── prometheus/
63: │   ├── prometheus.yml          # Scrape config
64: │   └── alert_rules.yml         # Alert rules
65: └── grafana/
66:     ├── dashboards/             # Dashboard JSON (as code)
67:     │   ├── node-exporter.json
68:     │   ├── docker-containers.json
69:     │   └── prometheus-self.json
70:     └── provisioning/
71:         ├── dashboards/
72:         │   └── dashboards.yml  # Dashboard provider
73:         └── datasources/
74:             └── prometheus.yml  # Datasource config
75: ```
</file>

<file path="observability-vm/phase2-logging/alloy/config.alloy">
  1: // ============================================================
  2: // Grafana Alloy - Phase 2
  3: // ============================================================
  4: // Thu thập 3 loại logs:
  5: //   1. Docker container logs (via Docker API)
  6: //   2. Host system logs (/var/log/syslog)
  7: //   3. Docker daemon logs (tạm bỏ — xem note bên dưới)
  8: //
  9: // Pipeline:
 10: //   Source → Process (parse, extract, filter) → Push Loki
 11: // ============================================================
 12: 
 13: // ============================================================
 14: // PHẦN 1: DOCKER CONTAINER LOGS
 15: // ============================================================
 16: 
 17: discovery.docker "containers" {
 18:   host = "unix:///var/run/docker.sock"
 19: }
 20: 
 21: discovery.relabel "docker_labels" {
 22:   targets = discovery.docker.containers.targets
 23: 
 24:   rule {
 25:     source_labels = ["__meta_docker_container_name"]
 26:     regex         = "/(.*)"
 27:     target_label  = "container_name"
 28:   }
 29: 
 30:   rule {
 31:     source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
 32:     target_label  = "compose_project"
 33:   }
 34: 
 35:   rule {
 36:     source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
 37:     target_label  = "compose_service"
 38:   }
 39: }
 40: 
 41: loki.source.docker "containers" {
 42:   host       = "unix:///var/run/docker.sock"
 43:   targets    = discovery.relabel.docker_labels.output
 44:   forward_to = [loki.process.docker_pipeline.receiver]
 45: }
 46: 
 47: // ============================================================
 48: // LOG PROCESSING PIPELINE — Docker containers
 49: // ============================================================
 50: // Pipeline xử lý log trước khi push Loki:
 51: //   1. Detect & drop health check noise
 52: //   2. Thử parse JSON → extract structured fields
 53: //   3. Nếu không phải JSON → parse logfmt
 54: //   4. Extract log level thành label (để filter/query)
 55: //   5. Thêm label source = "docker"
 56: // ============================================================
 57: 
 58: loki.process "docker_pipeline" {
 59:   // ---------------------------------------------------------
 60:   // Stage 1: Drop health check logs
 61:   // ---------------------------------------------------------
 62:   // Nhiều service liên tục log "GET /health", "GET /ready"
 63:   // → noise chiếm dung lượng, không có giá trị debug.
 64:   // Drop trước khi parse để tiết kiệm CPU.
 65:   // ---------------------------------------------------------
 66:   stage.drop {
 67:     expression = "(?i)(GET|HEAD)\\s+/(health|ready|healthz|livez|readyz)"
 68:     drop_counter_reason = "health_check"
 69:   }
 70: 
 71:   // ---------------------------------------------------------
 72:   // Stage 2: Parse JSON logs
 73:   // ---------------------------------------------------------
 74:   // Hầu hết application hiện đại log theo structured JSON:
 75:   //   {"level":"info","msg":"request handled","trace_id":"abc"}
 76:   //
 77:   // stage.json extract các field ra dạng "extracted values"
 78:   // để các stage sau có thể dùng (label, template, output...).
 79:   //
 80:   // Nếu log KHÔNG phải JSON → stage này tự skip, không lỗi.
 81:   // ---------------------------------------------------------
 82:   stage.json {
 83:     expressions = {
 84:       level    = "level",
 85:       msg      = "msg",
 86:       caller   = "caller",
 87:       trace_id = "trace_id",
 88:       span_id  = "span_id",
 89:     }
 90:   }
 91: 
 92:   // ---------------------------------------------------------
 93:   // Stage 3: Parse logfmt (fallback)
 94:   // ---------------------------------------------------------
 95:   // Một số service (ví dụ Prometheus, Loki) log dạng logfmt:
 96:   //   level=info msg="server started" caller=main.go:42
 97:   //
 98:   // Nếu stage.json đã extract thành công → giá trị giữ nguyên.
 99:   // Nếu chưa → stage.logfmt sẽ extract.
100:   // ---------------------------------------------------------
101:   stage.logfmt {
102:     mapping = {
103:       level  = "",
104:       msg    = "",
105:       caller = "",
106:       ts     = "",
107:     }
108:   }
109: 
110:   // ---------------------------------------------------------
111:   // Stage 4: Chuẩn hoá log level
112:   // ---------------------------------------------------------
113:   // Các service khác nhau dùng format level khác nhau:
114:   //   "INFO", "info", "warning", "warn", "WARN"
115:   // → Chuẩn hoá tất cả về lowercase để query nhất quán.
116:   // ---------------------------------------------------------
117:   stage.template {
118:     source   = "level"
119:     template = "{{ ToLower .Value }}"
120:   }
121: 
122:   // Map "warning" → "warn" cho nhất quán
123:   stage.replace {
124:     expression = "warning"
125:     source     = "level"
126:     replace    = "warn"
127:   }
128: 
129:   // ---------------------------------------------------------
130:   // Stage 5: Gán detected_level label
131:   // ---------------------------------------------------------
132:   // Tạo label "detected_level" từ extracted level.
133:   // → Cho phép query: {detected_level="error"}
134:   //
135:   // LƯU Ý: Chỉ dùng label có low cardinality
136:   // (debug/info/warn/error/fatal). KHÔNG BAO GIỜ đưa
137:   // high-cardinality fields (user_id, request_id) vào label.
138:   // ---------------------------------------------------------
139:   stage.labels {
140:     values = {
141:       detected_level = "level",
142:     }
143:   }
144: 
145:   // ---------------------------------------------------------
146:   // Stage 6: Gán static label source
147:   // ---------------------------------------------------------
148:   stage.static_labels {
149:     values = {
150:       source = "docker",
151:       vm     = "observability",
152:     }
153:   }
154: 
155:   // ---------------------------------------------------------
156:   // Stage 7: Drop noisy debug logs
157:   // ---------------------------------------------------------
158:   // Trong lab/dev, debug logs ít giá trị nhưng chiếm nhiều
159:   // dung lượng. Drop để giảm storage cost.
160:   // Comment out stage này nếu cần debug chi tiết.
161:   // ---------------------------------------------------------
162:   stage.drop {
163:     source           = "level"
164:     expression       = "debug"
165:     drop_counter_reason = "debug_level"
166:   }
167: 
168:   forward_to = [loki.write.loki_endpoint.receiver]
169: }
170: 
171: // ============================================================
172: // PHẦN 2: HOST SYSTEM LOGS
173: // ============================================================
174: 
175: local.file_match "syslog" {
176:   path_targets = [{
177:     __path__  = "/var/log/host/syslog",
178:     job       = "syslog",
179:     log_type  = "system",
180:   }]
181: }
182: 
183: loki.source.file "syslog" {
184:   targets    = local.file_match.syslog.targets
185:   forward_to = [loki.process.host_pipeline.receiver]
186: }
187: 
188: local.file_match "auth_log" {
189:   path_targets = [{
190:     __path__  = "/var/log/host/auth.log",
191:     job       = "auth",
192:     log_type  = "security",
193:   }]
194: }
195: 
196: loki.source.file "auth_log" {
197:   targets    = local.file_match.auth_log.targets
198:   forward_to = [loki.process.host_pipeline.receiver]
199: }
200: 
201: // ============================================================
202: // LOG PROCESSING PIPELINE — Host logs
203: // ============================================================
204: // Syslog format: "Mar 12 06:30:01 hostname service[pid]: message"
205: // Pipeline nhẹ hơn docker: chỉ thêm source label + parse
206: // severity cơ bản.
207: // ============================================================
208: 
209: loki.process "host_pipeline" {
210:   // ---------------------------------------------------------
211:   // Stage 1: Extract syslog fields
212:   // ---------------------------------------------------------
213:   // Parse syslog standard format để lấy hostname, service, PID.
214:   // Regex khớp: "Mar 12 06:30:01 myhost sshd[1234]: message"
215:   // ---------------------------------------------------------
216:   stage.regex {
217:     expression = "^\\w+\\s+\\d+\\s+[\\d:]+\\s+(?P<hostname>\\S+)\\s+(?P<syslog_service>[^\\[\\s:]+)"
218:   }
219: 
220:   stage.labels {
221:     values = {
222:       hostname       = "",
223:       syslog_service = "",
224:     }
225:   }
226: 
227:   // ---------------------------------------------------------
228:   // Stage 2: Detect severity từ nội dung
229:   // ---------------------------------------------------------
230:   // Syslog không có structured level, nhưng ta có thể detect
231:   // từ keywords: "error", "fail", "panic", "crit"
232:   // ---------------------------------------------------------
233:   stage.regex {
234:     expression = "(?i)(?P<severity>error|fail|panic|crit|warn|alert|emerg)"
235:   }
236: 
237:   stage.template {
238:     source   = "severity"
239:     template = "{{ if .Value }}{{ ToLower .Value }}{{ else }}info{{ end }}"
240:   }
241: 
242:   stage.labels {
243:     values = {
244:       detected_level = "severity",
245:     }
246:   }
247: 
248:   // ---------------------------------------------------------
249:   // Stage 3: Static label
250:   // ---------------------------------------------------------
251:   stage.static_labels {
252:     values = {
253:       source = "host",
254:       vm     = "observability",
255:     }
256:   }
257: 
258:   forward_to = [loki.write.loki_endpoint.receiver]
259: }
260: 
261: // ============================================================
262: // PHẦN 3: DOCKER DAEMON LOGS
263: // ============================================================
264: // Đã loại bỏ do Docker trên Ubuntu/Debian thường log thẳng vào
265: // Systemd Journal (journalctl), KHÔNG ghi ra /var/log/docker.log
266: // Việc đọc journald đòi hỏi mount cấu hình phức tạp hơn,
267: // nên tạm bỏ qua ở phase cơ bản này.
268: // ============================================================
269: 
270: // ============================================================
271: // PUSH VỀ LOKI
272: // ============================================================
273: 
274: loki.write "loki_endpoint" {
275:   endpoint {
276:     url = "http://loki:3100/loki/api/v1/push"
277:   }
278: }
</file>

<file path="observability-vm/phase2-logging/loki/loki-config.yml">
 1: # ============================================================
 2: # Loki Configuration
 3: # ============================================================
 4: # Dựa trên config đã chạy ổn định với Loki 3.3.2
 5: # Chế độ: monolithic (tất cả trong 1 process)
 6: # Storage: MinIO (S3-compatible) — bucket "loki"
 7: # ============================================================
 8: 
 9: auth_enabled: false
10: 
11: server:
12:   http_listen_port: 3100
13:   grpc_listen_port: 9096
14:   log_level: info
15: 
16: common:
17:   instance_addr: 127.0.0.1
18:   path_prefix: /loki
19:   storage:
20:     s3:
21:       endpoint: minio:9000
22:       bucketnames: loki
23:       access_key_id: minioadmin
24:       secret_access_key: minioadmin
25:       insecure: true              # HTTP (không HTTPS) cho lab
26:       s3forcepathstyle: true      # Bắt buộc cho MinIO
27:   replication_factor: 1
28:   ring:
29:     kvstore:
30:       store: inmemory
31: 
32: query_range:
33:   results_cache:
34:     cache:
35:       embedded_cache:
36:         enabled: true
37:         max_size_mb: 100
38: 
39: schema_config:
40:   configs:
41:     - from: 2024-01-01
42:       store: tsdb
43:       object_store: s3
44:       schema: v13
45:       index:
46:         prefix: index_
47:         period: 24h
48: 
49: storage_config:
50:   tsdb_shipper:
51:     active_index_directory: /loki/tsdb-index
52:     cache_location: /loki/tsdb-cache
53: 
54: limits_config:
55:   retention_period: 168h         # 7 ngày
56:   reject_old_samples: true
57:   reject_old_samples_max_age: 168h  # Chấp nhận entries tối đa 7 ngày tuổi
58:   ingestion_rate_mb: 10
59:   ingestion_burst_size_mb: 20
60:   max_streams_per_user: 10000
61:   max_line_size: 256kb
62: 
63: compactor:
64:   working_directory: /loki/compactor
65:   compaction_interval: 10m
66:   retention_enabled: true
67:   retention_delete_delay: 2h
68:   delete_request_store: s3
69: 
70: analytics:
71:   reporting_enabled: false
</file>

<file path="observability-vm/phase2-logging/docker-compose.yml">
 1: # ============================================================
 2: # Phase 2: Logging
 3: # Loki + Alloy
 4: # ============================================================
 5: # Mục tiêu: Thu thập và tập trung logs từ Docker containers
 6: # Join cùng external network "observability" với Phase 1
 7: # ============================================================
 8: 
 9: services:
10:   # ==========================================================
11:   # GRAFANA LOKI - Log Storage & Query Engine
12:   # ==========================================================
13:   # Loki lưu trữ logs và cho phép query bằng LogQL.
14:   # Khác Elasticsearch: Loki chỉ index LABELS, không index nội
15:   # dung log → rất nhẹ, ít tốn tài nguyên.
16:   # ==========================================================
17:   loki:
18:     image: grafana/loki:3.3.2
19:     container_name: loki
20:     volumes:
21:       - ./loki/loki-config.yml:/etc/loki/loki-config.yml:ro
22:       - loki_data:/loki
23:     command: -config.file=/etc/loki/loki-config.yml
24:     ports:
25:       - "3100:3100"
26:     networks:
27:       - observability
28:     restart: unless-stopped
29:     healthcheck:
30:       test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:3100/ready || exit 1"]
31:       interval: 10s
32:       timeout: 5s
33:       retries: 10
34:       start_period: 30s          # Cho Loki 30s để khởi tạo ring trước khi bắt đầu check
35: 
36:   # ==========================================================
37:   # GRAFANA ALLOY - Log Collector (thay thế Promtail)
38:   # ==========================================================
39:   # Alloy đọc logs từ Docker containers và push về Loki.
40:   # Nó tự động phát hiện containers qua Docker socket.
41:   #
42:   # Alloy = thế hệ mới, thay thế Promtail + Grafana Agent.
43:   # Có thể thu thập metrics, logs, traces trong 1 agent.
44:   # ==========================================================
45:   alloy:
46:     image: grafana/alloy:v1.13.2
47:     container_name: alloy
48:     user: root
49:     volumes:
50:       - ./alloy/config.alloy:/etc/alloy/config.alloy:ro
51:       - /var/lib/docker/containers:/var/lib/docker/containers:ro
52:       - /var/run/docker.sock:/var/run/docker.sock:ro
53:       - /var/log:/var/log/host:ro  # Host logs (syslog, auth.log, docker.log)
54:     command:
55:       - run
56:       - /etc/alloy/config.alloy
57:       - --storage.path=/var/lib/alloy/data
58:       - --server.http.listen-addr=0.0.0.0:12345
59:     ports:
60:       - "12345:12345"      # Alloy UI
61:     networks:
62:       - observability
63:     depends_on:
64:       loki:
65:         condition: service_healthy
66:     restart: unless-stopped
67: 
68: volumes:
69:   loki_data:
70: 
71: # ==========================================================
72: # External Network - cùng network với Phase 1
73: # ==========================================================
74: networks:
75:   observability:
76:     external: true
</file>

<file path="observability-vm/phase2-logging/README.md">
 1: # Phase 2: Logging (Loki + Alloy)
 2: 
 3: ## Prerequisites
 4: 
 5: - Phase 1 đang chạy (Grafana cần restart để nhận datasource Loki)
 6: - External network `observability` đã tạo
 7: 
 8: ## Quick Start
 9: 
10: ```bash
11: # 1. Khởi chạy Loki + Alloy
12: cd /root/workspace/observability-lab/phase2-logging
13: docker compose up -d
14: 
15: # 2. Restart Grafana để load datasource Loki mới
16: cd /root/workspace/observability-lab/phase1-metrics
17: docker compose restart grafana
18: 
19: # 3. Kiểm tra
20: docker compose -f /root/workspace/observability-lab/phase2-logging/docker-compose.yml ps
21: ```
22: 
23: ## Endpoints
24: 
25: | Service | URL                  | Ghi chú                |
26: | ------- | -------------------- | ---------------------- |
27: | Loki    | http://<VM_IP>:3100  | API - check /ready     |
28: | Alloy   | http://<VM_IP>:12345 | Alloy UI (pipeline)    |
29: 
30: ## Dashboard
31: 
32: Grafana → Dashboards → folder "Infrastructure" → **Docker Logs Overview**
33: 
34: ## LogQL cheat sheet
35: 
36: ```logql
37: # Tất cả logs từ 1 container
38: {container_name="prometheus"}
39: 
40: # Filter theo text
41: {container_name="grafana"} |= "error"
42: 
43: # Filter loại trừ
44: {compose_service="loki"} != "healthcheck"
45: 
46: # Regex filter
47: {container_name=~".*exporter.*"} |~ "(?i)warn|error"
48: 
49: # Đếm logs/phút theo container
50: sum by(container_name) (count_over_time({compose_project=~".+"}[1m]))
51: 
52: # Top 5 container nhiều error nhất
53: topk(5, sum by(container_name) (count_over_time({compose_project=~".+"} |= "error" [5m])))
54: ```
55: 
56: ## Cấu trúc
57: 
58: ```
59: phase2-logging/
60: ├── docker-compose.yml
61: ├── loki/
62: │   └── loki-config.yml      # Storage, retention, schema
63: └── alloy/
