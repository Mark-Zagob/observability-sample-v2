595:     if (active === 'dashboard') refreshDashboard();
596:     if (active === 'events') loadEventsTab();
597: }, 30000);
598: 
599: // ============================================================
600: // Events Tab — Kafka Workers Dashboard
601: // ============================================================
602: async function loadEventsTab() {
603:     await Promise.all([loadWorkerStatuses(), loadNotifications(), loadInventoryLog()]);
604: }
605: 
606: async function loadWorkerStatuses() {
607:     // Notification Worker
608:     const nResp = await notifApi('/status');
609:     if (nResp.ok) {
610:         const d = nResp.data;
611:         document.getElementById('evt-notif-badge').textContent = d.status || 'running';
612:         document.getElementById('evt-notif-badge').className =
613:             `events-worker-badge ${d.status === 'running' ? 'running' : 'stopped'}`;
614:         document.getElementById('evt-notif-processed').textContent = d.events_processed ?? '—';
615:         document.getElementById('evt-notif-errors').textContent = d.errors ?? '—';
616:         document.getElementById('evt-notif-uptime').textContent = formatUptime(d.uptime_seconds);
617:         document.getElementById('evt-notification-card').className = 'events-worker-card healthy';
618:     } else {
619:         document.getElementById('evt-notif-badge').textContent = 'down';
620:         document.getElementById('evt-notif-badge').className = 'events-worker-badge down';
621:         document.getElementById('evt-notification-card').className = 'events-worker-card down';
622:     }
623: 
624:     // Inventory Worker
625:     const iResp = await invApi('/status');
626:     if (iResp.ok) {
627:         const d = iResp.data;
628:         document.getElementById('evt-inv-badge').textContent = d.status || 'running';
629:         document.getElementById('evt-inv-badge').className =
630:             `events-worker-badge ${d.status === 'running' ? 'running' : 'stopped'}`;
631:         document.getElementById('evt-inv-processed').textContent = d.events_processed ?? '—';
632:         document.getElementById('evt-inv-errors').textContent = d.errors ?? '—';
633:         document.getElementById('evt-inv-uptime').textContent = formatUptime(d.uptime_seconds);
634:         document.getElementById('evt-inventory-card').className = 'events-worker-card healthy';
635:     } else {
636:         document.getElementById('evt-inv-badge').textContent = 'down';
637:         document.getElementById('evt-inv-badge').className = 'events-worker-badge down';
638:         document.getElementById('evt-inventory-card').className = 'events-worker-card down';
639:     }
640: }
641: 
642: function formatUptime(seconds) {
643:     if (!seconds && seconds !== 0) return '—';
644:     if (seconds < 60) return `${Math.round(seconds)}s`;
645:     if (seconds < 3600) return `${Math.round(seconds / 60)}m`;
646:     return `${Math.round(seconds / 3600)}h`;
647: }
648: 
649: async function loadNotifications() {
650:     const resp = await notifApi('/notifications?limit=30');
651:     const tbody = document.getElementById('notifications-tbody');
652:     if (!resp.ok) {
653:         tbody.innerHTML = '<tr><td colspan="5" class="loading-cell">Failed to load notifications</td></tr>';
654:         return;
655:     }
656:     const items = resp.data.notifications || resp.data || [];
657:     if (items.length === 0) {
658:         tbody.innerHTML = '<tr><td colspan="5" class="loading-cell">No notifications yet</td></tr>';
659:         return;
660:     }
661:     tbody.innerHTML = items.map(n => {
662:         const time = n.created_at ? new Date(n.created_at).toLocaleString() : '—';
663:         const eventIcon = {
664:             'order.created': '📨',
665:             'order.payment_completed': '✅',
666:             'order.payment_failed': '❌',
667:         }[n.event_type] || '📩';
668:         return `
669:         <tr>
670:             <td><span class="evt-type-badge">${eventIcon} ${escHtml(n.event_type)}</span></td>
671:             <td style="font-family:'JetBrains Mono',monospace; color:var(--accent)">${escHtml(n.order_id || '—')}</td>
672:             <td>${escHtml(n.channel || n.notification_type || '—')}</td>
673:             <td><span class="status-badge ${n.status === 'sent' ? 'completed' : n.status}">${escHtml(n.status || '—')}</span></td>
674:             <td style="font-size:0.8rem; color:var(--text-muted)">${time}</td>
675:         </tr>`;
676:     }).join('');
677: }
678: 
679: async function loadInventoryLog() {
680:     const resp = await invApi('/inventory/log?limit=30');
681:     const tbody = document.getElementById('inventory-log-tbody');
682:     if (!resp.ok) {
683:         tbody.innerHTML = '<tr><td colspan="5" class="loading-cell">Failed to load inventory log</td></tr>';
684:         return;
685:     }
686:     const items = resp.data.log || resp.data || [];
687:     if (items.length === 0) {
688:         tbody.innerHTML = '<tr><td colspan="5" class="loading-cell">No inventory changes yet</td></tr>';
689:         return;
690:     }
691:     tbody.innerHTML = items.map(e => {
692:         const time = e.created_at ? new Date(e.created_at).toLocaleString() : '—';
693:         const actionIcon = e.action === 'reserve' ? '📥' : (e.action === 'release' ? '📤' : '🔄');
694:         const qtyClass = e.quantity_change < 0 ? 'stock low' : 'stock ok';
695:         return `
696:         <tr>
697:             <td><span class="evt-type-badge">${actionIcon} ${escHtml(e.action || '—')}</span></td>
698:             <td style="text-align:center">#${e.product_id || '—'}</td>
699:             <td class="${qtyClass}" style="text-align:center">${e.quantity_change > 0 ? '+' : ''}${e.quantity_change ?? '—'}</td>
700:             <td style="font-family:'JetBrains Mono',monospace; color:var(--accent); font-size:0.78rem">${escHtml(e.order_id || '—')}</td>
701:             <td style="font-size:0.8rem; color:var(--text-muted)">${time}</td>
702:         </tr>`;
703:     }).join('');
704: }
705: 
706: // Events tab refresh button
707: document.getElementById('btn-reload-events')?.addEventListener('click', () => loadEventsTab());
</file>

