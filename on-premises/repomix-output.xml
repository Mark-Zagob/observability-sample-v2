<file path="applications-vm/applications/docker-compose.yml">
  1: # ============================================================
  2: # Applications VM — Microservices + Infrastructure
  3: # ============================================================
  4: # Chạy trên VM: 192.168.100.57
  5: # OTLP traces/metrics → OTel Collector trên Observability VM
  6: # ============================================================
  7: 
  8: services:
  9:   # ==========================================================
 10:   # INFRASTRUCTURE — Database + Cache
 11:   # ==========================================================
 12: 
 13:   postgres:
 14:     image: postgres:16-alpine
 15:     container_name: postgres
 16:     environment:
 17:       POSTGRES_DB: orders
 18:       POSTGRES_USER: app
 19:       POSTGRES_PASSWORD: app_secret
 20:     ports:
 21:       - "5432:5432"
 22:     volumes:
 23:       - postgres_data:/var/lib/postgresql/data
 24:       - ./init.sql:/docker-entrypoint-initdb.d/init.sql
 25:     healthcheck:
 26:       test: ["CMD-SHELL", "pg_isready -U app -d orders"]
 27:       interval: 5s
 28:       timeout: 3s
 29:       retries: 5
 30:     networks:
 31:       - observability
 32: 
 33:   redis:
 34:     image: redis:7-alpine
 35:     container_name: redis
 36:     ports:
 37:       - "6379:6379"
 38:     healthcheck:
 39:       test: ["CMD", "redis-cli", "ping"]
 40:       interval: 5s
 41:       timeout: 3s
 42:       retries: 5
 43:     networks:
 44:       - observability
 45: 
 46:   # ==========================================================
 47:   # MICROSERVICES (multi-stage build, security hardened)
 48:   # ==========================================================
 49: 
 50:   api-gateway:
 51:     build:
 52:       context: .
 53:       dockerfile: api-gateway/Dockerfile
 54:     container_name: api-gateway
 55:     environment:
 56:       - OTEL_EXPORTER_OTLP_ENDPOINT=192.168.100.55:4317
 57:       - ORDER_SERVICE_URL=http://order-service:5001
 58:     ports:
 59:       - "5000:5000"
 60:     depends_on:
 61:       order-service:
 62:         condition: service_started
 63:     # --- Security hardening ---
 64:     read_only: true
 65:     tmpfs:
 66:       - /tmp
 67:     cap_drop:
 68:       - ALL
 69:     security_opt:
 70:       - no-new-privileges:true
 71:     networks:
 72:       - observability
 73: 
 74:   order-service:
 75:     build:
 76:       context: .
 77:       dockerfile: order-service/Dockerfile
 78:     container_name: order-service
 79:     environment:
 80:       - OTEL_EXPORTER_OTLP_ENDPOINT=192.168.100.55:4317
 81:       - PAYMENT_SERVICE_URL=http://payment-service:5002
 82:       # secretlint-disable-next-line
 83:       - DATABASE_URL=postgresql://app:app_secret@postgres:5432/orders
 84:       - REDIS_URL=redis://redis:6379/0
 85:       - KAFKA_BOOTSTRAP_SERVERS=kafka:9092
 86:     ports:
 87:       - "5001:5001"
 88:     depends_on:
 89:       postgres:
 90:         condition: service_healthy
 91:       redis:
 92:         condition: service_healthy
 93:       kafka:
 94:         condition: service_healthy
 95:     # --- Security hardening ---
 96:     read_only: true
 97:     tmpfs:
 98:       - /tmp
 99:     cap_drop:
100:       - ALL
101:     security_opt:
102:       - no-new-privileges:true
103:     networks:
104:       - observability
105: 
106:   payment-service:
107:     build:
108:       context: .
109:       dockerfile: payment-service/Dockerfile
110:     container_name: payment-service
111:     environment:
112:       - OTEL_EXPORTER_OTLP_ENDPOINT=192.168.100.55:4317
113:     ports:
114:       - "5002:5002"
115:     # --- Security hardening ---
116:     read_only: true
117:     tmpfs:
118:       - /tmp
119:     cap_drop:
120:       - ALL
121:     security_opt:
122:       - no-new-privileges:true
123:     networks:
124:       - observability
125: 
126:   # ==========================================================
127:   # KAFKA — Event Streaming Platform (KRaft mode)
128:   # ==========================================================
129: 
130:   kafka:
131:     image: apache/kafka:3.7.0
132:     container_name: kafka
133:     environment:
134:       # KRaft mode (no ZooKeeper)
135:       KAFKA_NODE_ID: 1
136:       KAFKA_PROCESS_ROLES: broker,controller
137:       KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
138:       KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
139:       # Listeners
140:       KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
141:       KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092
142:       KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
143:       KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
144:       # Cluster
145:       CLUSTER_ID: "MkU3OEVBNTcwNTJENDM2Qk"
146:       # Topic defaults
147:       KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
148:       KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
149:       KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
150:       KAFKA_NUM_PARTITIONS: 3
151:       KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
152:       KAFKA_LOG_RETENTION_HOURS: 24
153:       # JMX for monitoring
154:       KAFKA_JMX_PORT: 9101
155:       KAFKA_JMX_HOSTNAME: kafka
156:     ports:
157:       - "9092:9092"
158:     volumes:
159:       - kafka_data:/var/lib/kafka/data
160:     healthcheck:
161:       test: [
162:         "CMD-SHELL",
163:         "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 > /dev/null 2>&1"
164:       ]
165:       interval: 10s
166:       timeout: 10s
167:       retries: 10
168:       start_period: 30s
169:     networks:
170:       - observability
171: 
172:   kafka-exporter:
173:     image: danielqsj/kafka-exporter:latest
174:     container_name: kafka-exporter
175:     command:
176:       - "--kafka.server=kafka:9092"
177:       - "--topic.filter=.*"
178:       - "--group.filter=.*"
179:     ports:
180:       - "9308:9308"
181:     depends_on:
182:       kafka:
183:         condition: service_healthy
184:     restart: unless-stopped
185:     networks:
186:       - observability
187: 
188:   kafka-ui:
189:     image: provectuslabs/kafka-ui:latest
190:     container_name: kafka-ui
191:     environment:
192:       KAFKA_CLUSTERS_0_NAME: observability-lab
193:       KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS: kafka:9092
194:       DYNAMIC_CONFIG_ENABLED: "true"
195:     ports:
196:       - "8585:8080"
197:     depends_on:
198:       kafka:
199:         condition: service_healthy
200:     restart: unless-stopped
201:     networks:
202:       - observability
203: 
204:   # ==========================================================
205:   # KAFKA EVENT WORKERS (security hardened)
206:   # ==========================================================
207: 
208:   notification-worker:
