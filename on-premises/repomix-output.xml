{container_name="grafana"} |= "error"

# Filter loại trừ
{compose_service="loki"} != "healthcheck"

# Regex filter
{container_name=~".*exporter.*"} |~ "(?i)warn|error"

# Đếm logs/phút theo container
sum by(container_name) (count_over_time({compose_project=~".+"}[1m]))

