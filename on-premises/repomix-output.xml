  1: """
  2: ============================================================
  3: Order Service — Phase 5 + Shared Refactor
  4: ============================================================
  5: Xử lý đơn hàng với PostgreSQL persistence và Redis cache.
  6: 
  7: Features:
  8:   - PostgreSQL: persist orders, query products (with connection pool)
  9:   - Redis: cache-aside pattern cho product catalog (TTL 60s)
 10:   - OTel auto-instrumentation: psycopg2 + redis → spans tự động
 11:   - Custom metrics: connection pool, cache hit/miss, query duration
 12:   - Kafka event publishing with trace context
 13:   - Health checks: /health/live, /health/ready
 14: ============================================================
 15: """
 16: 
 17: import os
 18: import time
 19: import json
 20: import random
 21: import uuid
 22: import requests
 23: from confluent_kafka import Producer as KafkaProducer
 24: from flask import Flask, jsonify, request as flask_request
 25: 
 26: # ----------------------------------------------------------
 27: # Shared modules
 28: # ----------------------------------------------------------
 29: from shared.logging_config import setup_logging
 30: from shared.otel_setup import init_otel
 31: from shared.db_utils import DatabasePool, RedisCache, retry_connect
 32: from shared.health import create_health_blueprint
 33: from shared.errors import problem_response
 34: 
 35: # ----------------------------------------------------------
 36: # Auto-instrumentation imports
 37: # ----------------------------------------------------------
 38: from opentelemetry.instrumentation.flask import FlaskInstrumentor
 39: from opentelemetry.instrumentation.requests import RequestsInstrumentor
 40: from opentelemetry.instrumentation.psycopg2 import Psycopg2Instrumentor
 41: from opentelemetry.instrumentation.redis import RedisInstrumentor
 42: from opentelemetry.propagate import inject
 43: from opentelemetry.metrics import Observation
 44: 
 45: # ----------------------------------------------------------
 46: # Initialize logging + OTel
 47: # ----------------------------------------------------------
 48: logger = setup_logging("order-service")
 49: tracer, meter = init_otel("order-service", "3.0.0")
 50: 
 51: # Auto-instrumentation BEFORE creating connections
 52: Psycopg2Instrumentor().instrument()
 53: RedisInstrumentor().instrument()
 54: 
 55: # ============================================================
 56: # Custom Metrics
 57: # ============================================================
 58: orders_counter = meter.create_counter(
 59:     name="orders_created_total",
 60:     description="Total orders created",
 61:     unit="1",
 62: )
 63: 
 64: order_duration = meter.create_histogram(
 65:     name="order_processing_duration_seconds",
 66:     description="Order processing duration in seconds",
 67:     unit="s",
 68: )
 69: 
 70: db_query_duration = meter.create_histogram(
 71:     name="db_query_duration_seconds",
 72:     description="Database query duration in seconds",
 73:     unit="s",
 74: )
 75: 
 76: db_pool_active = meter.create_up_down_counter(
 77:     name="db_connection_pool_active",
 78:     description="Active database connections in pool",
 79:     unit="1",
 80: )
 81: 
 82: DB_POOL_MAX = 10  # must match maxconn in DatabasePool init below
 83: 
 84: def _pool_max_callback(options):
 85:     yield Observation(DB_POOL_MAX)
 86: 
 87: meter.create_observable_gauge(
 88:     name="db_connection_pool_max",
 89:     description="Maximum database connections in pool",
 90:     unit="1",
 91:     callbacks=[_pool_max_callback],
 92: )
 93: 
 94: cache_ops_counter = meter.create_counter(
 95:     name="cache_operations_total",
 96:     description="Cache operations (hit/miss/set/error)",
 97:     unit="1",
 98: )
 99: 
100: cache_duration = meter.create_histogram(
101:     name="cache_operation_duration_seconds",
102:     description="Cache operation latency",
103:     unit="s",
104: )
105: 
106: kafka_produced_counter = meter.create_counter(
107:     name="kafka_messages_produced_total",
108:     description="Total Kafka messages produced",
109:     unit="1",
110: )
111: 
112: inventory_checks_counter = meter.create_counter(
113:     name="inventory_checks_total",
114:     description="Total inventory stock checks by result",
115:     unit="1",
116: )
117: 
118: # ============================================================
119: # Database + Cache (using shared helpers)
120: # ============================================================
121: # secretlint-disable-next-line
122: DATABASE_URL = os.getenv("DATABASE_URL", "postgresql://app:app_secret@postgres:5432/orders")
123: REDIS_URL = os.getenv("REDIS_URL", "redis://redis:6379/0")
124: 
125: db = DatabasePool(DATABASE_URL, minconn=2, maxconn=DB_POOL_MAX,
126:                   pool_active_counter=db_pool_active,
127:                   query_duration_histogram=db_query_duration)
128: cache = RedisCache(REDIS_URL, ttl=60, cache_ops_counter=cache_ops_counter,
129:                    cache_duration=cache_duration)
130: 
131: # ============================================================
132: # Kafka Producer Setup
133: # ============================================================
134: KAFKA_BOOTSTRAP = os.getenv("KAFKA_BOOTSTRAP_SERVERS", "kafka:9092")
135: KAFKA_TOPIC = "order.events"
136: 
137: kafka_producer = None
138: 
139: 
140: def get_kafka_producer():
141:     """Lazy init Kafka producer with retry"""
142:     global kafka_producer
143:     if kafka_producer is None:
144:         def _connect():
145:             producer = KafkaProducer({
146:                 "bootstrap.servers": KAFKA_BOOTSTRAP,
147:                 "client.id": "order-service",
148:                 "acks": "all",
149:                 "retries": 3,
150:                 "retry.backoff.ms": 100,
151:             })
152:             producer.list_topics(timeout=5)
153:             return producer
154:         logger.info("Initializing Kafka producer", extra={"bootstrap": KAFKA_BOOTSTRAP})
155:         kafka_producer = retry_connect("Kafka", _connect)
156:     return kafka_producer
157: 
158: 
159: def kafka_delivery_callback(err, msg):
160:     """Callback for Kafka produce delivery report"""
161:     if err:
162:         logger.error("Kafka delivery failed",
163:                      extra={"topic": msg.topic(), "error": str(err)})
164:         kafka_produced_counter.add(1, {"status": "failed", "topic": msg.topic()})
165:     else:
166:         logger.info("Kafka message delivered",
167:                     extra={"topic": msg.topic(), "partition": msg.partition(),
168:                            "offset": msg.offset()})
169:         kafka_produced_counter.add(1, {"status": "success", "topic": msg.topic()})
170: 
171: 
172: def publish_event(event_type, order_id, data):
173:     """Publish event to Kafka with trace context propagation"""
174:     event = {
175:         "event_type": event_type,
176:         "event_id": str(uuid.uuid4()),
177:         "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
178:         "order_id": order_id,
179:         "data": data,
180:     }
181: 
182:     # Inject trace context into Kafka headers
183:     headers = {}
184:     inject(headers)
185:     kafka_headers = [(k, v.encode("utf-8") if isinstance(v, str) else v)
186:                      for k, v in headers.items()]
187: 
188:     with tracer.start_as_current_span("kafka.produce") as span:
189:         span.set_attribute("messaging.system", "kafka")
190:         span.set_attribute("messaging.destination", KAFKA_TOPIC)
191:         span.set_attribute("messaging.operation", "publish")
192:         span.set_attribute("event.type", event_type)
193:         span.set_attribute("order.id", order_id)
194: 
195:         try:
196:             producer = get_kafka_producer()
197:             producer.produce(
198:                 topic=KAFKA_TOPIC,
199:                 key=order_id.encode("utf-8"),
200:                 value=json.dumps(event).encode("utf-8"),
201:                 headers=kafka_headers,
202:                 callback=kafka_delivery_callback,
203:             )
204:             producer.poll(0)
205:             logger.info("Event published to Kafka",
206:                         extra={"event_type": event_type, "order_id": order_id,
207:                                "topic": KAFKA_TOPIC})
208:         except Exception as e:
209:             span.set_attribute("error", True)
210:             logger.error("Failed to publish Kafka event",
211:                          extra={"event_type": event_type, "order_id": order_id,
212:                                 "error": str(e)})
213: 
214: 
215: # ============================================================
216: # Flask App
217: # ============================================================
218: app = Flask(__name__)
219: FlaskInstrumentor().instrument_app(app)
220: RequestsInstrumentor().instrument()
221: 
222: PAYMENT_SERVICE = os.getenv("PAYMENT_SERVICE_URL", "http://payment-service:5002")
223: 
224: # --- Health checks ---
225: health_bp = create_health_blueprint("order-service", checks={
226:     "db": lambda: db.check_health(),
227:     "cache": lambda: cache.check_health(),
228: })
229: app.register_blueprint(health_bp)
230: 
231: 
232: @app.route("/products")
233: def list_products():
234:     """List product catalog (cache-aside pattern)"""
235:     with tracer.start_as_current_span("get_product_catalog") as span:
236:         # 1. Try cache first
237:         products = cache.get("product:catalog")
238: 
239:         if products is not None:
240:             span.set_attribute("cache.hit", True)
241:             span.set_attribute("products.count", len(products))
242:             return jsonify({"products": products, "source": "cache"})
243: 
244:         # 2. Cache miss → query DB
245:         span.set_attribute("cache.hit", False)
246:         logger.info("Fetching products from database")
247: 
248:         rows = db.execute("SELECT id, name, price, stock, category FROM products ORDER BY id")
249:         products = [dict(row) for row in rows]
250: 
251:         # Convert Decimal to float for JSON
252:         for p in products:
253:             p["price"] = float(p["price"])
254: 
255:         # 3. Set cache
256:         cache.set("product:catalog", products)
257: 
258:         span.set_attribute("products.count", len(products))
259:         return jsonify({"products": products, "source": "database"})
260: 
261: 
262: @app.route("/orders")
263: def list_orders():
264:     """List recent orders"""
265:     with tracer.start_as_current_span("list_recent_orders") as span:
266:         limit = flask_request.args.get("limit", 20, type=int)
267:         rows = db.execute(
268:             "SELECT order_id, product_name, quantity, total_amount, status, "
269:             "payment_txn_id, created_at FROM orders ORDER BY created_at DESC LIMIT %s",
270:             (limit,)
271:         )
272:         orders = []
273:         for row in rows:
274:             o = dict(row)
275:             o["total_amount"] = float(o["total_amount"])
276:             o["created_at"] = o["created_at"].isoformat()
277:             orders.append(o)
278:         span.set_attribute("orders.count", len(orders))
279:         return jsonify({"orders": orders, "count": len(orders)})
280: 
281: 
282: @app.route("/process", methods=["GET", "POST"])
283: def process_order():
284:     """Xử lý đơn hàng — with real DB persistence"""
285:     start_time = time.time()
286:     order_id = str(uuid.uuid4())[:8]
287:     order_status = "completed"
288: 
289:     # Parse request body
290:     if flask_request.method == "POST" and flask_request.is_json:
291:         data = flask_request.get_json()
292:         product_id = data.get("product_id", random.randint(1, 5))
293:         quantity = data.get("quantity", random.randint(1, 3))
294:     else:
295:         product_id = random.randint(1, 5)
296:         quantity = random.randint(1, 3)
297: 
298:     logger.info("Processing new order",
299:                  extra={"order_id": order_id, "product_id": product_id, "quantity": quantity})
300: 
301:     # Step 1: Get product info (from cache or DB)
302:     with tracer.start_as_current_span("get_product_info") as span:
303:         span.set_attribute("product.id", product_id)
304: 
305:         product = None
306:         cached_catalog = cache.get("product:catalog")
307:         if cached_catalog:
308:             for p in cached_catalog:
309:                 if p["id"] == product_id:
310:                     product = p
311:                     break
312: 
313:         if product is None:
314:             rows = db.execute("SELECT id, name, price, stock FROM products WHERE id = %s",
315:                               (product_id,))
316:             if rows:
317:                 product = dict(rows[0])
318:                 product["price"] = float(product["price"])
319:             else:
320:                 return problem_response(
321:                     404, "Product Not Found",
322:                     f"Product with id {product_id} does not exist",
323:                     instance="/process",
324:                     extra={"order_id": order_id},
325:                 )
326: 
327:         span.set_attribute("product.name", product["name"])
328:         span.set_attribute("product.price", product["price"])
329: 
330:     # Step 2: Check inventory
331:     with tracer.start_as_current_span("check_inventory") as span:
332:         rows = db.execute("SELECT stock FROM products WHERE id = %s", (product_id,))
333:         current_stock = rows[0]["stock"] if rows else 0
334:         in_stock = current_stock >= quantity
335: 
336:         span.set_attribute("inventory.current_stock", current_stock)
337:         span.set_attribute("inventory.requested", quantity)
338:         span.set_attribute("inventory.in_stock", in_stock)
339: 
340:         check_result = "in_stock" if in_stock else "out_of_stock"
341:         inventory_checks_counter.add(1, {"result": check_result})
342: 
343:         logger.info("Inventory checked",
344:                      extra={"order_id": order_id, "product_id": product_id,
345:                             "stock": current_stock, "in_stock": in_stock})
346: 
347:         if not in_stock:
348:             order_status = "out_of_stock"
349:             orders_counter.add(1, {"status": order_status})
350: 
351:             # Publish stock.depleted event so inventory-worker can auto-restock
352:             publish_event("stock.depleted", order_id, {
353:                 "product_id": product_id,
354:                 "product_name": product["name"],
355:                 "current_stock": current_stock,
356:                 "quantity_requested": quantity,
357:             })
358: 
359:             return problem_response(
360:                 409, "Out of Stock",
361:                 f"Insufficient stock for {product['name']} (have {current_stock}, need {quantity})",
362:                 instance="/process",
363:                 extra={"order_id": order_id, "product_id": product_id,
364:                        "stock_available": current_stock, "quantity_requested": quantity},
365:             )
366: 
367:     total_amount = round(product["price"] * quantity, 2)
368: 
369:     # Step 3: Insert order into DB
370:     with tracer.start_as_current_span("insert_order") as span:
371:         span.set_attribute("order.id", order_id)
372:         span.set_attribute("order.total_amount", total_amount)
373: 
374:         db.execute(
375:             "INSERT INTO orders (order_id, product_id, product_name, quantity, total_amount, status) "
376:             "VALUES (%s, %s, %s, %s, %s, %s)",
377:             (order_id, product_id, product["name"], quantity, total_amount, "pending"),
378:             fetch=False
379:         )
380:         logger.info("Order inserted into database",
381:                      extra={"order_id": order_id, "total_amount": total_amount})
382: 
383:     # Step 4: Update stock
384:     with tracer.start_as_current_span("update_stock") as span:
385:         db.execute(
386:             "UPDATE products SET stock = stock - %s WHERE id = %s AND stock >= %s",
387:             (quantity, product_id, quantity),
388:             fetch=False
389:         )
390:         span.set_attribute("stock.deducted", quantity)
391: 
392:         # Invalidate product cache since stock changed
393:         cache.delete("product:catalog")
394: 
395:     # Step 5: Process payment
396:     payment = {"status": "skipped"}
397:     with tracer.start_as_current_span("request_payment") as span:
398:         try:
399:             resp = requests.post(
400:                 f"{PAYMENT_SERVICE}/charge",
401:                 json={"order_id": order_id, "amount": total_amount},
402:                 timeout=5,
403:             )
404:             payment = resp.json()
405:             payment_status = payment.get("status", "unknown")
406:             span.set_attribute("payment.status", payment_status)
407: 
408:             if resp.status_code != 200:
409:                 order_status = "payment_failed"
410:             else:
411:                 # Update order with payment info
412:                 txn_id = payment.get("transaction_id", "")
413:                 db.execute(
414:                     "UPDATE orders SET status = %s, payment_txn_id = %s, updated_at = NOW() "
415:                     "WHERE order_id = %s",
416:                     (order_status, txn_id, order_id),
417:                     fetch=False
418:                 )
419: 
420:             logger.info("Payment processed",
421:                          extra={"order_id": order_id, "payment_status": payment_status})
422: 
423:         except Exception as e:
424:             span.set_attribute("error", True)
425:             order_status = "payment_error"
426:             payment = {"status": "failed", "error": str(e)}
427:             logger.error("Payment request failed",
428:                           extra={"order_id": order_id, "error": str(e)})
429: 
430:     # ── Publish Kafka events ──
431:     event_data = {
432:         "product_id": product_id,
433:         "product_name": product["name"],
434:         "quantity": quantity,
435:         "total_amount": total_amount,
436:     }
437: 
438:     publish_event("order.created", order_id, event_data)
439: 
440:     if order_status == "completed":
441:         event_data["payment_status"] = "success"
442:         event_data["transaction_id"] = payment.get("transaction_id", "")
443:         publish_event("order.payment_completed", order_id, event_data)
444:     elif order_status in ("payment_failed", "payment_error"):
445:         event_data["payment_status"] = "failed"
446:         event_data["error"] = payment.get("error", "unknown")
447:         publish_event("order.payment_failed", order_id, event_data)
448: 
449:     # Flush Kafka producer
450:     try:
451:         get_kafka_producer().flush(timeout=2)
452:     except Exception:
453:         pass
454: 
455:     # Record metrics
456:     duration = time.time() - start_time
457:     orders_counter.add(1, {"status": order_status})
458:     order_duration.record(duration, {"status": order_status})
459: 
460:     logger.info("Order completed",
461:                  extra={"order_id": order_id, "status": order_status,
462:                         "duration_ms": int(duration * 1000),
463:                         "product": product["name"], "total_amount": total_amount})
464: 
465:     return jsonify({
466:         "order_id": order_id,
467:         "product": product["name"],
468:         "quantity": quantity,
469:         "total_amount": total_amount,
470:         "payment": payment,
471:         "status": order_status,
472:     })
473: 
474: 
475: if __name__ == "__main__":
476:     logger.info("Order Service starting (dev mode)",
477:                  extra={"port": 5001, "db": DATABASE_URL.split("@")[1],
478:                         "redis_url": REDIS_URL})
479:     logger.warning("Use gunicorn for production: gunicorn -w 4 -b 0.0.0.0:5001 app:app")
480:     app.run(host="0.0.0.0", port=5001)
