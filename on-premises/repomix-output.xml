<file path="applications-vm/applications/shared/otel_setup.py">
 1: """
 2: OpenTelemetry setup — shared across all services.
 3: Initializes tracing, metrics, and common auto-instrumentation.
 4: """
 5: import os
 6: 
 7: from opentelemetry import trace, metrics
 8: from opentelemetry.sdk.trace import TracerProvider
 9: from opentelemetry.sdk.trace.export import BatchSpanProcessor
10: from opentelemetry.sdk.metrics import MeterProvider
11: from opentelemetry.sdk.metrics.export import PeriodicExportingMetricReader
12: from opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter
13: from opentelemetry.exporter.otlp.proto.grpc.metric_exporter import OTLPMetricExporter
14: from opentelemetry.sdk.resources import Resource
15: from opentelemetry.instrumentation.logging import LoggingInstrumentor
16: from opentelemetry.propagate import set_global_textmap
17: from opentelemetry.propagators.composite import CompositePropagator
18: from opentelemetry.trace.propagation.tracecontext import TraceContextTextMapPropagator
19: 
20: 
21: def init_otel(service_name, service_version="1.0.0"):
22:     """Initialize OpenTelemetry tracing + metrics for a service.
23: 
24:     Args:
25:         service_name: Name for traces/metrics (e.g., "order-service")
26:         service_version: Service version string
27: 
28:     Returns:
29:         (tracer, meter) tuple
30:     """
31:     endpoint = os.getenv("OTEL_EXPORTER_OTLP_ENDPOINT", "otel-collector:4317")
32: 
33:     resource = Resource.create({
34:         "service.name": service_name,
35:         "service.version": service_version,
36:     })
37: 
38:     # --- Tracing ---
39:     trace_provider = TracerProvider(resource=resource)
40:     trace_provider.add_span_processor(
41:         BatchSpanProcessor(OTLPSpanExporter(endpoint=endpoint, insecure=True))
42:     )
43:     trace.set_tracer_provider(trace_provider)
44:     set_global_textmap(CompositePropagator([TraceContextTextMapPropagator()]))
45: 
46:     # --- Metrics ---
47:     metric_reader = PeriodicExportingMetricReader(
48:         OTLPMetricExporter(endpoint=endpoint, insecure=True),
49:         export_interval_millis=10000,
50:     )
51:     meter_provider = MeterProvider(resource=resource, metric_readers=[metric_reader])
52:     metrics.set_meter_provider(meter_provider)
53: 
54:     # --- Logging injection ---
55:     LoggingInstrumentor().instrument(set_logging_format=True)
56: 
57:     return trace.get_tracer(service_name), metrics.get_meter(service_name)
</file>

