626: 
627: @keyframes toastIn  { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
628: @keyframes toastOut { to   { opacity: 0; transform: translateX(40px); } }
629: 
630: /* ---------- Load Test Tab ---------- */
631: .lt-status-badge {
