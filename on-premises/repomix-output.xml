<file path="applications-vm/agents/alloy/config.alloy">
  1: // ============================================================
  2: // Grafana Alloy — Applications VM (192.168.100.57)
  3: // ============================================================
  4: // Thu thập logs từ VM chạy app và push về Loki trên
  5: // Observability VM (192.168.100.55:3100)
  6: //
  7: // Pipeline:
  8: //   Source → Process (parse, extract, filter) → Push Loki
  9: // ============================================================
 10: 
 11: // ============================================================
 12: // PHẦN 1: DOCKER CONTAINER LOGS
 13: // ============================================================
 14: 
 15: discovery.docker "containers" {
 16:   host = "unix:///var/run/docker.sock"
 17: }
 18: 
 19: discovery.relabel "docker_labels" {
 20:   targets = discovery.docker.containers.targets
 21: 
 22:   rule {
 23:     source_labels = ["__meta_docker_container_name"]
 24:     regex         = "/(.*)"
 25:     target_label  = "container_name"
 26:   }
 27: 
 28:   rule {
 29:     source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
 30:     target_label  = "compose_project"
 31:   }
 32: 
 33:   rule {
 34:     source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
 35:     target_label  = "compose_service"
 36:   }
 37: }
 38: 
 39: loki.source.docker "containers" {
 40:   host       = "unix:///var/run/docker.sock"
 41:   targets    = discovery.relabel.docker_labels.output
 42:   forward_to = [loki.process.docker_pipeline.receiver]
 43: }
 44: 
 45: // ============================================================
 46: // LOG PROCESSING PIPELINE — Docker containers
 47: // ============================================================
 48: 
 49: loki.process "docker_pipeline" {
 50:   // Drop health check logs
 51:   stage.drop {
 52:     expression = "(?i)(GET|HEAD)\\s+/(health|ready|healthz|livez|readyz)"
 53:     drop_counter_reason = "health_check"
 54:   }
 55: 
 56:   // Parse JSON logs
 57:   stage.json {
 58:     expressions = {
 59:       level    = "level",
 60:       msg      = "msg",
 61:       caller   = "caller",
 62:       trace_id = "trace_id",
 63:       span_id  = "span_id",
 64:     }
 65:   }
 66: 
 67:   // Parse logfmt (fallback)
 68:   stage.logfmt {
 69:     mapping = {
 70:       level  = "",
 71:       msg    = "",
 72:       caller = "",
 73:       ts     = "",
 74:     }
 75:   }
 76: 
 77:   // Chuẩn hoá log level → lowercase
 78:   stage.template {
 79:     source   = "level"
 80:     template = "{{ ToLower .Value }}"
 81:   }
 82: 
 83:   stage.replace {
 84:     expression = "warning"
 85:     source     = "level"
 86:     replace    = "warn"
 87:   }
 88: 
 89:   // Gán detected_level label
 90:   stage.labels {
 91:     values = {
 92:       detected_level = "level",
 93:     }
 94:   }
 95: 
 96:   // Static labels — đánh dấu VM nguồn
 97:   stage.static_labels {
 98:     values = {
 99:       source = "docker",
100:       vm     = "app",
101:     }
102:   }
103: 
104:   // Drop debug logs (comment out nếu cần debug)
105:   stage.drop {
106:     source              = "level"
107:     expression          = "debug"
108:     drop_counter_reason = "debug_level"
109:   }
110: 
111:   forward_to = [loki.write.loki_endpoint.receiver]
112: }
113: 
114: // ============================================================
115: // PHẦN 2: HOST SYSTEM LOGS
116: // ============================================================
117: 
118: local.file_match "syslog" {
119:   path_targets = [{
120:     __path__  = "/var/log/host/syslog",
121:     job       = "syslog",
122:     log_type  = "system",
123:   }]
124: }
125: 
126: loki.source.file "syslog" {
127:   targets    = local.file_match.syslog.targets
128:   forward_to = [loki.process.host_pipeline.receiver]
129: }
130: 
131: local.file_match "auth_log" {
132:   path_targets = [{
133:     __path__  = "/var/log/host/auth.log",
134:     job       = "auth",
135:     log_type  = "security",
136:   }]
137: }
138: 
139: loki.source.file "auth_log" {
140:   targets    = local.file_match.auth_log.targets
141:   forward_to = [loki.process.host_pipeline.receiver]
142: }
143: 
144: // ============================================================
145: // LOG PROCESSING PIPELINE — Host logs
146: // ============================================================
147: 
148: loki.process "host_pipeline" {
149:   stage.regex {
150:     expression = "^\\w+\\s+\\d+\\s+[\\d:]+\\s+(?P<hostname>\\S+)\\s+(?P<syslog_service>[^\\[\\s:]+)"
151:   }
152: 
153:   stage.labels {
154:     values = {
155:       hostname       = "",
156:       syslog_service = "",
157:     }
158:   }
159: 
160:   stage.regex {
161:     expression = "(?i)(?P<severity>error|fail|panic|crit|warn|alert|emerg)"
162:   }
163: 
164:   stage.template {
165:     source   = "severity"
166:     template = "{{ if .Value }}{{ ToLower .Value }}{{ else }}info{{ end }}"
167:   }
168: 
169:   stage.labels {
170:     values = {
171:       detected_level = "severity",
172:     }
173:   }
174: 
175:   stage.static_labels {
176:     values = {
177:       source = "host",
178:       vm     = "app",
179:     }
180:   }
181: 
182:   forward_to = [loki.write.loki_endpoint.receiver]
183: }
184: 
185: // ============================================================
186: // PUSH VỀ LOKI (Observability VM)
187: // ============================================================
188: 
189: loki.write "loki_endpoint" {
190:   endpoint {
191:     url = "http://192.168.100.55:3100/loki/api/v1/push"
192:   }
193: }
</file>

