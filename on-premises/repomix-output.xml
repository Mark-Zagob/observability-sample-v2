883: .events-worker-badge.down    { background: var(--red-bg); color: var(--red); }
884: 
885: .events-worker-stats {
886:     display: flex;
887:     gap: 20px;
888: }
889: 
890: .events-ws {
891:     display: flex;
892:     flex-direction: column;
893:     align-items: center;
894:     gap: 2px;
895:     flex: 1;
896: }
897: 
898: .events-ws-value {
899:     font-family: 'JetBrains Mono', monospace;
900:     font-size: 1.3rem;
901:     font-weight: 700;
902:     color: var(--text-primary);
903: }
904: 
905: .events-ws-label {
906:     font-size: 0.72rem;
907:     color: var(--text-muted);
908:     text-transform: uppercase;
909:     letter-spacing: 0.04em;
