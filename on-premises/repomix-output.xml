<file path="applications-vm/applications/web-ui/Dockerfile">
FROM nginxinc/nginx-unprivileged:alpine

# === Metadata ===
LABEL maintainer="observability-lab"
LABEL service="web-ui"

# === Application files ===
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY index.html /usr/share/nginx/html/index.html
COPY style.css  /usr/share/nginx/html/style.css
COPY app.js     /usr/share/nginx/html/app.js

# === Health check ===
# Use 127.0.0.1 (not localhost) because nginx-unprivileged
# doesn't enable IPv6 listening, and BusyBox wget resolves
# localhost to ::1 first → "Connection refused".
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1

EXPOSE 8080
</file>

