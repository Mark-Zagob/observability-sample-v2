      "type": "timeseries",
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\",vm=~\"$vm\"}",
          "legendFormat": "{{ vm }} Available Now"
        },
        {
          "expr": "predict_linear(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\",vm=~\"$vm\"}[1d], 24*3600)",
          "legendFormat": "{{ vm }} Predicted (24h)"
