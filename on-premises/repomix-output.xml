<file path="applications-vm/applications/inventory-worker/app.py">
  1: """
  2: ============================================================
  3: Inventory Worker — Kafka Consumer + Shared Refactor
  4: ============================================================
  5: Consume events từ topic 'order.events' và cập nhật stock.
  6: 
  7: Handles:
  8:   - order.created → Reserve stock (giảm stock)
  9:   - order.payment_failed → Release stock (hoàn stock)
 10: 
 11: Features:
 12:   - Idempotency via processed_events table
 13:   - Pessimistic locking (SELECT FOR UPDATE) for stock updates
 14:   - Audit trail via inventory_log table
 15:   - OTel trace context propagation from Kafka headers
 16:   - Health checks: /health/live, /health/ready
 17: ============================================================
 18: """
 19: 
 20: import os
 21: import time
 22: import json
 23: import signal
 24: import threading
 25: import atexit
 26: 
 27: import psycopg2.extras
 28: from confluent_kafka import Consumer, KafkaError
 29: from flask import Flask, jsonify
 30: 
 31: # ----------------------------------------------------------
 32: # Shared modules
 33: # ----------------------------------------------------------
 34: from shared.logging_config import setup_logging
 35: from shared.otel_setup import init_otel
 36: from shared.db_utils import DatabasePool
 37: from shared.kafka_utils import extract_trace_context
 38: from shared.health import create_health_blueprint
 39: 
 40: # ----------------------------------------------------------
 41: # Auto-instrumentation imports
 42: # ----------------------------------------------------------
 43: from opentelemetry import context as otel_context
 44: from opentelemetry.instrumentation.flask import FlaskInstrumentor
 45: from opentelemetry.instrumentation.psycopg2 import Psycopg2Instrumentor
 46: 
 47: # ----------------------------------------------------------
 48: # Initialize logging + OTel
 49: # ----------------------------------------------------------
 50: logger = setup_logging("inventory-worker")
 51: tracer, meter = init_otel("inventory-worker", "1.0.0")
 52: Psycopg2Instrumentor().instrument()
 53: 
 54: # ============================================================
 55: # Custom Metrics
 56: # ============================================================
 57: inventory_updates_counter = meter.create_counter(
 58:     name="inventory_updates_total",
 59:     description="Total inventory updates",
 60:     unit="1",
 61: )
 62: 
 63: inventory_processing_duration = meter.create_histogram(
 64:     name="inventory_processing_duration_seconds",
 65:     description="Inventory update processing duration",
 66:     unit="s",
 67: )
 68: 
 69: events_consumed_counter = meter.create_counter(
 70:     name="kafka_events_consumed_total",
 71:     description="Total Kafka events consumed",
 72:     unit="1",
 73: )
 74: 
 75: stock_update_errors = meter.create_counter(
 76:     name="inventory_errors_total",
 77:     description="Total inventory update errors",
 78:     unit="1",
 79: )
 80: 
 81: stock_restock_counter = meter.create_counter(
 82:     name="inventory_restock_total",
 83:     description="Total automatic restocks triggered",
 84:     unit="1",
 85: )
 86: 
 87: # ============================================================
 88: # Config
 89: # ============================================================
 90: KAFKA_BOOTSTRAP = os.getenv("KAFKA_BOOTSTRAP_SERVERS", "kafka:9092")
 91: KAFKA_TOPIC = os.getenv("KAFKA_TOPIC", "order.events")
 92: KAFKA_GROUP = "inventory-workers"
 93: # secretlint-disable-next-line
 94: DATABASE_URL = os.getenv("DATABASE_URL", "postgresql://app:app_secret@postgres:5432/orders")
 95: 
 96: # Auto-restock config
 97: RESTOCK_THRESHOLD = int(os.getenv("RESTOCK_THRESHOLD", "10"))
 98: RESTOCK_AMOUNT = int(os.getenv("RESTOCK_AMOUNT", "100"))
 99: 
100: # ============================================================
101: # Database (shared helper)
102: # ============================================================
103: db = DatabasePool(DATABASE_URL, minconn=2, maxconn=5)
104: 
105: 
106: def is_event_processed(event_id):
107:     """Check if event was already processed (idempotency)"""
108:     rows = db.execute(
109:         "SELECT 1 FROM processed_events WHERE event_id = %s AND processed_by = %s",
110:         (event_id, "inventory-worker")
111:     )
112:     return len(rows) > 0
113: 
114: 
115: def mark_event_processed(event_id, event_type):
116:     """Mark event as processed"""
117:     db.execute(
118:         "INSERT INTO processed_events (event_id, event_type, processed_by) VALUES (%s, %s, %s)",
119:         (event_id, event_type, "inventory-worker"),
120:         fetch=False
121:     )
122: 
123: 
124: # ============================================================
125: # Auto-Restock Logic
126: # ============================================================
127: def restock_product(product_id, current_stock):
128:     """Automatically restock a product when stock is low."""
129:     with tracer.start_as_current_span("auto_restock") as span:
130:         span.set_attribute("product.id", product_id)
131:         span.set_attribute("stock.current", current_stock)
132:         span.set_attribute("stock.restock_amount", RESTOCK_AMOUNT)
133: 
134:         conn = db.get_conn()
135:         try:
136:             with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
137:                 cur.execute(
138:                     "SELECT id, name, stock FROM products WHERE id = %s FOR UPDATE",
139:                     (product_id,)
140:                 )
141:                 row = cur.fetchone()
142:                 if not row:
143:                     conn.rollback()
144:                     return
145: 
146:                 stock_before = row["stock"]
147:                 # Only restock if still below threshold (avoid race conditions)
148:                 if stock_before >= RESTOCK_THRESHOLD:
149:                     conn.rollback()
150:                     return
151: 
152:                 stock_after = stock_before + RESTOCK_AMOUNT
153:                 cur.execute(
154:                     "UPDATE products SET stock = %s WHERE id = %s",
155:                     (stock_after, product_id)
156:                 )
157: 
158:                 # Audit log with action='restock'
159:                 cur.execute(
160:                     "INSERT INTO inventory_log "
161:                     "(event_id, order_id, product_id, action, quantity, stock_before, stock_after) "
162:                     "VALUES (%s, %s, %s, %s, %s, %s, %s)",
163:                     (f"restock-{product_id}-{int(time.time())}", "restock",
164:                      product_id, "restock", RESTOCK_AMOUNT, stock_before, stock_after)
165:                 )
166:                 conn.commit()
167: 
168:                 stock_restock_counter.add(1, {"product_id": str(product_id)})
169:                 span.set_attribute("stock.after", stock_after)
170:                 logger.info("Auto-restock triggered",
171:                             extra={"product_id": product_id,
172:                                    "product_name": row["name"],
173:                                    "stock_before": stock_before,
174:                                    "stock_after": stock_after,
175:                                    "restock_amount": RESTOCK_AMOUNT})
176: 
177:         except Exception as e:
178:             conn.rollback()
179:             logger.error("Auto-restock failed",
180:                          extra={"product_id": product_id, "error": str(e)})
181:         finally:
182:             db.put_conn(conn)
183: 
184: 
185: # ============================================================
186: # Inventory Logic (uses raw connections for transaction control)
187: # ============================================================
188: def reserve_stock(event):
189:     """When order.created → decrease stock for the product"""
190:     order_id = event["order_id"]
191:     event_id = event["event_id"]
192:     data = event.get("data", {})
193:     product_id = data.get("product_id")
194:     quantity = data.get("quantity", 1)
195: 
196:     if not product_id:
197:         logger.warning("No product_id in event", extra={"order_id": order_id})
198:         return False
199: 
200:     conn = db.get_conn()
201:     try:
202:         with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
203:             # Lock the row for update
204:             cur.execute(
205:                 "SELECT id, stock FROM products WHERE id = %s FOR UPDATE",
206:                 (product_id,)
207:             )
208:             row = cur.fetchone()
209:             if not row:
210:                 logger.warning("Product not found", extra={"product_id": product_id})
211:                 conn.rollback()
212:                 return False
213: 
214:             stock_before = row["stock"]
215:             stock_after = max(0, stock_before - quantity)
216: 
217:             # Update stock
218:             cur.execute(
219:                 "UPDATE products SET stock = %s WHERE id = %s",
220:                 (stock_after, product_id)
221:             )
222: 
223:             # Write audit log
224:             cur.execute(
225:                 "INSERT INTO inventory_log "
226:                 "(event_id, order_id, product_id, action, quantity, stock_before, stock_after) "
227:                 "VALUES (%s, %s, %s, %s, %s, %s, %s)",
228:                 (event_id, order_id, product_id, "reserve", quantity, stock_before, stock_after)
229:             )
230: 
231:             conn.commit()
232: 
233:             logger.info("Stock reserved",
234:                         extra={"order_id": order_id, "product_id": product_id,
235:                                "quantity": quantity, "stock_before": stock_before,
236:                                "stock_after": stock_after})
237: 
238:             # Auto-restock when below threshold
239:             if stock_after < RESTOCK_THRESHOLD:
240:                 restock_product(product_id, stock_after)
241: 
242:             return True
243: 
244:     except Exception as e:
245:         conn.rollback()
246:         logger.error("Failed to reserve stock",
247:                      extra={"error": str(e), "order_id": order_id,
248:                             "product_id": product_id})
249:         raise
250:     finally:
251:         db.put_conn(conn)
252: 
253: 
254: def release_stock(event):
255:     """When order.payment_failed → restore stock for the product"""
256:     order_id = event["order_id"]
257:     event_id = event["event_id"]
258:     data = event.get("data", {})
259:     product_id = data.get("product_id")
260:     quantity = data.get("quantity", 1)
261: 
262:     if not product_id:
263:         logger.warning("No product_id in event for release", extra={"order_id": order_id})
264:         return False
265: 
266:     conn = db.get_conn()
267:     try:
268:         with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
269:             cur.execute(
270:                 "SELECT id, stock FROM products WHERE id = %s FOR UPDATE",
271:                 (product_id,)
272:             )
273:             row = cur.fetchone()
274:             if not row:
275:                 logger.warning("Product not found for release",
276:                                extra={"product_id": product_id})
277:                 conn.rollback()
278:                 return False
279: 
280:             stock_before = row["stock"]
281:             stock_after = stock_before + quantity
282: 
283:             cur.execute(
284:                 "UPDATE products SET stock = %s WHERE id = %s",
285:                 (stock_after, product_id)
286:             )
287: 
288:             cur.execute(
289:                 "INSERT INTO inventory_log "
290:                 "(event_id, order_id, product_id, action, quantity, stock_before, stock_after) "
291:                 "VALUES (%s, %s, %s, %s, %s, %s, %s)",
292:                 (event_id, order_id, product_id, "release", quantity, stock_before, stock_after)
293:             )
294: 
295:             conn.commit()
296: 
297:             logger.info("Stock released",
298:                         extra={"order_id": order_id, "product_id": product_id,
299:                                "quantity": quantity, "stock_before": stock_before,
300:                                "stock_after": stock_after})
301:             return True
302: 
303:     except Exception as e:
304:         conn.rollback()
305:         logger.error("Failed to release stock",
306:                      extra={"error": str(e), "order_id": order_id,
307:                             "product_id": product_id})
308:         raise
309:     finally:
310:         db.put_conn(conn)
311: 
312: 
313: # ============================================================
314: # Kafka Consumer Loop
315: # ============================================================
316: consumer_running = True
317: consumer_stats = {"consumed": 0, "reserved": 0, "released": 0,
318:                   "skipped": 0, "ignored": 0, "errors": 0}
319: _start_time = time.time()
320: 
321: 
322: def consume_loop():
323:     """Main Kafka consumer loop"""
324:     global consumer_running
325: 
326:     logger.info("Starting Kafka consumer",
327:                 extra={"bootstrap": KAFKA_BOOTSTRAP, "topic": KAFKA_TOPIC,
328:                        "group": KAFKA_GROUP})
329: 
330:     consumer = Consumer({
331:         "bootstrap.servers": KAFKA_BOOTSTRAP,
332:         "group.id": KAFKA_GROUP,
333:         "auto.offset.reset": "earliest",
334:         "enable.auto.commit": True,
335:         "auto.commit.interval.ms": 5000,
336:     })
337:     consumer.subscribe([KAFKA_TOPIC])
338: 
339:     try:
340:         while consumer_running:
341:             msg = consumer.poll(timeout=1.0)
342: 
343:             if msg is None:
344:                 continue
345:             if msg.error():
346:                 if msg.error().code() == KafkaError._PARTITION_EOF:
347:                     continue
348:                 logger.error("Kafka consumer error", extra={"error": str(msg.error())})
349:                 continue
350: 
351:             start_time = time.time()
352: 
353:             try:
354:                 event = json.loads(msg.value().decode("utf-8"))
355:                 event_id = event.get("event_id", "unknown")
356:                 event_type = event.get("event_type", "unknown")
357:                 order_id = event.get("order_id", "unknown")
358: 
359:                 events_consumed_counter.add(1, {"event_type": event_type})
360:                 consumer_stats["consumed"] += 1
361: 
362:                 # Only handle stock-relevant events
363:                 if event_type not in ("order.created", "order.payment_failed", "stock.depleted"):
364:                     consumer_stats["ignored"] += 1
365:                     continue
366: 
367:                 # Extract trace context
368:                 ctx = extract_trace_context(msg.headers())
369:                 token = None
370:                 if ctx:
371:                     token = otel_context.attach(ctx)
372: 
373:                 try:
374:                     with tracer.start_as_current_span("kafka.consume") as span:
375:                         span.set_attribute("messaging.system", "kafka")
376:                         span.set_attribute("messaging.source", KAFKA_TOPIC)
377:                         span.set_attribute("messaging.operation", "process")
378:                         span.set_attribute("event.type", event_type)
379:                         span.set_attribute("order.id", order_id)
380:                         span.set_attribute("messaging.kafka.partition", msg.partition())
381:                         span.set_attribute("messaging.kafka.offset", msg.offset())
382: 
383:                         # Idempotency check
384:                         if is_event_processed(event_id):
385:                             span.set_attribute("event.duplicate", True)
386:                             logger.info("Duplicate event skipped",
387:                                         extra={"event_id": event_id,
388:                                                "event_type": event_type})
389:                             consumer_stats["skipped"] += 1
390:                             continue
391: 
392:                         # Process stock update
393:                         if event_type == "order.created":
394:                             with tracer.start_as_current_span("reserve_stock") as inv_span:
395:                                 success = reserve_stock(event)
396:                                 inv_span.set_attribute("inventory.action", "reserve")
397:                                 inv_span.set_attribute("inventory.success", success)
398:                                 if success:
399:                                     inventory_updates_counter.add(1, {
400:                                         "action": "reserve",
401:                                         "event_type": event_type,
402:                                     })
403:                                     consumer_stats["reserved"] += 1
404: 
405:                         elif event_type == "order.payment_failed":
406:                             with tracer.start_as_current_span("release_stock") as inv_span:
407:                                 success = release_stock(event)
408:                                 inv_span.set_attribute("inventory.action", "release")
409:                                 inv_span.set_attribute("inventory.success", success)
410:                                 if success:
411:                                     inventory_updates_counter.add(1, {
412:                                         "action": "release",
413:                                         "event_type": event_type,
414:                                     })
415:                                     consumer_stats["released"] += 1
416: 
417:                         elif event_type == "stock.depleted":
418:                             with tracer.start_as_current_span("handle_stock_depleted") as inv_span:
419:                                 data = event.get("data", {})
420:                                 product_id = data.get("product_id")
421:                                 current_stock = data.get("current_stock", 0)
422:                                 inv_span.set_attribute("inventory.action", "restock")
423:                                 inv_span.set_attribute("product.id", str(product_id))
424:                                 if product_id and current_stock < RESTOCK_THRESHOLD:
425:                                     restock_product(product_id, current_stock)
426:                                     inventory_updates_counter.add(1, {
427:                                         "action": "restock",
428:                                         "event_type": event_type,
429:                                     })
430: 
431:                         # Mark as processed
432:                         mark_event_processed(event_id, event_type)
433: 
434:                         duration = time.time() - start_time
435:                         inventory_processing_duration.record(
436:                             duration, {"event_type": event_type})
437:                         span.set_attribute(
438:                             "processing.duration_ms", int(duration * 1000))
439: 
440:                 finally:
441:                     if token:
442:                         otel_context.detach(token)
443: 
444:             except Exception as e:
445:                 consumer_stats["errors"] += 1
446:                 stock_update_errors.add(1, {"event_type": event_type})
447:                 logger.error("Failed to process Kafka message",
448:                              extra={"error": str(e), "partition": msg.partition(),
449:                                     "offset": msg.offset()})
450: 
451:     except KeyboardInterrupt:
452:         pass
453:     finally:
454:         consumer.close()
455:         logger.info("Kafka consumer stopped", extra={"stats": consumer_stats})
456: 
457: 
458: # ============================================================
459: # Flask App (Health + Status)
460: # ============================================================
461: app = Flask(__name__)
462: FlaskInstrumentor().instrument_app(app)
463: 
464: # --- Health checks ---
465: health_bp = create_health_blueprint("inventory-worker", checks={
466:     "db": lambda: db.check_health(),
467: })
468: app.register_blueprint(health_bp)
469: 
470: 
471: @app.route("/status")
472: def status():
473:     uptime = time.time() - _start_time
474:     return jsonify({
475:         "service": "inventory-worker",
476:         "status": "running" if consumer_running else "stopped",
477:         "consumer_group": KAFKA_GROUP,
478:         "topic": KAFKA_TOPIC,
479:         "events_processed": consumer_stats["reserved"] + consumer_stats["released"],
480:         "errors": consumer_stats["errors"],
481:         "uptime_seconds": round(uptime, 1),
482:         "stats": consumer_stats,
483:         "running": consumer_running,
484:     })
485: 
486: 
487: @app.route("/inventory")
488: def list_inventory():
489:     """List current product stock levels"""
490:     try:
491:         rows = db.execute(
492:             "SELECT id, name, price, stock, category FROM products ORDER BY id"
493:         )
494:         products = [dict(r) for r in rows]
495:         return jsonify({"products": products, "count": len(products)})
496:     except Exception as e:
497:         return jsonify({"error": str(e)}), 500
498: 
499: 
500: @app.route("/inventory/log")
501: def inventory_log():
502:     """List recent inventory changes"""
503:     limit = 30
504:     try:
505:         rows = db.execute(
506:             "SELECT event_id, order_id, product_id, action, quantity, "
507:             "stock_before, stock_after, created_at "
508:             "FROM inventory_log ORDER BY created_at DESC LIMIT %s",
509:             (limit,)
510:         )
511:         log = []
512:         for row in rows:
513:             entry = dict(row)
514:             entry["created_at"] = entry["created_at"].isoformat()
515:             # UI expects quantity_change (negative for reserve, positive for release)
516:             if entry["action"] == "reserve":
517:                 entry["quantity_change"] = -entry.get("quantity", 0)
518:             else:
519:                 entry["quantity_change"] = entry.get("quantity", 0)
520:             log.append(entry)
521:         return jsonify({"log": log, "count": len(log)})
522:     except Exception as e:
523:         return jsonify({"error": str(e)}), 500
524: 
525: 
526: # ============================================================
527: # Graceful Shutdown
528: # ============================================================
529: def _shutdown_handler(signum, frame):
530:     """Handle SIGTERM/SIGINT for graceful Kafka consumer shutdown."""
531:     global consumer_running
532:     sig_name = signal.Signals(signum).name
533:     logger.info(f"Received {sig_name}, shutting down gracefully...",
534:                 extra={"signal": sig_name})
535:     consumer_running = False
536: 
537: 
538: signal.signal(signal.SIGTERM, _shutdown_handler)
539: signal.signal(signal.SIGINT, _shutdown_handler)
540: atexit.register(lambda: logger.info("Inventory Worker exiting",
541:                                      extra={"stats": consumer_stats}))
542: 
543: 
544: # ============================================================
545: # Start Kafka consumer thread
546: # ============================================================
547: _consumer_thread = threading.Thread(target=consume_loop, daemon=True, name="kafka-consumer")
548: _consumer_thread.start()
549: logger.info("Kafka consumer thread started", extra={"consumer_thread": _consumer_thread.name})
550: 
551: 
552: # ============================================================
553: # Main (dev mode only)
554: # ============================================================
555: if __name__ == "__main__":
556:     logger.info("Inventory Worker starting (dev mode)",
557:                 extra={"port": 5005, "kafka": KAFKA_BOOTSTRAP, "topic": KAFKA_TOPIC})
558:     logger.warning("Use gunicorn for production: gunicorn -w 1 -b 0.0.0.0:5005 app:app")
559:     app.run(host="0.0.0.0", port=5005)
