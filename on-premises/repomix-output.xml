864: # Part 6: Quick Reference
865: 
866: ## Commands hay dùng khi incident
867: 
868: ```bash
869: # Container status
870: docker ps -a --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
871: 
872: # Resource usage
873: docker stats --no-stream
874: 
875: # Logs (last 50 lines)
876: docker logs <container> --tail 50
877: 
878: # Logs (follow real-time)
879: docker logs <container> -f --since 5m
880: 
881: # Restart service
882: docker restart <container>
883: 
884: # Check Prometheus targets
885: curl -s http://prometheus:9090/api/v1/targets | jq '.data.activeTargets[] | {job: .labels.job, health: .health}'
886: 
887: # Check firing alerts
888: curl -s http://prometheus:9090/api/v1/alerts | jq '.data.alerts[] | select(.state=="firing") | {alert: .labels.alertname, severity: .labels.severity}'
889: 
890: # Check Kafka consumer lag
891: docker exec kafka kafka-consumer-groups.sh --bootstrap-server localhost:9092 --describe --all-groups
892: 
893: # DB connections
894: docker exec postgres psql -U app -d orders -c "SELECT count(*) FROM pg_stat_activity;"
895: 
896: # Kill long-running DB queries (khi DB saturation)
897: docker exec postgres psql -U app -d orders -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE state = 'active' AND query NOT LIKE '%pg_stat%';"
898: 
899: # Check container OOM/restart count
900: docker inspect --format='{{.RestartCount}}' <container>
901: docker inspect --format='{{.State.OOMKilled}}' <container>
902: ```
