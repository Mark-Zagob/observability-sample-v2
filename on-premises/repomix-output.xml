210:       context: .
211:       dockerfile: notification-worker/Dockerfile
212:     container_name: notification-worker
213:     environment:
214:       - OTEL_EXPORTER_OTLP_ENDPOINT=192.168.100.55:4317
215:       - KAFKA_BOOTSTRAP_SERVERS=kafka:9092
216:       # secretlint-disable-next-line
217:       - DATABASE_URL=postgresql://app:app_secret@postgres:5432/orders
218:     ports:
219:       - "5004:5004"
220:     depends_on:
221:       kafka:
222:         condition: service_healthy
223:       postgres:
224:         condition: service_healthy
225:     restart: unless-stopped
226:     # --- Security hardening ---
227:     read_only: true
228:     tmpfs:
229:       - /tmp
230:     cap_drop:
231:       - ALL
232:     security_opt:
233:       - no-new-privileges:true
234:     networks:
235:       - observability
236: 
237:   inventory-worker:
238:     build:
239:       context: .
240:       dockerfile: inventory-worker/Dockerfile
241:     container_name: inventory-worker
242:     environment:
243:       - OTEL_EXPORTER_OTLP_ENDPOINT=192.168.100.55:4317
244:       - KAFKA_BOOTSTRAP_SERVERS=kafka:9092
245:       # secretlint-disable-next-line
246:       - DATABASE_URL=postgresql://app:app_secret@postgres:5432/orders
247:     ports:
248:       - "5005:5005"
249:     depends_on:
250:       kafka:
251:         condition: service_healthy
252:       postgres:
253:         condition: service_healthy
254:     restart: unless-stopped
255:     # --- Security hardening ---
256:     read_only: true
257:     tmpfs:
258:       - /tmp
259:     cap_drop:
260:       - ALL
261:     security_opt:
262:       - no-new-privileges:true
263:     networks:
264:       - observability
265: 
266:   # ==========================================================
267:   # TRAFFIC GENERATOR (security hardened)
268:   # ==========================================================
269: 
270:   traffic-gen:
271:     build: ./traffic-gen
272:     container_name: traffic-gen
273:     ports:
274:       - "5003:5003"
275:     depends_on:
276:       api-gateway:
277:         condition: service_started
278:     restart: unless-stopped
279:     # --- Security hardening ---
280:     read_only: true
281:     tmpfs:
282:       - /tmp
283:     cap_drop:
284:       - ALL
285:     security_opt:
286:       - no-new-privileges:true
287:     networks:
288:       - observability
289: 
290:   # ==========================================================
