442: // Load traffic status
443: async function loadTrafficStatus() {
444:     const resp = await trafficApi('/status');
445:     if (!resp.ok) {
446:         updateTrafficUI(false, null);
447:         return;
448:     }
449:     const d = resp.data;
450:     updateTrafficUI(d.running, d);
