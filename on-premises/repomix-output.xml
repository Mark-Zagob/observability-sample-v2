<file path="observability-vm/phase3-tracing/otel-collector/otel-config.yml">
  1: # ============================================================
  2: # OpenTelemetry Collector Configuration
  3: # ============================================================
  4: # Nhận traces + metrics từ apps → xử lý → export
  5: #   - Traces → tail_sampling → Tempo + spanmetrics
  6: #   - Metrics (app)  → Prometheus (:8889)
  7: #   - Metrics (span) → Prometheus (:8890)
  8: # ============================================================
  9: 
 10: # ============================================================
 11: # Receivers - Nhận data từ applications
 12: # ============================================================
 13: receivers:
 14:   otlp:
 15:     protocols:
 16:       grpc:
 17:         endpoint: "0.0.0.0:4317"      # Apps gửi traces + metrics qua gRPC
 18:       http:
 19:         endpoint: "0.0.0.0:4318"      # Apps gửi traces + metrics qua HTTP
 20: 
 21: # ============================================================
 22: # Processors - Xử lý data trước khi export
 23: # ============================================================
 24: processors:
 25:   # Gộp thành batch trước khi gửi (giảm network calls)
 26:   batch:
 27:     timeout: 5s
 28:     send_batch_size: 1000
 29: 
 30:   # Thêm metadata về nguồn gốc
 31:   resource:
 32:     attributes:
 33:       - key: deployment.environment
 34:         value: "lab"
 35:         action: upsert
 36: 
 37:   # ============================================================
 38:   # FILTER - Loại bỏ health check spans
 39:   # ============================================================
 40:   # Health check endpoints (/health, /ready) được gọi liên tục
 41:   # bởi orchestrator/load-balancer → tạo hàng nghìn spans vô nghĩa.
 42:   # Drop sớm ở đây để giảm:
 43:   #   - Storage cost (Tempo + S3)
 44:   #   - Prometheus cardinality (spanmetrics)
 45:   #   - Noise khi investigate traces
 46:   # ============================================================
 47:   filter/health:
 48:     error_mode: ignore
 49:     traces:
 50:       span:
 51:         - 'attributes["http.route"] == "/health"'
 52:         - 'attributes["http.route"] == "/ready"'
 53:         - 'attributes["http.route"] == "/healthz"'
 54:         - 'attributes["url.path"] == "/health"'
 55:         - 'attributes["url.path"] == "/ready"'
 56:         - 'attributes["url.path"] == "/healthz"'
 57: 
 58:   # ============================================================
 59:   # TAIL-BASED SAMPLING (Phase 3 Enhancement)
 60:   # ============================================================
 61:   # Quyết định giữ/drop trace SAU KHI trace hoàn thành.
 62:   #
 63:   # Flow: Collector buffer traces → đợi decision_wait →
 64:   #       evaluate policies → giữ hoặc drop.
 65:   #
 66:   # Policies được evaluate theo thứ tự, trace được GIỮ nếu
 67:   # BẤT KỲ policy nào match.
 68:   # ============================================================
 69:   tail_sampling:
 70:     # Thời gian đợi cho trace hoàn thành trước khi quyết định
 71:     # Trade-off: dài hơn → chính xác hơn, nhưng tốn RAM hơn
 72:     decision_wait: 10s
 73: 
 74:     # Số traces tối đa được buffer trong bộ nhớ
 75:     # Nếu vượt quá → traces cũ nhất bị force-decision
 76:     num_traces: 50000
 77: 
 78:     policies:
 79:       # ---------------------------------------------------------
 80:       # Policy 1: LUÔN giữ traces có lỗi (ERROR status)
 81:       # ---------------------------------------------------------
 82:       # Đây là policy quan trọng nhất — khi debug, bạn cần
 83:       # trace lỗi 100%. Không bao giờ drop traces có error.
 84:       # ---------------------------------------------------------
 85:       - name: keep-errors
 86:         type: status_code
 87:         status_code:
 88:           status_codes: [ERROR]
 89: 
 90:       # ---------------------------------------------------------
 91:       # Policy 2: LUÔN giữ traces chậm (> 500ms)
 92:       # ---------------------------------------------------------
 93:       # Latency cao thường là dấu hiệu của vấn đề.
 94:       # Giữ 100% slow traces để phân tích bottleneck.
 95:       # ---------------------------------------------------------
 96:       - name: keep-slow-requests
 97:         type: latency
 98:         latency:
 99:           threshold_ms: 500
100: 
101:       # ---------------------------------------------------------
102:       # Policy 3: Random 10% cho traces bình thường
103:       # ---------------------------------------------------------
104:       # Traces bình thường (không lỗi, không chậm) chỉ giữ 10%
105:       # → giảm ~90% storage mà vẫn có mẫu đại diện.
106:       #
107:       # Production: Tuỳ traffic, có thể giảm xuống 1-5%
108:       # ---------------------------------------------------------
109:       - name: random-sample
110:         type: probabilistic
111:         probabilistic:
112:           sampling_percentage: 10
113: 
114: # ============================================================
115: # Connectors - Kết nối pipeline với pipeline
116: # ============================================================
117: # Connector vừa là exporter của pipeline A,
118: # vừa là receiver của pipeline B.
119: # ============================================================
120: connectors:
121:   # ============================================================
122:   # SPANMETRICS CONNECTOR (Phase 3 Enhancement)
123:   # ============================================================
124:   # Tự động tạo RED metrics từ traces:
125:   #   - calls_total      → Request count (Rate)
126:   #   - calls_total{status_code="STATUS_CODE_ERROR"}  (Errors)
127:   #   - duration_bucket   → Latency histogram (Duration)
128:   #
129:   # Không cần instrument thủ công — chỉ cần có traces!
130:   # ============================================================
131:   spanmetrics:
132:     # Histogram buckets cho latency distribution
133:     histogram:
134:       explicit:
135:         buckets: [5ms, 10ms, 25ms, 50ms, 100ms, 250ms, 500ms, 1s, 2.5s, 5s]
136: 
137:     # Thêm dimensions từ span attributes vào metrics labels
138:     # → cho phép filter/group by trong PromQL
139:     dimensions:
140:       - name: http.method
141:       - name: http.status_code
142:       - name: http.route
143: 
144:     # Namespace prefix cho metrics (tránh conflict)
145:     # Kết quả: span_calls_total, span_duration_bucket
146:     namespace: span
147: 
148:     # Resource attributes cần giữ làm metrics labels
149:     dimensions_cache_size: 1000
150:     aggregation_temporality: "AGGREGATION_TEMPORALITY_CUMULATIVE"
151: 
152: # ============================================================
153: # Exporters - Gửi data tới backend
154: # ============================================================
155: exporters:
156:   # Traces → Tempo qua OTLP gRPC
157:   otlp:
158:     endpoint: "tempo:4317"
159:     tls:
160:       insecure: true
161: 
162:   # App Metrics (manual) → Prometheus :8889
163:   prometheus:
164:     endpoint: "0.0.0.0:8889"
165:     resource_to_telemetry_conversion:
166:       enabled: true                    # service.name → label trên metric
167: 
168:   # Span Metrics (auto RED) → Prometheus :8890
169:   # Tách riêng port để phân biệt manual vs auto metrics
170:   prometheus/spanmetrics:
171:     endpoint: "0.0.0.0:8890"
172:     resource_to_telemetry_conversion:
173:       enabled: true
174: 
175:   # Debug: in ra stdout (troubleshoot)
176:   debug:
177:     verbosity: basic
178: 
179: # ============================================================
180: # Service - Kết nối receivers → processors → exporters
181: # ============================================================
182: service:
183:   pipelines:
184:     # Traces pipeline
185:     # Flow: OTLP → batch → resource → tail_sampling → Tempo + spanmetrics
186:     #
187:     # ⚠️ tail_sampling PHẢI đặt SAU batch/resource
188:     #    vì nó cần đợi trace hoàn thành
189:     traces:
190:       receivers: [otlp]
191:       processors: [batch, resource, filter/health, tail_sampling]
192:       exporters: [otlp, debug, spanmetrics]
193: 
194:     # App Metrics pipeline (manual metrics từ code — Phase 5)
195:     metrics:
196:       receivers: [otlp]
197:       processors: [batch, resource]
198:       exporters: [prometheus]
199: 
200:     # SpanMetrics pipeline (auto RED metrics từ traces)
201:     # Receiver = spanmetrics connector (nhận từ traces pipeline)
202:     metrics/spanmetrics:
203:       receivers: [spanmetrics]
204:       exporters: [prometheus/spanmetrics]
205: 
206:   telemetry:
207:     logs:
208:       level: info
</file>

<file path="observability-vm/phase3-tracing/tempo/tempo-config.yml">
 1: # ============================================================
 2: # Tempo Configuration
 3: # ============================================================
 4: # Chế độ: monolithic (single process)
 5: # Nhận traces qua OTLP protocol từ OTEL Collector
 6: # Storage: MinIO (S3-compatible) — bucket "tempo"
 7: # ============================================================
 8: 
 9: stream_over_http_enabled: true    # Enable streaming traces qua HTTP
10: 
11: server:
12:   http_listen_port: 3200
13:   grpc_listen_port: 9095
14:   log_level: info
15: 
16: # ============================================================
17: # Distributor - Nhận traces từ OTEL Collector
18: # ============================================================
19: distributor:
20:   receivers:
21:     otlp:
22:       protocols:
23:         grpc:
24:           endpoint: "0.0.0.0:4317"    # OTLP gRPC
25:         http:
26:           endpoint: "0.0.0.0:4318"    # OTLP HTTP
27: 
28: # ============================================================
29: # Ingester - Ghi traces vào storage
30: # ============================================================
31: ingester:
32:   max_block_duration: 5m
33: 
34: # ============================================================
35: # Compactor - Nén và tối ưu storage
36: # ============================================================
37: compactor:
38:   compaction:
39:     block_retention: 168h             # Giữ traces 7 ngày
40: 
41: # ============================================================
42: # Storage — MinIO (S3-compatible)
43: # ============================================================
44: # WAL (Write-Ahead Log) vẫn ở local để đảm bảo performance
45: # Blocks được flush lên S3 (MinIO) để lưu trữ lâu dài
46: # ============================================================
47: storage:
48:   trace:
49:     backend: s3
50:     wal:
51:       path: /var/tempo/wal
52:     s3:
53:       bucket: tempo
54:       endpoint: minio:9000
55:       access_key: minioadmin
56:       secret_key: minioadmin
57:       insecure: true              # HTTP cho lab
58:       forcepathstyle: true        # Bắt buộc cho MinIO
59: 
60: # ============================================================
61: # Metrics Generator - Tạo metrics từ traces (RED metrics)
62: # ============================================================
63: # Tự động tạo span metrics (request rate, error rate, duration)
64: # và gửi về Prometheus qua remote_write
65: # ============================================================
66: metrics_generator:
67:   registry:
68:     external_labels:
69:       source: tempo
70:       cluster: docker-compose
71:     stale_duration: 2m               # Xóa metric sau 2m không có traces mới (default: 15m)
72:   storage:
73:     path: /var/tempo/generator/wal
74:     remote_write:
75:       - url: http://prometheus:9090/api/v1/write
76:         send_exemplars: true
77:   traces_storage:
78:     path: /var/tempo/generator/traces
79:   processor:
80:     span_metrics:
81:       dimensions:
82:         - service.name
83:         - http.method
84:         - http.status_code
85:     service_graphs:
86:       dimensions:
87:         - service.name
88: 
89: overrides:
90:   defaults:
91:     metrics_generator:
92:       processors: [service-graphs, span-metrics]
</file>

