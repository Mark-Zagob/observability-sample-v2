<file path="applications-vm/applications/notification-worker/app.py">
  1: """
  2: ============================================================
  3: Notification Worker — Kafka Consumer + Shared Refactor
  4: ============================================================
  5: Consume events từ topic 'order.events' và gửi notifications.
  6: 
  7: Handles:
  8:   - order.created → "Order confirmation" notification
  9:   - order.payment_completed → "Payment received" notification
 10:   - order.payment_failed → "Payment failed" notification
 11: 
 12: Features:
 13:   - Idempotency via processed_events table
 14:   - OTel trace context propagation from Kafka headers
 15:   - Custom metrics: notifications_sent_total, processing_duration
 16:   - Health checks: /health/live, /health/ready
 17: ============================================================
 18: """
 19: 
 20: import os
 21: import time
 22: import json
 23: import signal
 24: import threading
 25: import atexit
 26: 
 27: from confluent_kafka import Consumer, KafkaError
 28: from flask import Flask, jsonify
 29: 
 30: # ----------------------------------------------------------
 31: # Shared modules
 32: # ----------------------------------------------------------
 33: from shared.logging_config import setup_logging
 34: from shared.otel_setup import init_otel
 35: from shared.db_utils import DatabasePool
 36: from shared.kafka_utils import extract_trace_context
 37: from shared.health import create_health_blueprint
 38: 
 39: # ----------------------------------------------------------
 40: # Auto-instrumentation imports
 41: # ----------------------------------------------------------
 42: from opentelemetry import context as otel_context
 43: from opentelemetry.instrumentation.flask import FlaskInstrumentor
 44: from opentelemetry.instrumentation.psycopg2 import Psycopg2Instrumentor
 45: 
 46: # ----------------------------------------------------------
 47: # Initialize logging + OTel
 48: # ----------------------------------------------------------
 49: logger = setup_logging("notification-worker")
 50: tracer, meter = init_otel("notification-worker", "1.0.0")
 51: Psycopg2Instrumentor().instrument()
 52: 
 53: # ============================================================
 54: # Custom Metrics
 55: # ============================================================
 56: notifications_counter = meter.create_counter(
 57:     name="notifications_sent_total",
 58:     description="Total notifications sent",
 59:     unit="1",
 60: )
 61: 
 62: processing_duration = meter.create_histogram(
 63:     name="notification_processing_duration_seconds",
 64:     description="Notification processing duration",
 65:     unit="s",
 66: )
 67: 
 68: events_consumed_counter = meter.create_counter(
 69:     name="kafka_events_consumed_total",
 70:     description="Total Kafka events consumed",
 71:     unit="1",
 72: )
 73: 
 74: # ============================================================
 75: # Config
 76: # ============================================================
 77: KAFKA_BOOTSTRAP = os.getenv("KAFKA_BOOTSTRAP_SERVERS", "kafka:9092")
 78: KAFKA_TOPIC = os.getenv("KAFKA_TOPIC", "order.events")
 79: KAFKA_GROUP = "notification-workers"
 80: # secretlint-disable-next-line
 81: DATABASE_URL = os.getenv("DATABASE_URL", "postgresql://app:app_secret@postgres:5432/orders")
 82: 
 83: # ============================================================
 84: # Database (shared helper)
 85: # ============================================================
 86: db = DatabasePool(DATABASE_URL, minconn=2, maxconn=5)
 87: 
 88: 
 89: def is_event_processed(event_id):
 90:     """Check if event was already processed (idempotency)"""
 91:     rows = db.execute(
 92:         "SELECT 1 FROM processed_events WHERE event_id = %s AND processed_by = %s",
 93:         (event_id, "notification-worker")
 94:     )
 95:     return len(rows) > 0
 96: 
 97: 
 98: def mark_event_processed(event_id, event_type):
 99:     """Mark event as processed"""
100:     db.execute(
101:         "INSERT INTO processed_events (event_id, event_type, processed_by) VALUES (%s, %s, %s)",
102:         (event_id, event_type, "notification-worker"),
103:         fetch=False
104:     )
105: 
106: 
107: # ============================================================
108: # Notification Logic
109: # ============================================================
110: NOTIFICATION_TEMPLATES = {
111:     "order.created": {
112:         "type": "order_confirmation",
113:         "channel": "email",
114:         "template": "Your order {order_id} has been received! Product: {product_name}, Qty: {quantity}",
115:     },
116:     "order.payment_completed": {
117:         "type": "payment_success",
118:         "channel": "email",
119:         "template": "Payment confirmed for order {order_id}. Amount: ${total_amount}. Txn: {transaction_id}",
120:     },
121:     "order.payment_failed": {
122:         "type": "payment_failure",
123:         "channel": "email",
124:         "template": "Payment failed for order {order_id}. Please retry or contact support.",
125:     },
126: }
127: 
128: 
129: def send_notification(event):
130:     """Simulate sending notification — log + persist to DB"""
131:     event_type = event["event_type"]
132:     order_id = event["order_id"]
133:     event_id = event["event_id"]
134:     data = event.get("data", {})
135: 
136:     template_info = NOTIFICATION_TEMPLATES.get(event_type)
137:     if not template_info:
138:         logger.warning("No template for event type", extra={"event_type": event_type})
139:         return
140: 
141:     # Simulate notification delivery delay
142:     delay = 0.05 + (0.15 * (hash(order_id) % 10) / 10)
143:     time.sleep(delay)
144: 
145:     # Build message from template
146:     message = template_info["template"].format(
147:         order_id=order_id,
148:         product_name=data.get("product_name", "Unknown"),
149:         quantity=data.get("quantity", 0),
150:         total_amount=data.get("total_amount", 0),
151:         transaction_id=data.get("transaction_id", "N/A"),
152:     )
153: 
154:     logger.info("Notification sent",
155:                 extra={"order_id": order_id, "type": template_info["type"],
156:                        "channel": template_info["channel"], "notification_message": message[:100]})
157: 
158:     # Persist to notifications table
159:     db.execute(
160:         "INSERT INTO notifications (event_id, order_id, notification_type, channel, status) "
161:         "VALUES (%s, %s, %s, %s, %s)",
162:         (event_id, order_id, template_info["type"], template_info["channel"], "sent"),
163:         fetch=False
164:     )
165: 
166:     return template_info["type"]
167: 
168: 
169: # ============================================================
170: # Kafka Consumer Loop
171: # ============================================================
172: consumer_running = True
173: consumer_stats = {"consumed": 0, "processed": 0, "skipped": 0, "errors": 0}
174: _start_time = time.time()
175: 
176: 
177: def consume_loop():
178:     """Main Kafka consumer loop"""
179:     global consumer_running
180: 
181:     logger.info("Starting Kafka consumer",
182:                 extra={"bootstrap": KAFKA_BOOTSTRAP, "topic": KAFKA_TOPIC,
183:                        "group": KAFKA_GROUP})
184: 
185:     consumer = Consumer({
186:         "bootstrap.servers": KAFKA_BOOTSTRAP,
187:         "group.id": KAFKA_GROUP,
188:         "auto.offset.reset": "earliest",
189:         "enable.auto.commit": True,
190:         "auto.commit.interval.ms": 5000,
191:     })
192:     consumer.subscribe([KAFKA_TOPIC])
193: 
194:     try:
195:         while consumer_running:
196:             msg = consumer.poll(timeout=1.0)
197: 
198:             if msg is None:
199:                 continue
200:             if msg.error():
201:                 if msg.error().code() == KafkaError._PARTITION_EOF:
202:                     continue
203:                 logger.error("Kafka consumer error", extra={"error": str(msg.error())})
204:                 continue
205: 
206:             start_time = time.time()
207: 
208:             try:
209:                 event = json.loads(msg.value().decode("utf-8"))
210:                 event_id = event.get("event_id", "unknown")
211:                 event_type = event.get("event_type", "unknown")
212:                 order_id = event.get("order_id", "unknown")
213: 
214:                 events_consumed_counter.add(1, {"event_type": event_type})
215:                 consumer_stats["consumed"] += 1
216: 
217:                 # Extract trace context from Kafka headers
218:                 ctx = extract_trace_context(msg.headers())
219:                 token = None
220:                 if ctx:
221:                     token = otel_context.attach(ctx)
222: 
223:                 try:
224:                     with tracer.start_as_current_span("kafka.consume") as span:
225:                         span.set_attribute("messaging.system", "kafka")
226:                         span.set_attribute("messaging.source", KAFKA_TOPIC)
227:                         span.set_attribute("messaging.operation", "process")
228:                         span.set_attribute("event.type", event_type)
229:                         span.set_attribute("order.id", order_id)
230:                         span.set_attribute("messaging.kafka.partition", msg.partition())
231:                         span.set_attribute("messaging.kafka.offset", msg.offset())
232: 
233:                         # Idempotency check
234:                         if is_event_processed(event_id):
235:                             span.set_attribute("event.duplicate", True)
236:                             logger.info("Duplicate event skipped",
237:                                         extra={"event_id": event_id, "event_type": event_type})
238:                             consumer_stats["skipped"] += 1
239:                             continue
240: 
241:                         # Process notification
242:                         with tracer.start_as_current_span("send_notification") as notif_span:
243:                             notif_type = send_notification(event)
244:                             if notif_type:
245:                                 notif_span.set_attribute("notification.type", notif_type)
246:                                 notifications_counter.add(1, {
247:                                     "type": notif_type,
248:                                     "event_type": event_type,
249:                                 })
250: 
251:                         # Mark as processed
252:                         mark_event_processed(event_id, event_type)
253:                         consumer_stats["processed"] += 1
254: 
255:                         duration = time.time() - start_time
256:                         processing_duration.record(duration, {"event_type": event_type})
257:                         span.set_attribute("processing.duration_ms", int(duration * 1000))
258: 
259:                 finally:
260:                     if token:
261:                         otel_context.detach(token)
262: 
263:             except Exception as e:
264:                 consumer_stats["errors"] += 1
265:                 logger.error("Failed to process Kafka message",
266:                              extra={"error": str(e), "partition": msg.partition(),
267:                                     "offset": msg.offset()})
268: 
269:     except KeyboardInterrupt:
270:         pass
271:     finally:
272:         consumer.close()
273:         logger.info("Kafka consumer stopped", extra={"stats": consumer_stats})
274: 
275: 
276: # ============================================================
277: # Flask App (Health + Status)
278: # ============================================================
279: app = Flask(__name__)
280: FlaskInstrumentor().instrument_app(app)
281: 
282: # --- Health checks ---
283: health_bp = create_health_blueprint("notification-worker", checks={
284:     "db": lambda: db.check_health(),
285: })
286: app.register_blueprint(health_bp)
287: 
288: 
289: @app.route("/status")
290: def status():
291:     uptime = time.time() - _start_time
292:     return jsonify({
293:         "service": "notification-worker",
294:         "status": "running" if consumer_running else "stopped",
295:         "consumer_group": KAFKA_GROUP,
296:         "topic": KAFKA_TOPIC,
297:         "events_processed": consumer_stats["processed"],
298:         "errors": consumer_stats["errors"],
299:         "uptime_seconds": round(uptime, 1),
300:         "stats": consumer_stats,
301:         "running": consumer_running,
302:     })
303: 
304: 
305: @app.route("/notifications")
306: def list_notifications():
307:     """List recent notifications"""
308:     limit = 30
309:     try:
310:         rows = db.execute(
311:             "SELECT n.event_id, n.order_id, n.notification_type, n.channel, n.status, "
312:             "n.created_at, pe.event_type "
313:             "FROM notifications n "
314:             "LEFT JOIN processed_events pe ON n.event_id = pe.event_id "
315:             "AND pe.processed_by = 'notification-worker' "
316:             "ORDER BY n.created_at DESC LIMIT %s",
317:             (limit,)
318:         )
319:         notifications = []
320:         for row in rows:
321:             n = dict(row)
322:             n["created_at"] = n["created_at"].isoformat()
323:             notifications.append(n)
324:         return jsonify({"notifications": notifications, "count": len(notifications)})
325:     except Exception as e:
326:         return jsonify({"error": str(e)}), 500
327: 
328: 
329: # ============================================================
330: # Graceful Shutdown
331: # ============================================================
332: def _shutdown_handler(signum, frame):
333:     """Handle SIGTERM/SIGINT for graceful Kafka consumer shutdown."""
334:     global consumer_running
335:     sig_name = signal.Signals(signum).name
336:     logger.info(f"Received {sig_name}, shutting down gracefully...",
337:                 extra={"signal": sig_name})
338:     consumer_running = False
339: 
340: 
341: signal.signal(signal.SIGTERM, _shutdown_handler)
342: signal.signal(signal.SIGINT, _shutdown_handler)
343: atexit.register(lambda: logger.info("Notification Worker exiting",
344:                                      extra={"stats": consumer_stats}))
345: 
346: 
347: # ============================================================
348: # Start Kafka consumer thread
349: # ============================================================
350: _consumer_thread = threading.Thread(target=consume_loop, daemon=True, name="kafka-consumer")
351: _consumer_thread.start()
352: logger.info("Kafka consumer thread started", extra={"consumer_thread": _consumer_thread.name})
353: 
354: 
355: # ============================================================
356: # Main (dev mode only)
357: # ============================================================
358: if __name__ == "__main__":
359:     logger.info("Notification Worker starting (dev mode)",
360:                 extra={"port": 5004, "kafka": KAFKA_BOOTSTRAP, "topic": KAFKA_TOPIC})
361:     logger.warning("Use gunicorn for production: gunicorn -w 1 -b 0.0.0.0:5004 app:app")
362:     app.run(host="0.0.0.0", port=5004)
</file>

