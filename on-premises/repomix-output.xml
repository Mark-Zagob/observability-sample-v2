      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "id": 15,
      "title": "Memory Forecast (predict_linear — 2h ahead)",
      "description": "Predicted available memory in 2 hours. If it crosses zero, MemoryWillExhaustIn2Hours alert will fire.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes{vm=~\"$vm\"}",
          "legendFormat": "{{ vm }} Available Now"
        },
        {
          "expr": "predict_linear(node_memory_MemAvailable_bytes{vm=~\"$vm\"}[1h], 2*3600)",
          "legendFormat": "{{ vm }} Predicted (2h)"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "custom.thresholdsStyle": { "mode": "line" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "id": 16,
      "title": "CPU Trend (predict_linear — 1h ahead)",
      "description": "Predicted CPU usage in 1 hour based on 30-minute trend.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 - (avg by(vm)(rate(node_cpu_seconds_total{mode=\"idle\",vm=~\"$vm\"}[5m])) * 100)",
          "legendFormat": "{{ vm }} Current"
        },
        {
          "expr": "predict_linear((100 - (avg by(vm)(rate(node_cpu_seconds_total{mode=\"idle\",vm=~\"$vm\"}[5m])) * 100))[30m:1m], 3600)",
          "legendFormat": "{{ vm }} Predicted (1h)"
        }
      ]
    }
