784: .lt-stat-card.success { border-left: 3px solid var(--green); }
785: .lt-stat-card.error   { border-left: 3px solid var(--red); }
786: 
787: .lt-stat-icon { font-size: 1.5rem; }
788: 
789: .lt-stat-info { display: flex; flex-direction: column; gap: 2px; }
790: 
791: .lt-stat-value {
792:     font-size: 1.5rem;
793:     font-weight: 700;
794:     font-family: 'JetBrains Mono', monospace;
795:     color: var(--text-primary);
796: }
797: 
798: .lt-stat-label {
799:     font-size: 0.75rem;
800:     color: var(--text-muted);
801:     text-transform: uppercase;
802:     letter-spacing: 0.04em;
803: }
804: 
805: /* Progress Bar */
806: .lt-progress-wrap {
807:     margin-top: 18px;
808:     display: flex;
809:     align-items: center;
810:     gap: 12px;
811: }
812: 
813: .lt-progress-bar {
814:     flex: 1;
