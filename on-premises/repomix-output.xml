20: RUN groupadd -r appuser && useradd -r -g appuser -s /usr/sbin/nologin appuser
21: 
22: ENV PYTHONDONTWRITEBYTECODE=1
23: ENV PYTHONUNBUFFERED=1
24: 
25: WORKDIR /app
26: 
