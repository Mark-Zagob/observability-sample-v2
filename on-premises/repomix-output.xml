  1: """
  2: ============================================================
  3: Payment Service — Phase 5 + Shared Refactor
  4: ============================================================
  5: Xử lý thanh toán. Simulate delays và random errors.
  6: Metrics: payments counter, amount histogram, gateway duration
  7: 
  8: Endpoints:
  9:   - POST /charge      → process payment
 10:   - GET  /health      → readiness check (alias)
 11:   - GET  /health/live → liveness check
 12:   - GET  /health/ready → readiness check
 13: ============================================================
 14: """
 15: 
 16: import os
 17: import time
 18: import random
 19: from flask import Flask, jsonify, request
 20: 
 21: # ----------------------------------------------------------
 22: # Shared modules
 23: # ----------------------------------------------------------
 24: from shared.logging_config import setup_logging
 25: from shared.otel_setup import init_otel
 26: from shared.health import create_health_blueprint
 27: from shared.errors import problem_response
 28: 
 29: # ----------------------------------------------------------
 30: # Auto-instrumentation imports
 31: # ----------------------------------------------------------
 32: from opentelemetry.instrumentation.flask import FlaskInstrumentor
 33: 
 34: # ----------------------------------------------------------
 35: # Initialize logging + OTel
 36: # ----------------------------------------------------------
 37: logger = setup_logging("payment-service")
 38: tracer, meter = init_otel("payment-service", "2.0.0")
 39: 
 40: # ============================================================
 41: # Custom Metrics
 42: # ============================================================
 43: payments_counter = meter.create_counter(
 44:     name="payments_total",
 45:     description="Total payment transactions",
 46:     unit="1",
 47: )
 48: 
 49: payment_amount = meter.create_histogram(
 50:     name="payment_amount_dollars",
 51:     description="Payment amount distribution in dollars",
 52:     unit="$",
 53: )
 54: 
 55: gateway_duration = meter.create_histogram(
 56:     name="payment_gateway_duration_seconds",
 57:     description="External payment gateway call duration",
 58:     unit="s",
 59: )
 60: 
 61: # ============================================================
 62: # Flask App
 63: # ============================================================
 64: app = Flask(__name__)
 65: FlaskInstrumentor().instrument_app(app)
 66: 
 67: # Simulated payment providers
 68: PROVIDERS = ["stripe", "paypal", "square"]
 69: 
 70: # --- Health checks (no external deps to check) ---
 71: health_bp = create_health_blueprint("payment-service")
 72: app.register_blueprint(health_bp)
 73: 
 74: 
 75: @app.route("/charge", methods=["POST"])
 76: def charge():
 77:     """Xử lý thanh toán"""
 78:     # Support both JSON body (preferred) and query params (backward compat)
 79:     if request.is_json:
 80:         data = request.get_json()
 81:         order_id = data.get("order_id", "unknown")
 82:         amount = data.get("amount")
 83:     else:
 84:         order_id = request.args.get("order_id", "unknown")
 85:         amount = request.args.get("amount")
 86: 
 87:     if amount:
 88:         amount = float(amount)
 89:     else:
 90:         amount = round(random.uniform(10.0, 500.0), 2)
 91: 
 92:     provider = random.choice(PROVIDERS)
 93: 
 94:     logger.info("Processing payment",
 95:                  extra={"order_id": order_id, "amount": amount, "provider": provider})
 96: 
 97:     # Step 1: Validate payment method
 98:     with tracer.start_as_current_span("validate_payment_method") as span:
 99:         time.sleep(random.uniform(0.01, 0.03))
100:         span.set_attribute("payment.order_id", order_id)
101:         span.set_attribute("payment.provider", provider)
102:         span.set_attribute("payment.amount", amount)
103: 
104:     # Step 2: Call external payment gateway
105:     with tracer.start_as_current_span("call_payment_gateway") as span:
106:         span.set_attribute("payment.provider", provider)
107:         span.set_attribute("payment.amount", amount)
108: 
109:         # Simulate gateway latency
110:         delay = random.uniform(0.05, 0.15)
111:         is_slow = random.random() < 0.2
112: 
113:         if is_slow:
114:             delay = random.uniform(0.5, 2.0)
115:             span.set_attribute("payment.slow", True)
116:             logger.warning("Slow payment gateway response",
117:                             extra={"order_id": order_id, "provider": provider,
118:                                    "delay_ms": int(delay * 1000)})
119: 
120:         time.sleep(delay)
121: 
122:         # Record gateway duration metric
123:         gateway_duration.record(delay, {"provider": provider})
124:         span.set_attribute("payment.gateway_duration_ms", int(delay * 1000))
125: 
126:         # Simulate payment failure (10% chance)
127:         if random.random() < 0.1:
128:             span.set_attribute("error", True)
129:             span.set_attribute("error.message", "Payment gateway timeout")
130: 
131:             payments_counter.add(1, {"status": "failed", "provider": provider})
132:             payment_amount.record(amount, {"status": "failed", "provider": provider})
133: 
134:             logger.error("Payment failed",
135:                           extra={"order_id": order_id, "provider": provider,
136:                                  "amount": amount, "error": "gateway_timeout"})
137: 
138:             return problem_response(
139:                 500, "Payment Gateway Error",
140:                 f"Payment gateway ({provider}) timed out for order {order_id}",
141:                 instance="/charge",
142:                 extra={"order_id": order_id, "provider": provider, "amount": amount},
143:             )
144: 
145:     # Success
146:     txn_id = f"txn-{random.randint(10000, 99999)}"
147: 
148:     payments_counter.add(1, {"status": "success", "provider": provider})
149:     payment_amount.record(amount, {"status": "success", "provider": provider})
150: 
151:     logger.info("Payment successful",
152:                  extra={"order_id": order_id, "provider": provider,
153:                         "amount": amount, "transaction_id": txn_id})
154: 
155:     return jsonify({
156:         "status": "success",
157:         "order_id": order_id,
158:         "transaction_id": txn_id,
159:         "provider": provider,
160:         "amount": amount,
161:     })
162: 
163: 
164: if __name__ == "__main__":
165:     logger.info("Payment Service starting (dev mode)", extra={"port": 5002})
166:     logger.warning("Use gunicorn for production: gunicorn -w 4 -b 0.0.0.0:5002 app:app")
167:     app.run(host="0.0.0.0", port=5002)
