<file path="applications-vm/applications/init.sql">
 1: -- ============================================================
 2: -- Database Initialization — Orders DB
 3: -- ============================================================
 4: -- Chạy tự động khi PostgreSQL container start lần đầu
 5: -- via docker-entrypoint-initdb.d
 6: -- ============================================================
 7: 
 8: -- Orders table
 9: CREATE TABLE IF NOT EXISTS orders (
10:     id SERIAL PRIMARY KEY,
11:     order_id VARCHAR(8) UNIQUE NOT NULL,
12:     product_id INTEGER NOT NULL,
13:     product_name VARCHAR(100),
14:     quantity INTEGER NOT NULL DEFAULT 1,
15:     total_amount DECIMAL(10,2) NOT NULL,
16:     status VARCHAR(20) DEFAULT 'pending',
17:     payment_txn_id VARCHAR(20),
18:     created_at TIMESTAMP DEFAULT NOW(),
19:     updated_at TIMESTAMP DEFAULT NOW()
20: );
21: 
22: -- Products table (source of truth)
23: CREATE TABLE IF NOT EXISTS products (
24:     id SERIAL PRIMARY KEY,
25:     name VARCHAR(100) NOT NULL,
26:     price DECIMAL(10,2) NOT NULL,
27:     stock INTEGER DEFAULT 100,
28:     category VARCHAR(50) DEFAULT 'general'
29: );
30: 
31: -- Processed events — idempotency tracking cho Kafka workers
32: CREATE TABLE IF NOT EXISTS processed_events (
33:     event_id VARCHAR(36) NOT NULL,
34:     event_type VARCHAR(50) NOT NULL,
35:     processed_by VARCHAR(50) NOT NULL,
36:     processed_at TIMESTAMP DEFAULT NOW(),
37:     PRIMARY KEY (event_id, processed_by)
38: );
39: 
40: -- Notifications — log notifications đã gửi
41: CREATE TABLE IF NOT EXISTS notifications (
42:     id SERIAL PRIMARY KEY,
43:     event_id VARCHAR(36) NOT NULL,
44:     order_id VARCHAR(8) NOT NULL,
45:     notification_type VARCHAR(50) NOT NULL,
46:     channel VARCHAR(20) DEFAULT 'email',
47:     status VARCHAR(20) DEFAULT 'sent',
48:     created_at TIMESTAMP DEFAULT NOW()
49: );
50: 
51: -- Inventory log — audit trail cho stock changes
52: CREATE TABLE IF NOT EXISTS inventory_log (
53:     id SERIAL PRIMARY KEY,
54:     event_id VARCHAR(36) NOT NULL,
55:     order_id VARCHAR(8) NOT NULL,
56:     product_id INTEGER NOT NULL,
57:     action VARCHAR(20) NOT NULL,
58:     quantity INTEGER NOT NULL,
59:     stock_before INTEGER,
60:     stock_after INTEGER,
61:     created_at TIMESTAMP DEFAULT NOW()
62: );
63: 
64: -- Indexes
65: CREATE INDEX IF NOT EXISTS idx_orders_status ON orders(status);
66: CREATE INDEX IF NOT EXISTS idx_orders_created_at ON orders(created_at);
67: CREATE INDEX IF NOT EXISTS idx_products_category ON products(category);
68: CREATE INDEX IF NOT EXISTS idx_processed_events_type ON processed_events(event_type);
69: CREATE INDEX IF NOT EXISTS idx_notifications_order ON notifications(order_id);
70: CREATE INDEX IF NOT EXISTS idx_inventory_log_order ON inventory_log(order_id);
71: CREATE INDEX IF NOT EXISTS idx_inventory_log_product ON inventory_log(product_id);
72: 
73: -- Seed products
74: INSERT INTO products (name, price, stock, category) VALUES
75:     ('Widget A',   29.99, 100, 'widgets'),
76:     ('Widget B',   49.99,  50, 'widgets'),
77:     ('Gadget X',   99.99,  30, 'gadgets'),
78:     ('Gadget Y',  149.99,  20, 'gadgets'),
79:     ('Premium Z', 299.99,  10, 'premium')
80: ON CONFLICT DO NOTHING;
</file>

<file path="observability-vm/phase1-metrics/alertmanager/alertmanager.yml">
 1: # ============================================================
 2: # Alertmanager Configuration - Phase 4
 3: # ============================================================
 4: # Alertmanager nhận alerts từ Prometheus và quyết định:
 5: #   - Route tới receiver nào (dựa trên labels)
 6: #   - Group alerts lại (tránh spam)
 7: #   - Khi nào gửi lại (repeat_interval)
 8: #   - Inhibit alerts nào (critical suppress warning)
 9: # ============================================================
10: 
11: # ============================================================
12: # Global Settings
13: # ============================================================
14: global:
15:   resolve_timeout: 5m               # Sau 5m không nhận lại alert → resolved
16:   telegram_api_url: "https://api.telegram.org"
17: 
18: # ============================================================
19: # Route Tree - Quyết định alert đi đâu
20: # ============================================================
21: route:
22:   # Default route (catch-all)
23:   receiver: "telegram-alerts"
24:   group_by: ["alertname", "severity"]
25:   group_wait: 30s
26:   group_interval: 5m
27:   repeat_interval: 4h
28: 
29:   # Child routes
30:   routes:
31:     # Watchdog → chỉ gửi webhook (tránh spam Telegram)
32:     - match:
33:         alertname: Watchdog
34:       receiver: "webhook-alerts"
35:       group_wait: 30s
36:       repeat_interval: 12h
37:       continue: false
38: 
39:     # Critical → gửi Telegram nhanh (10s), nhắc lại mỗi 1h
40:     - match:
41:         severity: critical
42:       receiver: "telegram-alerts"
43:       group_wait: 10s
44:       repeat_interval: 1h
45:       continue: true                   # Tiếp tục gửi webhook nữa
46: 
47:     # Warning → gửi Telegram, nhắc lại mỗi 4h
48:     - match:
49:         severity: warning
50:       receiver: "telegram-alerts"
51:       group_wait: 1m
52:       repeat_interval: 4h
53:       continue: true                   # Tiếp tục gửi webhook nữa
54: 
55:     # Catch-all webhook (nhận tất cả do continue: true ở trên)
56:     - match_re:
57:         severity: ".+"
58:       receiver: "webhook-alerts"
59:       continue: false
60: 
61: # ============================================================
62: # Receivers
63: # ============================================================
64: receivers:
65:   # Telegram — nhận alert notifications trên điện thoại
66:   - name: "telegram-alerts"
67:     telegram_configs:
68:       - bot_token: <Telegram-token>
69:         chat_id: <GROUP-ID>
70:         parse_mode: "HTML"
71:         message: |
72:           {{ if eq .Status "firing" }}🔥 <b>FIRING</b>{{ else }}✅ <b>RESOLVED</b>{{ end }}
73: 
74:           {{ range .Alerts }}
75:           <b>{{ .Labels.alertname }}</b> [{{ .Labels.severity }}]
76:           {{ .Annotations.summary }}
77:           {{ if .Annotations.description }}📝 {{ .Annotations.description }}{{ end }}
78:           {{ end }}
79:         send_resolved: true
80: 
81:   # Webhook — test receiver (web UI)
82:   - name: "webhook-alerts"
83:     webhook_configs:
84:       - url: "http://webhook-receiver:9095/webhook"
85:         send_resolved: true
86: 
87: # ============================================================
88: # Inhibition Rules
89: # ============================================================
90: inhibit_rules:
91:   - source_match:
92:       severity: "critical"
93:     target_match:
94:       severity: "warning"
95:     equal: ["instance"]
</file>

