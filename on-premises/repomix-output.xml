 7: apiVersion: 1
 8: 
 9: datasources:
10:   - name: Loki
11:     type: loki
12:     uid: loki-datasource
13:     access: proxy
14:     url: http://loki:3100
15:     isDefault: false
16:     editable: true
17:     jsonData:
18:       maxLines: 1000
