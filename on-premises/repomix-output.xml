126: async function checkHealth() {
127:     // API Gateway health (through nginx proxy)
128:     const gw = await api('/health');
129:     setHealthCard('health-api-gateway', gw.ok ? 'healthy' : 'down',
130:                   gw.ok ? 'Healthy' : 'Down');
131: 
132:     // Order service health (returns db + cache status)
133:     if (gw.ok && gw.data) {
134:         const osHealth = await api('/products');
135:         if (osHealth.ok) {
136:             setHealthCard('health-order-service', 'healthy', 'Healthy');
137:             const source = osHealth.data.source || 'unknown';
138:             setHealthCard('health-db', 'healthy', 'Connected');
139:             setHealthCard('health-cache', source === 'cache' ? 'healthy' : 'healthy',
140:                           source === 'cache' ? 'Hit' : 'Populated');
141:         } else {
142:             setHealthCard('health-order-service', 'down', 'Error');
143:             setHealthCard('health-db', 'degraded', 'Unknown');
144:             setHealthCard('health-cache', 'degraded', 'Unknown');
145:         }
146:     } else {
147:         setHealthCard('health-order-service', 'degraded', 'Unknown');
148:         setHealthCard('health-db', 'degraded', 'Unknown');
149:         setHealthCard('health-cache', 'degraded', 'Unknown');
150:     }
151: 
152:     // Notification Worker health
153:     const notifHealth = await notifApi('/health');
154:     setHealthCard('health-notification',
155:                   notifHealth.ok ? 'healthy' : 'down',
156:                   notifHealth.ok ? 'Healthy' : 'Down');
157: 
158:     // Inventory Worker health
159:     const invHealth = await invApi('/health');
160:     setHealthCard('health-inventory',
161:                   invHealth.ok ? 'healthy' : 'down',
162:                   invHealth.ok ? 'Healthy' : 'Down');
163: }
