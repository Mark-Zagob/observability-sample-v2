<file path="observability-vm/phase1-metrics/docker-compose.yml">
# ============================================================
# Phase 1: Metrics Foundation
# Prometheus + Grafana + Node Exporter + cAdvisor
# ============================================================
# Mục tiêu: Giám sát VM/host và Docker containers
# Chưa cần sample app — chỉ tập trung infrastructure metrics
# ============================================================

services:
  # ==========================================================
  # PROMETHEUS - Metrics Collection & Storage
  # ==========================================================
  # Prometheus là "trái tim" của hệ thống metrics.
  # Nó PULL (kéo) metrics từ các targets theo định kỳ.
  # ==========================================================
  prometheus:
    image: prom/prometheus:v3.10.0
    container_name: prometheus
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/alert_rules.yml:/etc/prometheus/alert_rules.yml:ro
      - ./prometheus/tracing_alert_rules.yml:/etc/prometheus/tracing_alert_rules.yml:ro
      - ./prometheus/recording_rules.yml:/etc/prometheus/recording_rules.yml:ro
      - ./prometheus/kafka_alert_rules.yml:/etc/prometheus/kafka_alert_rules.yml:ro
      - prometheus_data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=15d'       # Giữ data 15 ngày
      - '--web.enable-lifecycle'                    # Cho phép reload config qua API
      - '--web.enable-remote-write-receiver'        # Bật nhận remote write (hữu ích cho OTEL sau này)
      - '--enable-feature=exemplar-storage'          # Lưu exemplars (trace_id gắn với metrics)
    ports:
      - "9090:9090"
    networks:
      - observability
    restart: unless-stopped

  # ==========================================================
  # GRAFANA - Visualization & Dashboards
  # ==========================================================
  # Grafana là công cụ tạo dashboard, trực quan hoá metrics.
  # Nó kết nối tới Prometheus như một datasource.
  # ==========================================================
  grafana:
    image: grafana/grafana:12.3.3
    container_name: grafana
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD=admin123
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    ports:
      - "3000:3000"
    networks:
      - observability
    depends_on:
      - prometheus
    restart: unless-stopped

  # ==========================================================
  # NODE EXPORTER - Host/System Metrics
  # ==========================================================
  # Thu thập metrics của máy host: CPU, RAM, Disk, Network.
  # Đây là exporter phổ biến nhất của Prometheus.
  # ==========================================================
  node-exporter:
    image: prom/node-exporter:v1.10.2
    container_name: node-exporter
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - '--path.procfs=/host/proc'
      - '--path.rootfs=/rootfs'
      - '--path.sysfs=/host/sys'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
    ports:
      - "9100:9100"
    networks:
      - observability
    restart: unless-stopped

  # ==========================================================
  # cADVISOR - Container Metrics
  # ==========================================================
  # Thu thập metrics của Docker containers:
  # CPU, Memory, Network I/O, Disk I/O per container.
  # ==========================================================
  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.51.0
    container_name: cadvisor
    privileged: true
    devices:
      - /dev/kmsg:/dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    ports:
      - "8080:8080"
    networks:
      - observability
    restart: unless-stopped

  # ==========================================================
  # ALERTMANAGER - Alert Routing & Notification (Phase 4)
  # ==========================================================
  # Nhận alerts từ Prometheus → route theo severity
  # → gửi notification tới receivers (webhook, Slack, ...)
  # ==========================================================
  alertmanager:
    image: prom/alertmanager:v0.28.1
    environment:
      - TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
    container_name: alertmanager
    command:
      - '--config.file=/etc/alertmanager/alertmanager.yml'
      - '--storage.path=/alertmanager'
      - '--web.external-url=http://localhost:9093'
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - alertmanager_data:/alertmanager
    ports:
      - "9093:9093"
    networks:
      - observability
    restart: unless-stopped

  # ==========================================================
  # WEBHOOK RECEIVER - Test alert notifications
  # ==========================================================
  # Container đơn giản nhận webhook POST từ Alertmanager
  # và hiển thị trên web UI. Dùng để test trước khi cấu hình
  # Slack/Email thực tế.
  #
  # Web UI: http://<VM_IP>:9095
  # Webhook endpoint: http://webhook-receiver:9095/webhook
  # ==========================================================
  webhook-receiver:
    build: ./webhook-receiver
    container_name: webhook-receiver
    ports:
      - "9095:9095"
    networks:
      - observability
    restart: unless-stopped

  # ==========================================================
  # BLACKBOX EXPORTER - Active Health Check Probing
  # ==========================================================
  # Probe HTTP endpoints trên App VM để detect service down
  # mà không phụ thuộc vào traffic. Production-grade approach:
  # Prometheus → Blackbox → GET /health/live → service
  # ==========================================================
  blackbox-exporter:
    image: prom/blackbox-exporter:v0.25.0
    container_name: blackbox-exporter
    volumes:
      - ./blackbox/blackbox.yml:/etc/blackbox_exporter/config.yml:ro
    ports:
      - "9115:9115"
    networks:
      - observability
    restart: unless-stopped

volumes:
  prometheus_data:
  grafana_data:
  alertmanager_data:

# ==========================================================
# External Network
# ==========================================================
# Dùng external network để các phase sau (Loki, Tempo, ...)
# có thể join cùng network mà không cần sửa file này.
#
# Tạo network trước khi chạy:
#   docker network create observability
# ==========================================================
networks:
  observability:
    external: true
</file>

<file path="observability-vm/phase1-metrics/README.md">
# Phase 1: Metrics Foundation

## Prerequisites

- Docker Engine ≥ 24.x
- Docker Compose ≥ 2.x

## Quick Start

```bash
# 1. Tạo external network (chỉ cần 1 lần)
docker network create observability

# 2. Khởi chạy
docker compose up -d

# 3. Kiểm tra
docker compose ps
```

## Endpoints

| Service        | URL                      | Ghi chú               |
| -------------- | ------------------------ | ---------------------- |
| Prometheus     | http://<VM_IP>:9090      | Query, Targets, Alerts |
| Grafana        | http://<VM_IP>:3000      | admin / admin123       |
| Node Exporter  | http://<VM_IP>:9100      | Raw metrics            |
| cAdvisor       | http://<VM_IP>:8080      | Container metrics UI   |

## Dashboards (tự động load)

Vào Grafana → **Dashboards → folder "Infrastructure"**:

| Dashboard                    | Nội dung                                  |
| ---------------------------- | ----------------------------------------- |
| Node Exporter - Host         | CPU, Memory, Disk, Network của VM         |
| Docker Containers Monitoring | CPU, Memory, Network per container        |
| Prometheus Self-Monitoring   | Targets health, scrape, TSDB storage      |

## Quản lý

```bash
# Reload Prometheus config (không cần restart)
curl -X POST http://localhost:9090/-/reload

# Xem logs
docker compose logs -f prometheus
docker compose logs -f grafana

# Dừng
docker compose down

# Dừng + xoá data
docker compose down -v
```

## Cấu trúc

```
phase1-metrics/
├── docker-compose.yml
├── prometheus/
│   ├── prometheus.yml          # Scrape config
│   └── alert_rules.yml         # Alert rules
└── grafana/
    ├── dashboards/             # Dashboard JSON (as code)
    │   ├── node-exporter.json
    │   ├── docker-containers.json
    │   └── prometheus-self.json
    └── provisioning/
        ├── dashboards/
        │   └── dashboards.yml  # Dashboard provider
        └── datasources/
            └── prometheus.yml  # Datasource config
```
</file>

<file path="observability-vm/phase2-logging/alloy/config.alloy">
// ============================================================
// Grafana Alloy - Phase 2
// ============================================================
// Thu thập 3 loại logs:
//   1. Docker container logs (via Docker API)
//   2. Host system logs (/var/log/syslog)
//   3. Docker daemon logs (tạm bỏ — xem note bên dưới)
//
// Pipeline:
//   Source → Process (parse, extract, filter) → Push Loki
// ============================================================

// ============================================================
// PHẦN 1: DOCKER CONTAINER LOGS
// ============================================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_labels" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_labels.output
  forward_to = [loki.process.docker_pipeline.receiver]
}

// ============================================================
// LOG PROCESSING PIPELINE — Docker containers
// ============================================================
// Pipeline xử lý log trước khi push Loki:
//   1. Detect & drop health check noise
//   2. Thử parse JSON → extract structured fields
//   3. Nếu không phải JSON → parse logfmt
//   4. Extract log level thành label (để filter/query)
//   5. Thêm label source = "docker"
// ============================================================

loki.process "docker_pipeline" {
  // ---------------------------------------------------------
  // Stage 1: Drop health check logs
  // ---------------------------------------------------------
  // Nhiều service liên tục log "GET /health", "GET /ready"
  // → noise chiếm dung lượng, không có giá trị debug.
  // Drop trước khi parse để tiết kiệm CPU.
  // ---------------------------------------------------------
  stage.drop {
    expression = "(?i)(GET|HEAD)\\s+/(health|ready|healthz|livez|readyz)"
    drop_counter_reason = "health_check"
  }

  // ---------------------------------------------------------
  // Stage 2: Parse JSON logs
  // ---------------------------------------------------------
  // Hầu hết application hiện đại log theo structured JSON:
  //   {"level":"info","msg":"request handled","trace_id":"abc"}
  //
  // stage.json extract các field ra dạng "extracted values"
  // để các stage sau có thể dùng (label, template, output...).
  //
  // Nếu log KHÔNG phải JSON → stage này tự skip, không lỗi.
  // ---------------------------------------------------------
  stage.json {
    expressions = {
      level    = "level",
      msg      = "msg",
      caller   = "caller",
      trace_id = "trace_id",
      span_id  = "span_id",
    }
  }

  // ---------------------------------------------------------
  // Stage 3: Parse logfmt (fallback)
  // ---------------------------------------------------------
  // Một số service (ví dụ Prometheus, Loki) log dạng logfmt:
  //   level=info msg="server started" caller=main.go:42
  //
  // Nếu stage.json đã extract thành công → giá trị giữ nguyên.
  // Nếu chưa → stage.logfmt sẽ extract.
  // ---------------------------------------------------------
  stage.logfmt {
    mapping = {
      level  = "",
      msg    = "",
      caller = "",
      ts     = "",
    }
  }

  // ---------------------------------------------------------
  // Stage 4: Chuẩn hoá log level
  // ---------------------------------------------------------
  // Các service khác nhau dùng format level khác nhau:
  //   "INFO", "info", "warning", "warn", "WARN"
  // → Chuẩn hoá tất cả về lowercase để query nhất quán.
  // ---------------------------------------------------------
  stage.template {
    source   = "level"
    template = "{{ ToLower .Value }}"
  }

  // Map "warning" → "warn" cho nhất quán
  stage.replace {
    expression = "warning"
    source     = "level"
    replace    = "warn"
  }

  // ---------------------------------------------------------
  // Stage 5: Gán detected_level label
  // ---------------------------------------------------------
  // Tạo label "detected_level" từ extracted level.
  // → Cho phép query: {detected_level="error"}
  //
  // LƯU Ý: Chỉ dùng label có low cardinality
  // (debug/info/warn/error/fatal). KHÔNG BAO GIỜ đưa
  // high-cardinality fields (user_id, request_id) vào label.
  // ---------------------------------------------------------
  stage.labels {
    values = {
      detected_level = "level",
    }
  }

  // ---------------------------------------------------------
  // Stage 6: Gán static label source
  // ---------------------------------------------------------
  stage.static_labels {
    values = {
      source = "docker",
      vm     = "observability",
    }
  }

  // ---------------------------------------------------------
  // Stage 7: Drop noisy debug logs
  // ---------------------------------------------------------
  // Trong lab/dev, debug logs ít giá trị nhưng chiếm nhiều
  // dung lượng. Drop để giảm storage cost.
  // Comment out stage này nếu cần debug chi tiết.
  // ---------------------------------------------------------
  stage.drop {
    source           = "level"
    expression       = "debug"
    drop_counter_reason = "debug_level"
  }

  forward_to = [loki.write.loki_endpoint.receiver]
}

// ============================================================
// PHẦN 2: HOST SYSTEM LOGS
// ============================================================

local.file_match "syslog" {
  path_targets = [{
    __path__  = "/var/log/host/syslog",
    job       = "syslog",
    log_type  = "system",
  }]
}

loki.source.file "syslog" {
  targets    = local.file_match.syslog.targets
  forward_to = [loki.process.host_pipeline.receiver]
}

local.file_match "auth_log" {
  path_targets = [{
    __path__  = "/var/log/host/auth.log",
    job       = "auth",
    log_type  = "security",
  }]
}

loki.source.file "auth_log" {
  targets    = local.file_match.auth_log.targets
  forward_to = [loki.process.host_pipeline.receiver]
}

// ============================================================
// LOG PROCESSING PIPELINE — Host logs
// ============================================================
// Syslog format: "Mar 12 06:30:01 hostname service[pid]: message"
// Pipeline nhẹ hơn docker: chỉ thêm source label + parse
// severity cơ bản.
// ============================================================

loki.process "host_pipeline" {
  // ---------------------------------------------------------
  // Stage 1: Extract syslog fields
  // ---------------------------------------------------------
  // Parse syslog standard format để lấy hostname, service, PID.
  // Regex khớp: "Mar 12 06:30:01 myhost sshd[1234]: message"
  // ---------------------------------------------------------
  stage.regex {
    expression = "^\\w+\\s+\\d+\\s+[\\d:]+\\s+(?P<hostname>\\S+)\\s+(?P<syslog_service>[^\\[\\s:]+)"
  }

  stage.labels {
    values = {
      hostname       = "",
      syslog_service = "",
    }
  }

  // ---------------------------------------------------------
  // Stage 2: Detect severity từ nội dung
  // ---------------------------------------------------------
  // Syslog không có structured level, nhưng ta có thể detect
  // từ keywords: "error", "fail", "panic", "crit"
  // ---------------------------------------------------------
  stage.regex {
    expression = "(?i)(?P<severity>error|fail|panic|crit|warn|alert|emerg)"
  }

  stage.template {
    source   = "severity"
    template = "{{ if .Value }}{{ ToLower .Value }}{{ else }}info{{ end }}"
  }

  stage.labels {
    values = {
      detected_level = "severity",
    }
  }

  // ---------------------------------------------------------
  // Stage 3: Static label
  // ---------------------------------------------------------
  stage.static_labels {
    values = {
      source = "host",
      vm     = "observability",
    }
  }

  forward_to = [loki.write.loki_endpoint.receiver]
}

// ============================================================
// PHẦN 3: DOCKER DAEMON LOGS
// ============================================================
// Đã loại bỏ do Docker trên Ubuntu/Debian thường log thẳng vào
// Systemd Journal (journalctl), KHÔNG ghi ra /var/log/docker.log
// Việc đọc journald đòi hỏi mount cấu hình phức tạp hơn,
// nên tạm bỏ qua ở phase cơ bản này.
// ============================================================

// ============================================================
// PUSH VỀ LOKI
// ============================================================

loki.write "loki_endpoint" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
</file>

<file path="observability-vm/phase2-logging/loki/loki-config.yml">
# ============================================================
# Loki Configuration
# ============================================================
# Dựa trên config đã chạy ổn định với Loki 3.3.2
# Chế độ: monolithic (tất cả trong 1 process)
# Storage: MinIO (S3-compatible) — bucket "loki"
# ============================================================

auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096
  log_level: info

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  storage:
    s3:
      endpoint: minio:9000
      bucketnames: loki
      access_key_id: minioadmin
      secret_access_key: minioadmin
      insecure: true              # HTTP (không HTTPS) cho lab
      s3forcepathstyle: true      # Bắt buộc cho MinIO
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: s3
      schema: v13
      index:
        prefix: index_
        period: 24h

storage_config:
  tsdb_shipper:
    active_index_directory: /loki/tsdb-index
    cache_location: /loki/tsdb-cache

limits_config:
  retention_period: 168h         # 7 ngày
  reject_old_samples: true
  reject_old_samples_max_age: 168h  # Chấp nhận entries tối đa 7 ngày tuổi
  ingestion_rate_mb: 10
  ingestion_burst_size_mb: 20
  max_streams_per_user: 10000
  max_line_size: 256kb

compactor:
  working_directory: /loki/compactor
  compaction_interval: 10m
  retention_enabled: true
  retention_delete_delay: 2h
  delete_request_store: s3

analytics:
  reporting_enabled: false
</file>

<file path="observability-vm/phase2-logging/docker-compose.yml">
# ============================================================
# Phase 2: Logging
# Loki + Alloy
# ============================================================
# Mục tiêu: Thu thập và tập trung logs từ Docker containers
# Join cùng external network "observability" với Phase 1
# ============================================================

services:
  # ==========================================================
  # GRAFANA LOKI - Log Storage & Query Engine
  # ==========================================================
  # Loki lưu trữ logs và cho phép query bằng LogQL.
  # Khác Elasticsearch: Loki chỉ index LABELS, không index nội
  # dung log → rất nhẹ, ít tốn tài nguyên.
  # ==========================================================
  loki:
    image: grafana/loki:3.3.2
    container_name: loki
    volumes:
      - ./loki/loki-config.yml:/etc/loki/loki-config.yml:ro
      - loki_data:/loki
    command: -config.file=/etc/loki/loki-config.yml
    ports:
      - "3100:3100"
    networks:
      - observability
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:3100/ready || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s          # Cho Loki 30s để khởi tạo ring trước khi bắt đầu check

  # ==========================================================
  # GRAFANA ALLOY - Log Collector (thay thế Promtail)
  # ==========================================================
  # Alloy đọc logs từ Docker containers và push về Loki.
  # Nó tự động phát hiện containers qua Docker socket.
  #
  # Alloy = thế hệ mới, thay thế Promtail + Grafana Agent.
  # Có thể thu thập metrics, logs, traces trong 1 agent.
  # ==========================================================
  alloy:
    image: grafana/alloy:v1.13.2
    container_name: alloy
    user: root
    volumes:
      - ./alloy/config.alloy:/etc/alloy/config.alloy:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/log:/var/log/host:ro  # Host logs (syslog, auth.log, docker.log)
    command:
      - run
      - /etc/alloy/config.alloy
      - --storage.path=/var/lib/alloy/data
      - --server.http.listen-addr=0.0.0.0:12345
    ports:
      - "12345:12345"      # Alloy UI
    networks:
      - observability
    depends_on:
      loki:
        condition: service_healthy
    restart: unless-stopped

volumes:
  loki_data:

# ==========================================================
# External Network - cùng network với Phase 1
# ==========================================================
networks:
  observability:
    external: true
</file>

<file path="observability-vm/phase2-logging/README.md">
# Phase 2: Logging (Loki + Alloy)

## Prerequisites

- Phase 1 đang chạy (Grafana cần restart để nhận datasource Loki)
- External network `observability` đã tạo

## Quick Start

```bash
# 1. Khởi chạy Loki + Alloy
cd /root/workspace/observability-lab/phase2-logging
docker compose up -d

# 2. Restart Grafana để load datasource Loki mới
cd /root/workspace/observability-lab/phase1-metrics
docker compose restart grafana

# 3. Kiểm tra
docker compose -f /root/workspace/observability-lab/phase2-logging/docker-compose.yml ps
```

## Endpoints

| Service | URL                  | Ghi chú                |
| ------- | -------------------- | ---------------------- |
