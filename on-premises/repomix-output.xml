 1: FROM nginxinc/nginx-unprivileged:alpine
 2: 
 3: # === Metadata ===
 4: LABEL maintainer="observability-lab"
 5: LABEL service="web-ui"
 6: 
 7: # === Application files ===
 8: COPY nginx.conf /etc/nginx/conf.d/default.conf
 9: COPY index.html /usr/share/nginx/html/index.html
10: COPY style.css  /usr/share/nginx/html/style.css
11: COPY app.js     /usr/share/nginx/html/app.js
12: 
13: # === Health check ===
14: # Use 127.0.0.1 (not localhost) because nginx-unprivileged
15: # doesn't enable IPv6 listening, and BusyBox wget resolves
16: # localhost to ::1 first → "Connection refused".
17: HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
18:   CMD wget -q --spider http://127.0.0.1:8080/ || exit 1
19: 
20: EXPOSE 8080
</file>

