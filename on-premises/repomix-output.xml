 1: """
 2: RFC 7807 Problem Details — standardized error responses.
 3: 
 4: See: https://datatracker.ietf.org/doc/html/rfc7807
 5: """
 6: from flask import jsonify, make_response
 7: from opentelemetry import trace
 8: 
 9: 
10: def problem_response(status, title, detail, instance=None, extra=None):
11:     """Create an RFC 7807 Problem Details response.
12: 
13:     Args:
14:         status: HTTP status code (e.g., 404, 409, 500)
15:         title: Short human-readable summary (e.g., "Out of Stock")
16:         detail: Detailed explanation (e.g., "Product 5 has 3 units, need 10")
17:         instance: URI reference for this specific occurrence (e.g., "/process")
18:         extra: Dict of additional fields to include in the response body
19: 
20:     Returns:
21:         Flask response with application/problem+json content type
22:     """
23:     body = {
24:         "type": "about:blank",
25:         "title": title,
26:         "status": status,
27:         "detail": detail,
28:     }
29: 
30:     if instance:
31:         body["instance"] = instance
32: 
33:     # Include trace_id for correlation with observability stack
34:     span = trace.get_current_span()
35:     span_context = span.get_span_context()
36:     if span_context and span_context.trace_id:
37:         body["trace_id"] = format(span_context.trace_id, "032x")
38: 
39:     if extra:
40:         body.update(extra)
41: 
42:     response = make_response(jsonify(body), status)
43:     response.content_type = "application/problem+json"
44:     return response
</file>

<file path="applications-vm/applications/shared/health.py">
 1: """
 2: Standardized health check endpoints — liveness and readiness.
 3: 
 4: Usage:
 5:     from shared.health import create_health_blueprint
 6: 
 7:     health_bp = create_health_blueprint("order-service", checks={
 8:         "db": lambda: db.check_health(),
 9:         "cache": lambda: cache.check_health(),
10:     })
11:     app.register_blueprint(health_bp)
12: """
13: import time
14: from flask import Blueprint, jsonify
15: 
16: 
17: def create_health_blueprint(service_name, checks=None):
18:     """Create a Flask blueprint with /health/live and /health/ready endpoints.
19: 
20:     Args:
21:         service_name: Name of the service for response body
22:         checks: Dict of {name: callable} — each callable should return True
23:                 or raise on failure. Used for readiness checks.
24: 
25:     Returns:
26:         Flask Blueprint with health endpoints
27:     """
28:     bp = Blueprint("health", __name__)
29:     _start_time = time.time()
30: 
31:     @bp.route("/health/live")
32:     def liveness():
33:         """Liveness: is the process running? Always 200 unless crashed."""
34:         return jsonify({
35:             "status": "up",
36:             "service": service_name,
37:         }), 200
38: 
39:     @bp.route("/health/ready")
40:     def readiness():
41:         """Readiness: can this service handle traffic?
42:         Checks all registered dependencies."""
43:         result = {
44:             "status": "ready",
45:             "service": service_name,
46:             "uptime_seconds": round(time.time() - _start_time, 1),
47:             "checks": {},
48:         }
49:         status_code = 200
50: 
51:         if checks:
52:             for name, check_fn in checks.items():
53:                 try:
54:                     check_fn()
55:                     result["checks"][name] = "ok"
56:                 except Exception as e:
57:                     result["checks"][name] = f"error: {str(e)}"
58:                     result["status"] = "not_ready"
59:                     status_code = 503
60: 
61:         return jsonify(result), status_code
62: 
63:     # Keep /health as alias for /health/ready (backward compatibility)
64:     @bp.route("/health")
65:     def health_alias():
66:         return readiness()
67: 
68:     return bp
</file>

<file path="applications-vm/applications/shared/kafka_utils.py">
 1: """
 2: Kafka utilities — shared across services that produce/consume Kafka events.
 3: """
 4: from opentelemetry.propagate import extract
 5: 
 6: 
 7: def extract_trace_context(headers):
 8:     """Extract OTel trace context from Kafka message headers.
 9: 
10:     Args:
11:         headers: Kafka message headers (list of tuples)
12: 
13:     Returns:
14:         OTel context or None
15:     """
16:     if not headers:
17:         return None
18:     carrier = {}
19:     for key, value in headers:
20:         if isinstance(value, bytes):
21:             carrier[key] = value.decode("utf-8")
22:         else:
23:             carrier[key] = str(value)
24:     return extract(carrier)
</file>

<file path="applications-vm/applications/shared/logging_config.py">
 1: """
 2: Structured JSON logging setup — shared across all services.
 3: """
 4: import logging
 5: from pythonjsonlogger import json as json_logger
 6: 
 7: 
 8: def setup_logging(name, level=logging.INFO):
 9:     """Configure structured JSON logging for a service.
10: 
11:     Args:
12:         name: Logger name (e.g., "order-service")
13:         level: Logging level (default: INFO)
14: 
15:     Returns:
16:         Configured logger instance
17:     """
18:     handler = logging.StreamHandler()
19:     handler.setFormatter(json_logger.JsonFormatter(
20:         fmt="%(asctime)s %(levelname)s %(name)s %(message)s",
21:         rename_fields={"asctime": "timestamp", "levelname": "level"},
22:     ))
23:     logging.basicConfig(level=level, handlers=[handler])
24:     return logging.getLogger(name)
