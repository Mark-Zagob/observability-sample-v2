      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "expr": "predict_linear(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\",vm=~\"$vm\"}[1d], 0) / -deriv(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\",vm=~\"$vm\"}[1d]) > 0 or vector(9999999)",
          "legendFormat": "{{ vm }} /"
        }
