42:   # ==========================================================
43: 
44:   cadvisor:
45:     image: gcr.io/cadvisor/cadvisor:v0.51.0
46:     container_name: cadvisor
47:     volumes:
48:       - /:/rootfs:ro
49:       - /var/run:/var/run:ro
50:       - /sys:/sys:ro
51:       - /var/lib/docker/:/var/lib/docker:ro
52:       - /dev/disk/:/dev/disk:ro
53:     ports:
54:       - "8080:8080"         # Expose ra ngoài để Prometheus scrape
55:     networks:
56:       - observability
57:     restart: unless-stopped
58:     privileged: true
59:     devices:
60:       - /dev/kmsg:/dev/kmsg
61: 
62:   # ==========================================================
63:   # GRAFANA ALLOY — Log Collector
64:   # ==========================================================
65:   # Thu thập Docker container logs + host logs
