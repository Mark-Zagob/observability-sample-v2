# terraform/modules/compute/ecs-service/otel-config-aws.yaml.tftpl
#--------------------------------------------------------------
# ADOT Collector Configuration — Production-Grade
# Template Variables: ${aws_region}, ${sampling_rate}
#--------------------------------------------------------------

extensions:
  # 🛡️ SigV4 Auth: Dùng IAM Role của Task ký request lên AMP (Zero hardcoded keys)
  sigv4auth:
    service: "aps"
    region: "${aws_region}"

  # 🏥 HEALTH CHECK EXTENSION (MỚI)
  # Expose HTTP endpoint tại localhost:13133 để ECS Agent probe.
  # Nếu OTel Collector process bị deadlock/crash, endpoint này trả 503 -> ECS restart sidecar.
  health_check:
    endpoint: "0.0.0.0:13133"
    path: "/"

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: "0.0.0.0:4317"
      http:
        endpoint: "0.0.0.0:4318"

  # NEW: Scrape self-metrics từ chính OTel Collector
  prometheus/self_metrics:
    config:
      scrape_configs:
        - job_name: 'otel-collector'
          scrape_interval: 30s
          static_configs:
            - targets: ['0.0.0.0:8888']
          metric_relabel_configs:
            # Chỉ giữ lại các metric quan trọng, tránh cardinality bomb
            - source_labels: [__name__]
              regex: 'otelcol_(exporter_sent_failed|processor_dropped|process_memory|receiver_accepted).*'
              action: keep

processors:
  # 🛡️ APP RESILIENCE — Bảo vệ Sidecar khỏi OOM khi App spike
  memory_limiter:
    check_interval: 1s
    limit_mib: 128
    spike_limit_mib: 32

  # ⚠️ ADOT không hỗ trợ "transform" processor (chỉ có trong OTel Contrib).
  # Dùng "attributes" processor thay thế — nằm trong danh sách ADOT supported.
  attributes/sanitize_labels:
    actions:
      - key: user_id
        action: delete
      - key: session_id
        action: delete
      - key: request_id
        action: delete
      - key: trace_id
        action: delete  # Trace ID chỉ nên ở Traces, không nên ở Metrics

  # ⚡ BATCH — Gom telemetry lại trước khi export (giảm API calls, giảm chi phí)
  batch:
    timeout: 5s
    send_batch_size: 1000

  # 💰 FINOPS GUARDRAIL #1 — Drop health check probes (Cardinality Bomb)
  filter/drop_health:
    error_mode: ignore
    traces:
      span:
        - 'attributes["http.route"] == "/health/live"'
        - 'attributes["http.route"] == "/health/ready"'
        - 'attributes["http.route"] == "/health"'
    metrics:
      datapoint:
        - 'attributes["http.route"] == "/health/live"'
        - 'attributes["http.route"] == "/health/ready"'
        - 'attributes["http.route"] == "/health"'

  # 💰 FINOPS GUARDRAIL #2 (MỚI) — Sampling Strategy
  # - Giữ 100% traces có ERROR (để debug)
  # - Chỉ giữ ${sampling_rate}% traces thành công (để tiết kiệm X-Ray cost)
  # Khi traffic thấp (Phase 1-2), set sampling_rate = 100
  # Khi traffic cao (Phase 4+), giảm xuống 10 hoặc 5
  probabilistic_sampler:
    sampling_percentage: ${sampling_rate}
    # Hash seed đảm bảo cùng 1 trace luôn được sample thống nhất
    # trên mọi services (Order -> Payment -> Worker đều quyết định giống nhau)
    hash_seed: 22

  # 🆕 NEW: Processor riêng cho self-metrics (không cần sampling/filter)
  batch/self_metrics:
    timeout: 10s
    send_batch_size: 100
  # 🎯 ADVANCED: Tail-based Sampling (Optional — uncomment khi scale lớn)
  # Giữ lại 100% traces có lỗi HOẶC latency > 2s, drop phần còn lại.
  # Lưu ý: tail_sampling tốn RAM hơn vì phải buffer traces để quyết định.
  # tail_sampling:
  #   decision_wait: 10s       # Chờ 10s để collect toàn bộ spans của trace
  #   num_traces: 1000         # Buffer tối đa 1000 traces
  #   expected_new_traces_per_sec: 100
  #   policies:
  #     - name: errors-policy
  #       type: status_code
  #       status_code: {status_codes: [ERROR]}
  #     - name: latency-policy
  #       type: latency
  #       latency: {threshold_ms: 2000}
  #     - name: default-rate
  #       type: probabilistic
  #       probabilistic: {sampling_percentage: ${sampling_rate}}

exporters:
  # Traces -> AWS X-Ray
  awsxray:
    region: "${aws_region}"
    # 🌟 Index tất cả attributes để query được trên X-Ray Console
    index_all_attributes: true

  # Metrics -> Amazon Managed Prometheus (AMP)
  prometheusremotewrite:
    # Escape "$$" cho Terraform templatefile → output ra literal dollar-brace
    # cho OTel Collector đọc biến môi trường AMP_ENDPOINT từ ECS Task Definition
    endpoint: "$${env:AMP_ENDPOINT}"
    auth:
      authenticator: sigv4auth
    # 🌟 Biến resource attributes (service.name, service.version) thành labels
    resource_to_telemetry_conversion:
      enabled: true

  # 🆕 NEW: Push self-metrics về CloudWatch qua EMF format
  awsemf/self_metrics:
    region: "${aws_region}"
    namespace: 'ObsLab/TelemetryPipeline'
    # Dùng LẠI log group đã được Terraform tạo sẵn (/ecs/<project>/<service>/otel)
    # thay vì log group riêng — tránh phải thêm quyền logs:CreateLogGroup cho
    # task role và tránh silent-fail nếu log group chưa tồn tại.
    log_group_name: '/ecs/$${env:PROJECT_NAME}/$${env:SERVICE_NAME}/otel'
    log_stream_name: 'self-metrics-{ServiceName}'
    dimension_rollup_option: NoDimensionRollup
    metric_declarations:
      # Metric 1: Export failures (cho Drill 8)
      - dimensions: [[service_name]]
        metric_name_selectors:
          - otelcol_exporter_send_failed_spans
          - otelcol_exporter_send_failed_metric_points
      
      # Metric 2: Dropped data (cho Drill 7)
      - dimensions: [[service_name]]
        metric_name_selectors:
          - otelcol_processor_dropped_spans
          - otelcol_processor_dropped_metric_points
      
      # Metric 3: Accepted data (để tính Data Loss %)
      - dimensions: [[service_name]]
        metric_name_selectors:
          - otelcol_receiver_accepted_spans
          - otelcol_receiver_accepted_metric_points
      
      # Metric 4: Resource usage (cho monitoring)
      - dimensions: [[service_name]]
        metric_name_selectors:
          - otelcol_process_memory_rss
          - otelcol_process_cpu_seconds

service:
  # 🏥 BẮT BUỘC: Khai báo health_check trong extensions list
  extensions: [health_check, sigv4auth]

  # 📋 Telemetry nội bộ của chính OTel Collector (self-monitoring)
  telemetry:
    logs:
      level: "info"
    metrics:
      level: "detailed" # 🆕 Đổi từ "basic" → "detailed" để có đầy đủ metrics
      # 🆕 Expose self-metrics qua Prometheus format trên :8888 để
      # receiver `prometheus/self_metrics` ở trên scrape được.
      # Thiếu block này → port 8888 không listen → scrape fail →
      # pipeline metrics/self không có data → dashboard "ADOT Span Drop"
      # / "AMP Export Failures" / "Data Loss %" đều no-data.
      readers:
        - pull:
            exporter:
              prometheus:
                host: "0.0.0.0"
                port: 8888

  pipelines:
    traces:
      receivers: [otlp]
      # 🌟 THỨ TỰ PROCESSORS RẤT QUAN TRỌNG:
      # 1. memory_limiter (bảo vệ RAM trước)
      # 2. filter/drop_health (drop rác)
      # 3. probabilistic_sampler (drop bớt để giảm cost)
      # 4. batch (gom lại trước khi export)
      processors:
        - memory_limiter
        - filter/drop_health
        - probabilistic_sampler
        - batch
      exporters: [awsxray]

    metrics:
      receivers: [otlp]
      processors:
        - memory_limiter
        - filter/drop_health
        - batch
      exporters: [prometheusremotewrite]

    # 🆕 SELF-METRICS PIPELINE (Drill 7/8/9 dashboard panels)
    # Flow: OTel telemetry.readers export ra :8888 (Prometheus format)
    #   → prometheus/self_metrics receiver scrape :8888
    #   → batch/self_metrics gom lại
    #   → awsemf/self_metrics push lên CloudWatch dưới namespace
    #     'ObsLab/TelemetryPipeline' (match với dashboard queries).
    # Thiếu pipeline này → receiver + exporter tồn tại nhưng không
    # được wire → không có data flow.
    metrics/self:
      receivers: [prometheus/self_metrics]
      processors: [batch/self_metrics]
      exporters: [awsemf/self_metrics]