{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📦 Order Service — RED",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Rate — Orders Created",
      "description": "Orders created per second, grouped by status",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(orders_created_total[5m])) by (status)", "legendFormat": "{{ status }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s", "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Duration — Processing Latency (P50 / P95 / P99)",
      "description": "End-to-end order processing duration percentiles",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Errors — Infrastructure Error Rate",
      "description": "Tỷ lệ lỗi hạ tầng (payment_error, db_error, kafka_error). Traffic Guard: no data khi RPS < 0.1",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "(sum(rate(orders_created_total{status=~\"payment_error|db_error|kafka_error|unknown_error\"}[5m])) / (sum(rate(orders_created_total[5m])) or vector(1))) and (sum(rate(orders_created_total[5m])) > 0.1)", "legendFormat": "Infra Error Rate" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "id": 4,
      "title": "💼 Business — Order Success Rate",
      "description": "Tỷ lệ đơn hàng hoàn thành thành công",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "sum(rate(orders_created_total{status=\"completed\"}[5m])) / (sum(rate(orders_created_total[5m])) or vector(1))", "legendFormat": "Success Rate" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s", "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "id": 5,
      "title": "DB Query Latency (P50 / P95)",
      "description": "Database query duration percentiles",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(db_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s", "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 6,
      "title": "DB Pool Wait Duration (P95)",
      "description": "Time waiting for a connection from the pool — high value indicates pool saturation",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(db_pool_wait_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 101,
      "title": "💳 Payment Service — RED",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "id": 7,
      "title": "Rate — Payment Requests",
      "description": "Payment transactions per second by status",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(payments_total[5m])) by (status)", "legendFormat": "{{ status }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s", "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "id": 8,
      "title": "Duration — Gateway Latency by Provider (P95)",
      "description": "External payment gateway call duration P95 per provider",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(payment_gateway_duration_seconds_bucket[5m])) by (le, provider))", "legendFormat": "{{ provider }} P95" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.15 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "id": 9,
      "title": "💼 Business — Gateway Failure Rate",
      "description": "Tỷ lệ giao dịch bị từ chối bởi Payment Gateway. Baseline ~10%.",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "(sum(rate(payments_total{status=\"failed\"}[5m])) or vector(0)) / (sum(rate(payments_total[5m])) or vector(1)) and (sum(rate(payments_total[5m])) > 0.1)", "legendFormat": "Gateway Failure Rate" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "currencyUSD", "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 10,
      "title": "Payment Amount (Average by Provider)",
      "description": "Average payment amount in USD per provider",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(payment_amount_dollars_sum[5m])) by (provider) / sum(rate(payment_amount_dollars_count[5m])) by (provider)", "legendFormat": "{{ provider }} avg" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 11,
      "title": "Payments (by Status & Provider)",
      "description": "Business view: payment outcomes per provider",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(payments_total[5m])) by (status, provider)", "legendFormat": "{{ provider }} — {{ status }}" }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 102,
      "title": "📈 End-to-End Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 12,
      "title": "Service Latency Comparison (P95)",
      "description": "P95 latency side-by-side to identify bottlenecks",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Order Service" },
        { "expr": "histogram_quantile(0.95, sum(rate(payment_gateway_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Payment Gateway" },
        { "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "DB Query" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 13,
      "title": "Throughput Comparison",
      "description": "Operations per second across both services",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(orders_created_total[5m]))", "legendFormat": "Orders" },
        { "expr": "sum(rate(payments_total[5m]))", "legendFormat": "Payments" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "green", "value": 0.1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 43 },
      "id": 14,
      "title": "🚦 Traffic Guard Status — RPS (all red = no traffic → error panels show 'No Data')",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "expr": "sum(rate(orders_created_total[5m]))", "legendFormat": "Order Service RPS" },
        { "expr": "sum(rate(payments_total[5m]))", "legendFormat": "Payment Service RPS" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["application", "microservices", "red-method", "aws", "pod-1"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "POD 1 — The Illumination (Order + Payment)",
  "uid": "pod1-illumination",
  "version": 1
}
