{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📦 Order Service — RED",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Rate — Orders Created",
      "description": "Orders created per second, grouped by status",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(orders_created_total{traffic_source=~\"$traffic_source\"}[5m])) by (status)", "legendFormat": "{{ status }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s", "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "links": [
            {
              "title": "🔍 Mở AWS X-Ray (Đồng bộ thời gian spike)",
              "url": "https://${aws_region}.console.aws.amazon.com/xray/home?region=${aws_region}#/traces?filter=service(id(name:%20%22order-service%22))&timeRange=$${__from:date:seconds}-$${__to:date:seconds}",
              "targetBlank": true
            }
          ]
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Duration — Processing Latency (P50 / P95 / P99)",
      "description": "End-to-end order processing duration percentiles",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Errors — Infrastructure Error Rate",
      "description": "Tỷ lệ lỗi hạ tầng (payment_error, db_error, kafka_error). Traffic Guard: no data khi RPS < 0.1",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "(sum(rate(orders_created_total{status=~\"payment_error|db_error|kafka_error|unknown_error\", traffic_source=~\"$traffic_source\"}[5m])) / (sum(rate(orders_created_total{traffic_source=~\"$traffic_source\"}[5m])) or vector(1))) and (sum(rate(orders_created_total{traffic_source=~\"$traffic_source\"}[5m])) > 0.1)", "legendFormat": "Infra Error Rate" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "id": 4,
      "title": "💼 Business — Order Success Rate",
      "description": "Tỷ lệ đơn hàng hoàn thành thành công",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "sum(rate(orders_created_total{status=\"completed\", traffic_source=~\"$traffic_source\"}[5m])) / (sum(rate(orders_created_total{traffic_source=~\"$traffic_source\"}[5m])) or vector(1))", "legendFormat": "Success Rate" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s", "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "id": 5,
      "title": "DB Query Latency (P50 / P95)",
      "description": "Database query duration percentiles",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(db_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s", "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 6,
      "title": "DB Pool Wait Duration (P95)",
      "description": "Time waiting for a connection from the pool — high value indicates pool saturation",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(db_pool_wait_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 101,
      "title": "💳 Payment Service — RED",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "✅ CLOSED", "color": "green" },
                "1": { "text": "🚨 OPEN", "color": "red" },
                "2": { "text": "⚠️ HALF-OPEN", "color": "yellow" }
              }
            }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "id": 16,
      "title": "🛡️ Circuit Breaker Status",
      "description": "Current state of payment gateway circuit breaker. OPEN = all requests fail-fast (503).",
      "type": "stat",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "payment_circuit_breaker_state{breaker=\"payment_gateway\"}",
          "legendFormat": "State"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 18 },
      "id": 17,
      "title": "🚫 Circuit Breaker Rejections",
      "description": "Requests rejected by open circuit breaker (fail-fast 503). Spike here = gateway is down.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(payment_circuit_breaker_rejections_total[5m]))",
          "legendFormat": "Rejections/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 7,
      "title": "Rate — Payment Requests",
      "description": "Payment transactions per second by status",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(payments_total{traffic_source=~\"$traffic_source\"}[5m])) by (status)", "legendFormat": "{{ status }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s", "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "id": 8,
      "title": "Duration — Gateway Latency by Provider (P95)",
      "description": "External payment gateway call duration P95 per provider",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(payment_gateway_duration_seconds_bucket[5m])) by (le, provider))", "legendFormat": "{{ provider }} P95" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.15 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "id": 9,
      "title": "💼 Business — Gateway Failure Rate",
      "description": "Tỷ lệ giao dịch bị từ chối bởi Payment Gateway. Baseline ~10%.",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "(sum(rate(payments_total{status=\"failed\", traffic_source=~\"$traffic_source\"}[5m])) or vector(0)) / (sum(rate(payments_total{traffic_source=~\"$traffic_source\"}[5m])) or vector(1)) and (sum(rate(payments_total{traffic_source=~\"$traffic_source\"}[5m])) > 0.1)", "legendFormat": "Gateway Failure Rate" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "currencyUSD", "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "id": 10,
      "title": "Payment Amount (Average by Provider)",
      "description": "Average payment amount in USD per provider",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(payment_amount_dollars_sum[5m])) by (provider) / sum(rate(payment_amount_dollars_count[5m])) by (provider)", "legendFormat": "{{ provider }} avg" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "id": 11,
      "title": "Payments (by Status & Provider)",
      "description": "Business view: payment outcomes per provider",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(payments_total{traffic_source=~\"$traffic_source\"}[5m])) by (status, provider)", "legendFormat": "{{ provider }} — {{ status }}" }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "id": 102,
      "title": "📈 End-to-End Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "id": 12,
      "title": "Service Latency Comparison (P95)",
      "description": "P95 latency side-by-side to identify bottlenecks",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(order_processing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Order Service" },
        { "expr": "histogram_quantile(0.95, sum(rate(payment_gateway_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Payment Gateway" },
        { "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "DB Query" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps", "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "id": 13,
      "title": "Throughput Comparison",
      "description": "Operations per second across both services",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(orders_created_total{traffic_source=~\"$traffic_source\"}[5m]))", "legendFormat": "Orders" },
        { "expr": "sum(rate(payments_total{traffic_source=~\"$traffic_source\"}[5m]))", "legendFormat": "Payments" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "green", "value": 0.1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 51 },
      "id": 14,
      "title": "🚦 Traffic Guard Status — RPS (all red = no traffic → error panels show 'No Data')",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "expr": "sum(rate(orders_created_total{traffic_source=~\"$traffic_source\"}[5m]))", "legendFormat": "Order Service RPS" },
        { "expr": "sum(rate(payments_total{traffic_source=~\"$traffic_source\"}[5m]))", "legendFormat": "Payment Service RPS" }
      ]
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 55 },
      "id": 15,
      "title": "📊 ECS Task Health (Order + Payment)",
      "description": "RunningTaskCount vs DesiredCount. Nếu Running < Desired → service đang crash/scale-in. Dùng để detect Chaos Drill impact ngay.",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "AWS/ECS",
          "metricName": "RunningTaskCount",
          "dimensions": { "ClusterName": "obs-cluster", "ServiceName": "order-service" },
          "statistics": ["Average"],
          "period": "60",
          "label": "Order - Running"
        },
        {
          "queryMode": "Metrics",
          "namespace": "AWS/ECS",
          "metricName": "DesiredTaskCount",
          "dimensions": { "ClusterName": "obs-cluster", "ServiceName": "order-service" },
          "statistics": ["Average"],
          "period": "60",
          "label": "Order - Desired"
        },
        {
          "queryMode": "Metrics",
          "namespace": "AWS/ECS",
          "metricName": "RunningTaskCount",
          "dimensions": { "ClusterName": "obs-cluster", "ServiceName": "payment-service" },
          "statistics": ["Average"],
          "period": "60",
          "label": "Payment - Running"
        },
        {
          "queryMode": "Metrics",
          "namespace": "AWS/ECS",
          "metricName": "DesiredTaskCount",
          "dimensions": { "ClusterName": "obs-cluster", "ServiceName": "payment-service" },
          "statistics": ["Average"],
          "period": "60",
          "label": "Payment - Desired"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 64 },
      "id": 200,
      "title": "🩺 Pipeline Health & Meta-Monitoring (Chaos Drills 7-10)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 65 },
      "id": 201,
      "title": "💓 Telemetry Heartbeat (App Metrics Flow)",
      "description": "Đếm số lượng service đang gửi metric lên AMP. Nếu = 0 -> ADOT đã chết (Exp 10) hoặc mất IAM (Exp 8).",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "mappings": [{ "type": "value", "options": { "0": { "text": "PIPELINE DEAD", "color": "red" } } }]
        }
      },
      "targets": [{ "expr": "count(count by (service_name) (rate(orders_created_total[5m]) > 0))", "legendFormat": "Active Services" }]
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 65 },
      "id": 202,
      "title": "⚡ ADOT Span Drop Rate (Drill 7 - Trace Storm)",
      "description": "Số spans bị memory_limiter drop CHÍNH XÁC (không phải đếm log events). Dùng để tính Data Loss % khi post-mortem.",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "✅ No Drops",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        }
      },
      "targets": [{
        "queryMode": "Metrics",
        "namespace": "ObsLab/TelemetryPipeline",
        "metricName": "otelcol_processor_dropped_spans",
        "dimensions": { "service_name": "order-service" },
        "statistics": ["Sum"],
        "period": "60",
        "label": "Dropped Spans (real count)"
      }]
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 65 },
      "id": 203,
      "title": "🚨 AMP Export Failures (Drill 8 - Silent Blinder)",
      "description": "Số spans/metrics ADOT không thể push lên AMP do IAM issues. > 0 = Pipeline đang mù metrics.",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "✅ No Failures",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "ObsLab/TelemetryPipeline",
          "metricName": "otelcol_exporter_send_failed_spans",
          "dimensions": { "service_name": "order-service" },
          "statistics": ["Sum"],
          "period": "60",
          "label": "Failed Spans"
        },
        {
          "queryMode": "Metrics",
          "namespace": "ObsLab/TelemetryPipeline",
          "metricName": "otelcol_exporter_send_failed_metric_points",
          "dimensions": { "service_name": "order-service" },
          "statistics": ["Sum"],
          "period": "60",
          "label": "Failed Metrics"
        }
      ]
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 71 },
      "id": 204,
      "title": "📉 Data Loss % (Dropped / Accepted)",
      "description": "Tỷ lệ telemetry bị mất. < 1% = OK, > 10% = cần tăng ADOT RAM.",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "noValue": "0",
          "mappings": [
            { "type": "range", "options": { "from": 0, "to": 0, "result": { "text": "✅ No Loss", "color": "green" } } },
            { "type": "range", "options": { "from": 0.001, "to": 0.01, "result": { "text": "⚠️ Minor Loss", "color": "yellow" } } },
            { "type": "range", "options": { "from": 0.01, "to": 1, "result": { "text": "🔴 Data Loss!", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "ObsLab/TelemetryPipeline",
          "metricName": "otelcol_processor_dropped_spans",
          "dimensions": {},
          "statistics": ["Sum"],
          "period": "60",
          "refId": "dropped",
          "id": "dropped",
          "hide": true
        },
        {
          "queryMode": "Metrics",
          "namespace": "ObsLab/TelemetryPipeline",
          "metricName": "otelcol_receiver_accepted_spans",
          "dimensions": {},
          "statistics": ["Sum"],
          "period": "60",
          "refId": "accepted",
          "id": "accepted",
          "hide": true
        },
        {
          "expression": "IF(accepted > 100, dropped / accepted, 0)",
          "refId": "loss_percent",
          "id": "loss_percent",
          "label": "Loss %",
          "region": "${aws_region}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 71 },
      "id": 207,
      "title": "🎯 Business Impact (User Pain Score)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 72 },
      "id": 205,
      "title": "😭 User Pain Score (Browser Traffic Only)",
      "description": "Tỷ lệ user THẬT bị lỗi. Không bị nhiễu bởi Synthetic Loadtest khi chạy Chaos Drill.",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] }
        }
      },
      "targets": [{
        "expr": "1 - (sum(rate(orders_created_total{status=\"completed\", traffic_source=\"browser\"}[15m])) / sum(rate(orders_created_total{traffic_source=\"browser\"}[15m])))",
        "legendFormat": "Pain %"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 72 },
      "id": 206,
      "title": "📉 Order Success Rate (Filtered by $traffic_source)",
      "type": "timeseries",
      "targets": [{
        "expr": "sum(rate(orders_created_total{status=\"completed\", traffic_source=~\"$traffic_source\"}[5m])) / sum(rate(orders_created_total{traffic_source=~\"$traffic_source\"}[5m]))",
        "legendFormat": "Success Rate"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 78 },
      "id": 300,
      "title": "🖥️ ECS Fargate Resource (USE Method) — Blind Spot Killer",
      "type": "row"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 79 },
      "id": 301,
      "title": "🔥 Order Service: CPU Utilization vs Throttling",
      "description": "Nếu Utilization chạm 100% -> Fargate throttling CPU -> App chậm dù không có lỗi code. (Exp 3.5)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" } }
      },
    "targets": [
      {
        "queryMode": "Metrics",
        "namespace": "ECS/ContainerInsights",
        "metricName": "CpuUtilized",
        "dimensions": {
          "ClusterName": "obs-cluster",
          "ServiceName": "order-service"
        },
        "statistics": ["Average"],
        "period": "60",
        "label": "CPU Utilized (CPU Units)",
        "refId": "A"
      },
      {
        "queryMode": "Metrics",
        "namespace": "ECS/ContainerInsights",
        "metricName": "CpuReserved",
        "dimensions": {
          "ClusterName": "obs-cluster",
          "ServiceName": "order-service"
        },
        "statistics": ["Average"],
        "period": "60",
        "label": "CPU Reserved (CPU Units)",
        "refId": "B"
      }
    ]
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 79 },
      "id": 302,
      "title": "💾 Order Service: Memory Utilization (OOM Predictor)",
      "description": "Leading indicator cho Exp 3B (OOM Kill). Alarm fire khi > 85%.",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "AWS/ECS",
          "metricName": "MemoryUtilization",
          "dimensions": { "ClusterName": "obs-cluster", "ServiceName": "order-service" },
          "statistics": ["Average", "Maximum"],
          "period": "60",
          "legendFormat": "Mem {{stat}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 87 },
      "id": 304,
      "title": "🔥 Payment Service: CPU Utilization vs Throttling",
      "description": "Nếu Utilization chạm 100% → Fargate throttling CPU → Payment timeout → Order cascade failure.",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "ECS/ContainerInsights",
          "metricName": "CpuUtilized",
          "dimensions": { "ClusterName": "obs-cluster", "ServiceName": "payment-service" },
          "statistics": ["Average"],
          "period": "60",
          "label": "CPU Utilized (CPU Units)",
          "refId": "A"
        },
        {
          "queryMode": "Metrics",
          "namespace": "ECS/ContainerInsights",
          "metricName": "CpuReserved",
          "dimensions": { "ClusterName": "obs-cluster", "ServiceName": "payment-service" },
          "statistics": ["Average"],
          "period": "60",
          "label": "CPU Reserved (CPU Units)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 87 },
      "id": 305,
      "title": "💾 Payment Service: Memory Utilization (OOM Predictor)",
      "description": "Leading indicator cho OOM Kill. Alarm fire khi > 85%.",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "AWS/ECS",
          "metricName": "MemoryUtilization",
          "dimensions": { "ClusterName": "obs-cluster", "ServiceName": "payment-service" },
          "statistics": ["Average", "Maximum"],
          "period": "60",
          "legendFormat": "Mem {{stat}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 96 },
      "id": 400,
      "title": "🎯 SLO & Error Budget (Reliability PM View)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "amp-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 97 },
      "id": 401,
      "title": "🔥 Order Service: Fast Burn Rate (5m window)",
      "description": "Tốc độ đốt Error Budget. > 14.4x = SEV-1 (Page SRE). > 3x = SEV-3 (Ticket).",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 14.4 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "((1 - (sum(rate(orders_created_total{status=\"completed\", traffic_source=~\"$traffic_source\"}[5m])) / sum(rate(orders_created_total{traffic_source=~\"$traffic_source\"}[5m])))) / (1 - 0.99)) or vector(0)",
          "legendFormat": "Burn Rate 5m (fast)"
        },
        {
          "expr": "((1 - (sum(rate(orders_created_total{status=\"completed\", traffic_source=~\"$traffic_source\"}[30m])) / sum(rate(orders_created_total{traffic_source=~\"$traffic_source\"}[30m])))) / (1 - 0.99)) or vector(0)",
          "legendFormat": "Burn Rate 30m (slow)"
        },
        { "expr": "14.4", "legendFormat": "🚨 Critical (14.4x)" },
        { "expr": "6", "legendFormat": "⚠️ Slow Burn (6x)" },
        { "expr": "3", "legendFormat": "📋 Ticket (3x)" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 105 },
      "id": 500,
      "title": "💰 FinOps Guardrails (Drill 9 - Cardinality Bomb)",
      "type": "row"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 106 },
      "id": 501,
      "title": "📈 AMP Active Series (Cardinality Bomb Detector)",
      "description": "Số time series đang active trong AMP workspace.\n\n• Baseline (Phase 1.5): ~200-500 series\n• Warning: > 5,000 (có thể Dev gắn UUID labels)\n• Critical: > 10,000 (Cardinality Bomb confirmed — hóa đơn đang nổ!)\n\nXem Drill 9 trong AWS_CHAOS_PLAYBOOK.md để test.",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "orange", "value": 5000 },
              { "color": "red", "value": 10000 }
            ]
          }
        }
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "AWS/Usage",
          "metricName": "ResourceCount",
          "dimensions": {
            "Resource": "${amp_workspace_id}",
            "Type": "ActiveSeries",
            "Class": "None",
            "Service": "Prometheus"
          },
          "statistics": ["Average"],
          "period": "60",
          "label": "Active Time Series",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 106 },
      "id": 502,
      "title": "💸 Estimated Monthly Cost (AMP Ingestion)",
      "description": "Chi phí ước tính mỗi tháng dựa trên Active Series.\n\nCông thức:\n• Samples/hour = ActiveSeries × 360 (mỗi series export mỗi 10s)\n• Monthly samples = Samples/hour × 24 × 30\n• Cost = Monthly samples / 10,000 × $0.03\n\n⚠️ Giá AMP: $0.03 per 10,000 samples ingested",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "AWS/Usage",
          "metricName": "ResourceCount",
          "dimensions": {
            "Resource": "${amp_workspace_id}",
            "Type": "ActiveSeries"
          },
          "statistics": ["Average"],
          "period": "60",
          "label": "Monthly Cost",
          "refId": "A",
          "expression": "SEARCH('{\"Namespace\":\"AWS/Usage\",\"MetricName\":\"ResourceCount\",\"Dimensions\":[{\"Name\":\"Resource\",\"Value\":\"${amp_workspace_id}\"},{\"Name\":\"Type\",\"Value\":\"ActiveSeries\"}]}', 'Average', 60) * 360 * 24 * 30 / 10000 * 0.03"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 115 },
      "id": 600,
      "title": "🪵 Logs & Traces — Deep Dive (Correlation)",
      "type": "row"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch-datasource" },
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 116 },
      "id": 601,
      "title": "📋 Live App Logs (CloudWatch Logs Insights)",
      "description": "Structured JSON logs from Order + Payment services.\n\n• Auto-filter: chỉ hiện ERROR/CRITICAL/Exception\n• Click vào trace_id để jump sang X-Ray trace (cần setup data link)\n• Sort theo timestamp giảm dần (mới nhất ở trên)\n\nDùng để debug khi metrics cho thấy spike error nhưng không biết root cause.",
      "type": "logs",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "trace_id" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "🔍 View Trace in X-Ray",
                    "url": "https://${aws_region}.console.aws.amazon.com/xray/home?region=${aws_region}#/traces/$${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "prettifyJSON": true
      },
      "targets": [
        {
          "queryMode": "Logs",
          "logGroups": [
            "/ecs/obs/order-service",
            "/ecs/obs/payment-service"
          ],
          "query": "fields @timestamp, @message, service_name, level, trace_id\n| filter level like /$${log_level}/\n| sort @timestamp desc\n| limit 50",
          "region": "default",
          "statsGroups": [],
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-x-ray-datasource", "uid": "xray-datasource" },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 116 },
      "id": 602,
      "title": "🔍 Recent Error Traces (X-Ray)",
      "description": "Top 10 traces có lỗi HTTP 5xx trong 1h vừa qua.\n\n• Click vào bất kỳ trace nào để xem full waterfall diagram\n• Filter: chỉ lấy traces từ order-service hoặc payment-service\n• Sort theo latency giảm dần (slowest first)\n\nDùng để debug distributed issues: ví dụ order-service timeout nhưng không biết payment-service hay DB là culprit.",
      "type": "table",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Trace ID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in X-Ray Console",
                    "url": "https://${aws_region}.console.aws.amazon.com/xray/home?region=${aws_region}#/traces/$${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "queryType": "getTraceSummaries",
          "query": "service(id(name: \"order-service\")) OR service(id(name: \"payment-service\")) { http.status_code >= 500 OR rootcause { status_code >= 500 } }",
          "region": "default",
          "size": 10,
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["application", "microservices", "red-method", "aws", "pod-1"],
  "templating": {
    "list": [
      {
        "name": "traffic_source",
        "type": "custom",
        "label": "Traffic Source",
        "current": { "text": "All Traffic", "value": "$__all" },
        "options": [
          { "text": "📊 All Traffic", "value": "$__all", "selected": true },
          { "text": "🌐 Browser (Real Users)", "value": "browser" },
          { "text": "🤖 Synthetic Loadtest", "value": "synthetic_loadtest" },
          { "text": "🩺 Synthetic Probe", "value": "synthetic_probe" }
        ],
        "query": "All Traffic : $__all, 🌐 Browser : browser, 🤖 Synthetic Loadtest : synthetic_loadtest, 🩺 Synthetic Probe : synthetic_probe",
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "log_level",
        "type": "custom",
        "label": "Log Level",
        "current": { "text": "ERROR + CRITICAL", "value": "ERROR|CRITICAL" },
        "options": [
          { "text": "🔴 ERROR + CRITICAL", "value": "ERROR|CRITICAL", "selected": true },
          { "text": "🟡 + WARNING", "value": "ERROR|CRITICAL|WARNING" },
          { "text": "🟢 All (+ INFO)", "value": "ERROR|CRITICAL|WARNING|INFO" }
        ],
        "query": "🔴 ERROR + CRITICAL : ERROR|CRITICAL, 🟡 + WARNING : ERROR|CRITICAL|WARNING, 🟢 All (+ INFO) : ERROR|CRITICAL|WARNING|INFO"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "POD 1 — The Illumination (Order + Payment)",
  "uid": "pod1-illumination",
  "version": 1
}
